---
import { getDb } from "../../db/client";
import { listMedia, getMediaDetail, type MediaStatusFilter } from "../../lib/admin/media";
import { GENERATION_MODES } from "../../lib/doodle-constants";
import MediaGrid from "../components/MediaGrid.astro";
import MediaDrawer from "../components/MediaDrawer.astro";
import MediaLightbox from "../components/MediaLightbox.astro";

const db = getDb(Astro);
const params = Astro.url.searchParams;

const statusValues: MediaStatusFilter[] = ["all", "ok", "failed", "pending"];
const rawStatus = params.get("status");
const status: MediaStatusFilter =
	rawStatus && statusValues.includes(rawStatus as MediaStatusFilter) ? (rawStatus as MediaStatusFilter) : "all";

const rawSkill = params.get("skill");
const skill = rawSkill && (GENERATION_MODES as readonly string[]).includes(rawSkill) ? rawSkill : undefined;

const q = params.get("q")?.trim() || undefined;
const parsedPage = Number.parseInt(params.get("page") ?? "1", 10);
const page = Number.isFinite(parsedPage) && parsedPage > 0 ? parsedPage : 1;
const pageSize = 48;

const result = await listMedia(db, { status, skill, q, limit: pageSize, offset: (page - 1) * pageSize });

const selectedMedia = params.get("media");
const detail = selectedMedia ? await getMediaDetail(db, selectedMedia) : null;

const linkFor = (changes: Record<string, string | null>) => {
	const next = new URLSearchParams(params);
	for (const [key, value] of Object.entries(changes)) {
		if (value === null || value === "") next.delete(key);
		else next.set(key, value);
	}
	return `?${next.toString()}`;
};

/** Open a tile's drawer while preserving the current filters + page. */
const drawerLink = (id: string) => linkFor({ media: id });

const statusChips: { key: MediaStatusFilter; label: string }[] = [
	{ key: "all", label: "All" },
	{ key: "ok", label: "Successful" },
	{ key: "failed", label: "Failed" },
	{ key: "pending", label: "Pending" },
];

// Only offer skill chips for skills that actually have generations under the
// current status/search filter — never the full 24-mode list when most are empty.
const skillChips = GENERATION_MODES.filter((mode) => (result.skillCounts[mode] ?? 0) > 0).map((mode) => ({
	key: mode,
	count: result.skillCounts[mode] ?? 0,
}));

const hasNext = page * pageSize < result.total;
const hasPrev = page > 1;
---

<div class="media-page">
	<div class="toolbar">
		<form class="search-form" method="get">
			<input type="hidden" name="status" value={status} />
			{skill && <input type="hidden" name="skill" value={skill} />}
			<input name="q" value={q ?? ""} placeholder="Search prompt or user email" aria-label="Search generations" />
		</form>

		<div class="filter-row" role="group" aria-label="Filter by outcome">
			{
				statusChips.map((chip) => (
					<a
						class:list={["seg-chip", { active: status === chip.key }]}
						href={linkFor({ status: chip.key, page: "1", media: null })}
					>
						{chip.label}
						<span class="seg-count">{result.statusCounts[chip.key]}</span>
					</a>
				))
			}
		</div>

		{
			skillChips.length > 0 && (
				<div class="filter-row skill-row" role="group" aria-label="Filter by skill">
					<span class="row-label">Skill</span>
					<a class:list={["skill-chip", { active: !skill }]} href={linkFor({ skill: null, page: "1", media: null })}>
						All skills
					</a>
					{skillChips.map((chip) => (
						<a
							class:list={["skill-chip", { active: skill === chip.key }]}
							href={linkFor({ skill: chip.key, page: "1", media: null })}
						>
							{chip.key}
							<span class="seg-count">{chip.count}</span>
						</a>
					))}
				</div>
			)
		}
	</div>

	<MediaGrid rows={result.rows} linkFor={drawerLink} />

	{(hasPrev || hasNext) && (
		<nav class="pagination" aria-label="Media pagination">
			{hasPrev ? <a href={linkFor({ page: String(page - 1), media: null })}>Previous</a> : <span class="disabled">Previous</span>}
			<span>Page {page}</span>
			{hasNext ? <a href={linkFor({ page: String(page + 1), media: null })}>Next</a> : <span class="disabled">Next</span>}
		</nav>
	)}

	{detail && <MediaDrawer detail={detail} />}

	{/* Mounted last so it collects every [data-preview-full] on the page — the
	    grid tiles and, when open, the drawer's hero — in DOM order. */}
	<MediaLightbox />
</div>

<style>
	.media-page {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.toolbar {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.search-form {
		display: flex;
		justify-content: flex-end;
	}
	.search-form input {
		width: min(320px, 100%);
		height: 34px;
		padding: 0 12px;
		border: 1px solid var(--border2);
		border-radius: 9px;
		background: var(--card);
		color: var(--text);
		font: inherit;
		font-size: 12px;
	}
	.search-form input::placeholder {
		color: var(--text-dimmer);
	}
	.filter-row {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.row-label {
		font-size: 12px;
		color: var(--text-dimmer);
	}
	.seg-chip,
	.skill-chip {
		display: flex;
		align-items: center;
		gap: 7px;
		text-decoration: none;
		cursor: pointer;
		border-radius: 999px;
		border: 1px solid var(--border2);
		background: transparent;
		color: var(--text-dim);
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}
	.seg-chip {
		height: 34px;
		padding: 0 13px;
		font-size: 12.5px;
	}
	.skill-chip {
		height: 30px;
		padding: 0 11px;
		font-size: 11.5px;
	}
	.seg-chip:hover,
	.skill-chip:hover {
		color: var(--text);
		border-color: var(--border3);
		background: var(--surface2);
	}
	.seg-chip.active,
	.skill-chip.active {
		background: var(--hover);
		color: var(--text);
		border-color: var(--border3);
	}
	.seg-count {
		font-size: 10.5px;
		padding: 1px 6px;
		border-radius: 999px;
		background: var(--surface2);
		color: var(--text-dimmer);
	}
	.pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		font-size: 12px;
		color: var(--text-dim);
	}
	.pagination a {
		color: var(--text);
		text-decoration: none;
		padding: 8px 14px;
		border-radius: 8px;
		border: 1px solid var(--border2);
	}
	.pagination a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.pagination .disabled {
		color: var(--text-dimmer);
	}
	@media (max-width: 650px) {
		.toolbar {
			gap: 12px;
		}
		.search-form {
			justify-content: stretch;
		}
		.search-form input {
			width: 100%;
			height: 42px;
			font-size: 14px;
			border-radius: 12px;
		}
		.seg-chip {
			height: 38px;
			padding: 0 12px;
			font-size: 12px;
		}
		.skill-chip {
			height: 34px;
			padding: 0 11px;
			font-size: 12px;
		}
		.pagination a {
			padding: 10px 18px;
			min-height: 44px;
			display: flex;
			align-items: center;
		}
	}
</style>
