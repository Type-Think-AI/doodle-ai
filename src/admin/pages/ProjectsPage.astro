---
import { PROJECTS } from '../data/dummy';
import GradientAvatar from '../components/GradientAvatar.astro';

const stats = [
	{ label: 'Total projects', value: '222', foot: '+14 this week' },
	{ label: 'Team workspaces', value: '38', foot: '17% of all projects' },
	{ label: 'Avg. doodles / project', value: '38', foot: 'median 21' },
	{ label: 'Shared externally', value: '64', foot: '29% have a public link' },
];
---

<div class="projects-page">
	<div class="stats-grid">
		{
			stats.map((s) => (
				<div class="panel">
					<span class="stat-label">{s.label}</span>
					<span class="stat-value">{s.value}</span>
					<span class="stat-foot">{s.foot}</span>
				</div>
			))
		}
	</div>

	<div class="table-card">
		<div class="table-head">
			<span>PROJECT</span>
			<span>OWNER</span>
			<span>TYPE</span>
			<span>DOODLES</span>
			<span>CREATED</span>
		</div>
		{
			PROJECTS.map((p) => (
				<div class="table-row">
					<span class="cell-name">{p.name}</span>
					<span class="cell-owner">
						<GradientAvatar seed={p.owner} size={22} />
						{p.owner}
					</span>
					<span class:list={['type-pill', p.type === 'Team' ? 'type-team' : 'type-solo']}>{p.type}</span>
					<span class="cell-doodles">{p.doodles}</span>
					<span class="cell-created">{p.created}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.projects-page {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 14px;
	}
	.panel {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		padding: 18px 20px;
		display: flex;
		flex-direction: column;
	}
	.stat-label {
		font-size: 12px;
		color: var(--text-dimmer);
	}
	.stat-value {
		font-size: 24px;
		font-weight: 700;
		color: var(--text);
		margin-top: 8px;
	}
	.stat-foot {
		font-size: 11px;
		color: var(--text-dimmer);
		margin-top: 2px;
	}

	.table-card {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		overflow: hidden;
	}
	.table-head {
		display: grid;
		grid-template-columns: 1.9fr 1.3fr 0.8fr 0.9fr 1fr;
		padding: 11px 16px;
		border-bottom: 1px solid var(--border);
		font-size: 10.5px;
		letter-spacing: 0.06em;
		color: var(--text-dimmer);
	}
	.table-row {
		display: grid;
		grid-template-columns: 1.9fr 1.3fr 0.8fr 0.9fr 1fr;
		align-items: center;
		padding: 11px 16px;
		border-top: 1px solid var(--border);
	}
	.cell-name {
		font-size: 13px;
		color: var(--text);
	}
	.cell-owner {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12.5px;
		color: var(--text-dim);
	}
	.type-pill {
		font-size: 11px;
		width: fit-content;
		padding: 3px 9px;
		border-radius: 999px;
	}
	.type-team {
		background: var(--blue-faint);
		color: var(--blue);
	}
	.type-solo {
		background: var(--surface2);
		color: var(--text-dimmer);
		border: 1px solid var(--border2);
	}
	.cell-doodles {
		font-size: 13px;
		color: var(--text);
	}
	.cell-created {
		font-size: 12px;
		color: var(--text-dimmer);
	}

	@media (max-width: 860px) {
		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.table-head {
			display: none;
		}
		.table-row {
			grid-template-columns: 1fr;
			grid-auto-flow: row;
			gap: 4px;
			padding: 12px 16px;
		}
	}
</style>
