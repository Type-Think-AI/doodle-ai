---
import { PROJECTS } from '../data/dummy';
import GradientAvatar from '../components/GradientAvatar.astro';

const stats = [
	{ label: 'Total projects', value: '222', foot: '+14 this week' },
	{ label: 'Team workspaces', value: '38', foot: '17% of all projects' },
	{ label: 'Avg. doodles / project', value: '38', foot: 'median 21' },
	{ label: 'Shared externally', value: '64', foot: '29% have a public link' },
];
---

<div class="projects-page">
	<div class="admin-stats-grid">
		{
			stats.map((s) => (
				<div class="admin-stat-card">
					<span>{s.label}</span>
					<strong>{s.value}</strong>
					<small>{s.foot}</small>
				</div>
			))
		}
	</div>

	<div class="admin-table-card">
		<div class="admin-table-wrap">
			<table>
				<thead>
					<tr>
						<th>Project</th>
						<th>Owner</th>
						<th>Type</th>
						<th class="num">Doodles</th>
						<th>Created</th>
					</tr>
				</thead>
				<tbody>
					{
						PROJECTS.map((p) => (
							<tr>
								<td class="cell-name">{p.name}</td>
								<td class="cell-owner">
									<GradientAvatar seed={p.owner} size={22} />
									{p.owner}
								</td>
								<td><span class:list={['admin-pill', p.type === 'Team' ? 'admin-pill-info' : '']}>{p.type}</span></td>
								<td class="num">{p.doodles}</td>
								<td class="cell-created">{p.created}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<style>
	.projects-page {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.cell-name {
		color: var(--text);
		font-size: 13px;
	}
	.cell-owner {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12.5px;
		color: var(--text-dim);
	}
	.cell-created {
		font-size: 12px;
		color: var(--text-dimmer);
	}
</style>
