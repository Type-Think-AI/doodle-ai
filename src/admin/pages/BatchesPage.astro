---
import { getDb } from '../../db/client';
import { listBatches, relativeTime, formatDate, thousands } from '../../lib/admin/queries';
import StatusPill from '../components/StatusPill.astro';

const db = getDb(Astro as any);
const requestedStatus = Astro.url.searchParams.get('status') ?? 'all';
const statuses = ['all', 'queued', 'running', 'done', 'failed', 'canceled'];
const status = statuses.includes(requestedStatus) ? requestedStatus : 'all';
const { rows, counts } = await listBatches(db, { status, limit: 50, offset: 0 });
const filters = [
	{ key: 'all', label: 'All' },
	{ key: 'queued', label: 'Queued' },
	{ key: 'running', label: 'Running' },
	{ key: 'done', label: 'Done' },
	{ key: 'failed', label: 'Failed' },
	{ key: 'canceled', label: 'Canceled' },
];

function statusTone(value: string): 'green' | 'red' | 'blue' | 'neutral' {
	if (value === 'done') return 'green';
	if (value === 'failed') return 'red';
	if (value === 'running') return 'blue';
	return 'neutral';
}

function progress(row: { itemsOk: number; variantCount: number }): number {
	return row.variantCount > 0 ? Math.min(100, Math.round((row.itemsOk / row.variantCount) * 100)) : 0;
}
---

<div class="batches-page">
	<div class="filters" aria-label="Batch job status filters">
		{filters.map((filter) => (
			<a class:list={['filter-chip', status === filter.key && 'active']} href={`/admin/batches?status=${filter.key}`}>
				{filter.label}<span>{counts[filter.key] ?? 0}</span>
			</a>
		))}
	</div>

	{rows.length === 0 ? (
		<div class="admin-empty">
			<strong>No batch jobs with this status.</strong>
			<span>Variant runs will appear here as soon as a team starts one.</span>
		</div>
	) : (
			<div class="admin-table-card">
				<div class="admin-table-wrap">
					<table>
						<thead><tr><th>Job</th><th>Skill</th><th>Team</th><th>By</th><th class="num">Variants</th><th>Progress</th><th class="num">Credits</th><th>Status</th><th>Created</th></tr></thead>
						<tbody>
							{rows.map((row) => {
								const pct = progress(row);
								const stuck = row.status === 'running' && Date.now() - row.createdAt.getTime() > 60 * 60 * 1000;
								return (
									<tr>
										<td class="job-cell" title={row.id}><code>{row.id.length > 16 ? `${row.id.slice(0, 16)}…` : row.id}</code>{stuck && <span class="warning" title="The hourly cron sweep should have finalised this — see src/lib/batch/sweep.ts" aria-label="Stuck job">!</span>}</td>
										<td>{row.skillId}</td>
										<td>{row.orgName}</td>
										<td>{row.createdByName}</td>
										<td class="num">{thousands(row.variantCount)}</td>
										<td class="progress-cell"><div class="progress-track"><span style={`width:${pct}%`}></span></div><small>{row.itemsOk} ok · {row.itemsFailed} failed · {row.itemsPending} pending</small></td>
										<td class="num">{thousands(row.creditsReserved)}</td>
										<td><StatusPill status={row.status} tone={statusTone(row.status)} /></td>
										<td title={formatDate(row.createdAt)}>{relativeTime(row.createdAt)}</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</div>
	)}
</div>

<style>
	.batches-page { display: flex; flex-direction: column; gap: 14px; }
	.filters { display: flex; flex-wrap: wrap; gap: 8px; }
	.filter-chip { display: inline-flex; align-items: center; gap: 7px; padding: 7px 11px; border: 1px solid var(--border2); border-radius: 999px; color: var(--text-dim); text-decoration: none; font-size: 12px; background: var(--surface2); }
	.filter-chip:hover, .filter-chip.active { color: var(--text); border-color: var(--accent); background: var(--hover); }
	.filter-chip span { color: var(--text-dimmer); font-size: 11px; }
	table { min-width: 1060px; }
	.job-cell { color: var(--text); }
	code { color: var(--text); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; }
	.warning { display: inline-flex; align-items: center; justify-content: center; width: 17px; height: 17px; margin-left: 7px; border-radius: 50%; background: var(--red-faint); color: var(--red); font-size: 11px; font-weight: 700; cursor: help; }
	.progress-cell { min-width: 190px; }
	.progress-track { width: 100%; height: 5px; margin-bottom: 5px; border-radius: 999px; background: var(--surface2); overflow: hidden; }
	.progress-track span { display: block; height: 100%; border-radius: inherit; background: var(--blue); }
	small { color: var(--text-dimmer); font-size: 10px; }
	@media (max-width: 640px) {
		.filters { gap: 6px; }
		.filter-chip { padding: 9px 12px; font-size: 13px; min-height: 38px; }
		.batches-page :global(.admin-empty) { padding: 36px 16px; border-radius: 10px; }
		.batches-page :global(.admin-empty) strong { font-size: 13px; }
		.batches-page :global(.admin-empty) span { font-size: 12px; }
	}
</style>
