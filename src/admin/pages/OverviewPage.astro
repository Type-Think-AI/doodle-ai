---
import { getDb } from '../../db/client';
import {
	compact,
	getActivationFunnel,
	getCreditsByWeek,
	getGenerationsByDay,
	getNeedsAttention,
	getOverviewTotals,
	getRecentActivity,
	getSkillMix,
	polylinePoints,
} from '../../lib/admin/queries';
import { GENERATION_MODES } from '../../lib/doodle-constants';
import KpiCard from '../components/KpiCard.astro';
import SampleBadge from '../components/SampleBadge.astro';
import SampleNote from '../components/SampleNote.astro';
import GenerationsChart from '../components/GenerationsChart.astro';
import ActivationFunnel from '../components/ActivationFunnel.astro';
import ActivityFeed from '../components/ActivityFeed.astro';

const db = getDb(Astro as any);
const requestedDays = Number(Astro.url.searchParams.get('days') ?? 14);
const chartDays = [7, 14, 30].includes(requestedDays) ? requestedDays : 14;
const [totals, byDay, byWeek, funnel, mix, activity, attention] = await Promise.all([
	getOverviewTotals(db),
	getGenerationsByDay(db, chartDays),
	getCreditsByWeek(db),
	getActivationFunnel(db),
	getSkillMix(db),
	getRecentActivity(db),
	getNeedsAttention(db),
]);

const ICONS = {
	person: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.7"/><path d="M5 20c1-4.2 3.6-6.2 7-6.2s6 2 7 6.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
	check: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	coin: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="2.6" fill="currentColor"/></svg>',
	bolt: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M13 3 5 14h5l-1 7 8-11h-5l1-7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
};

const sparkSize = { w: 200, h: 34, pad: 4 };
const generationValues = byDay.map((point) => point.value);
const issuedValues = byWeek.length > 0 ? byWeek.map((point) => point.issued) : [totals.creditsIssued];
const usedValues = byWeek.length > 0 ? byWeek.map((point) => point.used) : [totals.creditsUsed];
const generationSpark = polylinePoints(generationValues.length > 0 ? generationValues : [0], sparkSize.w, sparkSize.h, sparkSize.pad);
const issuedSpark = polylinePoints(issuedValues, sparkSize.w, sparkSize.h, sparkSize.pad);
const usedSpark = polylinePoints(usedValues, sparkSize.w, sparkSize.h, sparkSize.pad);
const creditUtilPct = totals.creditsIssued === 0 ? 0 : Math.round((totals.creditsUsed / totals.creditsIssued) * 100);

const kpis = [
	{ label: 'Signups', value: compact(totals.users), trend: '—', footnote: `${totals.usersThisWeek} this week`, tone: 'blue' as const, icon: ICONS.person, spark: generationSpark },
	{ label: 'Doodles made', value: compact(totals.generations), trend: '—', footnote: `${totals.generationsThisWeek} this week`, tone: 'accent' as const, icon: ICONS.check, spark: generationSpark },
	{ label: 'Credits used', value: compact(totals.creditsUsed), trend: '—', footnote: `${creditUtilPct}% of issued`, tone: 'green' as const, icon: ICONS.coin, spark: usedSpark },
	{ label: 'Paying seats', value: compact(totals.payingSeats), trend: '—', footnote: 'active subscriptions', tone: 'red' as const, icon: ICONS.bolt, spark: issuedSpark },
];

/* ---- Skill mix donut ---- */
function friendlySkillName(skillId: string) {
	if (skillId === '__other') return 'Everything else';
	if (GENERATION_MODES.includes(skillId as (typeof GENERATION_MODES)[number])) {
		return skillId.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
	}
	return skillId;
}

const mixTotal = mix.reduce((sum, slice) => sum + slice.runs, 0);
let mixOffset = 0;
const mixColors = ['var(--accent)', 'var(--blue)', 'var(--green)', 'var(--red)'];
const mixSlices = mix.map((slice, index) => {
	const geometryPct = mixTotal === 0 ? 0 : (slice.runs / mixTotal) * 100;
	const result = { ...slice, label: friendlySkillName(slice.skillId), geometryPct, offset: mixOffset, color: mixColors[index % mixColors.length] };
	mixOffset += geometryPct;
	return result;
});

/* ---- Credits bar chart ---- */
const creditMax = byWeek.length > 0 ? Math.max(0, ...byWeek.flatMap((p) => [p.issued, p.used])) : 0;
const creditChartHeight = 120;
const creditChartBottom = 135;
const creditSlot = byWeek.length > 0 ? 250 / byWeek.length : 0;
const creditBarWidth = byWeek.length > 0 ? Math.max(4, Math.min(18, creditSlot * 0.32)) : 0;
const creditBars = byWeek.map((point, index) => {
	const issuedHeight = creditMax === 0 ? 0 : (point.issued / creditMax) * creditChartHeight;
	const usedHeight = creditMax === 0 ? 0 : (point.used / creditMax) * creditChartHeight;
	const x = 15 + index * creditSlot;
	return { x, issuedX: x, usedX: x + creditBarWidth + 2, issuedY: creditChartBottom - issuedHeight, usedY: creditChartBottom - usedHeight, issuedHeight, usedHeight };
});

/* ---- Retention cohort (sample data) ---- */
const cohortHeads = ['W0', 'W1', 'W2', 'W3', 'W4'];
const cohortRows = [
	{ label: 'Wk 30', vals: [100, 68, 54, 44, 38] },
	{ label: 'Wk 31', vals: [100, 72, 58, 49, 41] },
	{ label: 'Wk 32', vals: [100, 66, 51, 42, 36] },
	{ label: 'Wk 33', vals: [100, 78, 63, 55, 47] },
	{ label: 'Wk 34', vals: [100, 74, 61, 52, 0] },
];
function heat(v: number) {
	if (!v) return 'background:var(--surface2); color:var(--text-dimmer);';
	const a = ((v / 100) * 0.85 + 0.08).toFixed(2);
	const fg = v > 60 ? '#1a1a1a' : 'var(--text)';
	return `background:rgba(250,183,0,${a}); color:${fg};`;
}
const cohorts = cohortRows.map((row) => ({
	label: row.label,
	cells: row.vals.map((value) => ({ value: value ? `${value}%` : '—', style: heat(value) })),
}));
---

<SampleNote items={[{ block: 'Retention by signup week', needs: 'needs a per-cohort retention query; not implemented yet' }]} />

<div class="overview">
	<div class="kpi-grid">
		{kpis.map((k) => <KpiCard label={k.label} value={k.value} trend={k.trend} footnote={k.footnote} tone={k.tone} spark={k.spark} icon={k.icon} />)}
	</div>

	<div class="grid-2">
		<GenerationsChart byDay={byDay} totalGenerations={totals.generations} chartDays={chartDays} />
		<ActivationFunnel funnel={funnel} />
	</div>

	<div class="grid-3">
		<!-- Skill mix donut -->
		<div class="panel">
			<span class="panel-title">Skill mix</span>
			<p class="panel-sub">Share of successful generations</p>
			<div class="donut-wrap">
				<svg viewBox="0 0 100 100" class="donut-svg" role="img" aria-label="Skill mix of successful generations">
					{mixSlices.length > 0 ? (
						mixSlices.map((slice) => (
							<circle cx="50" cy="50" r="37" pathLength="100" fill="none" stroke={slice.color} stroke-width="16"
								stroke-dasharray={`${slice.geometryPct} ${100 - slice.geometryPct}`} stroke-dashoffset={-slice.offset} transform="rotate(-90 50 50)" />
						))
					) : (
						<circle cx="50" cy="50" r="37" fill="none" stroke="var(--surface2)" stroke-width="16" />
					)}
				</svg>
				<div class="donut-center">
					<strong>{compact(totals.generations)}</strong>
					<span>doodles</span>
				</div>
			</div>
			{mixSlices.length > 0 ? (
				<div class="skill-legend">
					{mixSlices.map((slice) => (
						<div class="skill-legend-row">
							<span class="legend-item"><span class="legend-swatch" style={`background:${slice.color};`} />{slice.label}</span>
							<span class="skill-legend-pct">{slice.pct}%</span>
						</div>
					))}
				</div>
			) : (
				<p class="empty-state">No successful generations yet.</p>
			)}
		</div>

		<!-- Credits issued vs used -->
		<div class="panel">
			<span class="panel-title">Credits issued vs used</span>
			<p class="panel-sub">Weekly</p>
			<svg viewBox="0 0 280 150" class="credit-svg" role="img" aria-label="Credits issued and used by week">
				{creditBars.length > 0 ? (
					creditBars.map((bar) => (
						<>
							<rect x={bar.issuedX} y={bar.issuedY} width={creditBarWidth} height={bar.issuedHeight} rx="2" fill="var(--blue)" opacity="0.85" />
							<rect x={bar.usedX} y={bar.usedY} width={creditBarWidth} height={bar.usedHeight} rx="2" fill="var(--accent)" />
						</>
					))
				) : (
					<text x="140" y="78" text-anchor="middle" fill="var(--text-dimmer)" font-size="11">No credit ledger data yet</text>
				)}
			</svg>
			<div class="credit-legend">
				<span class="legend-item"><span class="legend-swatch" style="background:var(--blue);" />Issued</span>
				<span class="legend-item"><span class="legend-swatch" style="background:var(--accent);" />Used</span>
				<span class="legend-util">{creditUtilPct}% utilised</span>
			</div>
		</div>

		<!-- Retention cohort -->
		<div class="panel">
			<div class="panel-heading-inline">
				<span class="panel-title">Retention by signup week</span>
				<SampleBadge reason="needs a per-cohort retention query; not implemented yet" />
			</div>
			<p class="panel-sub">% still generating</p>
			<div class="cohort-table">
				<div class="cohort-row cohort-head">
					<span></span>
					{cohortHeads.map((head) => <span class="cohort-head-cell">{head}</span>)}
				</div>
				{cohorts.map((cohort) => (
					<div class="cohort-row">
						<span class="cohort-label">{cohort.label}</span>
						{cohort.cells.map((cell) => <span class="cohort-cell" style={cell.style}>{cell.value}</span>)}
					</div>
				))}
			</div>
		</div>
	</div>

	<ActivityFeed activity={activity} attention={attention} />
</div>

<style>
	.overview { display: flex; flex-direction: column; gap: 16px; }
	.kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
	.grid-2 { display: grid; grid-template-columns: 1.55fr 1fr; gap: 14px; }
	.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
	.panel {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		padding: 18px 20px;
	}
	.panel-title { font-size: 13.5px; font-weight: 600; color: var(--text); }
	.panel-sub { font-size: 11.5px; color: var(--text-dimmer); margin: 5px 0 16px; }
	.panel-heading-inline { display: flex; align-items: center; gap: 8px; }

	/* Skill mix donut */
	.donut-wrap { position: relative; width: 166px; height: 166px; margin: 3px auto 12px; }
	.donut-svg { display: block; width: 100%; height: 100%; }
	.donut-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; }
	.donut-center strong { font-size: 23px; line-height: 1.1; color: var(--text); }
	.donut-center span { font-size: 10.5px; color: var(--text-dimmer); margin-top: 3px; }
	.skill-legend { display: flex; flex-direction: column; gap: 7px; }
	.skill-legend-row { display: flex; align-items: center; justify-content: space-between; font-size: 11.5px; color: var(--text-dim); }
	.skill-legend-pct { color: var(--text-dimmer); font-variant-numeric: tabular-nums; }

	/* Credits bar chart */
	.credit-svg { width: 100%; height: 150px; }
	.credit-legend { display: flex; gap: 14px; margin-top: 12px; }
	.legend-item { display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--text-dim); }
	.legend-swatch { width: 8px; height: 8px; border-radius: 2px; flex: 0 0 8px; }
	.legend-util { margin-left: auto; font-size: 11.5px; color: var(--text-dimmer); }

	/* Cohort heatmap */
	.cohort-table { display: flex; flex-direction: column; gap: 5px; }
	.cohort-row { display: grid; grid-template-columns: 44px repeat(5, 1fr); gap: 5px; align-items: center; }
	.cohort-head-cell { font-size: 9.5px; color: var(--text-dimmer); text-align: center; }
	.cohort-label { font-size: 10px; color: var(--text-dimmer); }
	.cohort-cell { font-size: 9.5px; text-align: center; padding: 6px 0; border-radius: 5px; }

	.empty-state { font-size: 12px; color: var(--text-dimmer); padding: 16px 0 4px; text-align: center; }

	@media (max-width: 1200px) {
		.kpi-grid { grid-template-columns: repeat(2, 1fr); }
		.grid-2, .grid-3 { grid-template-columns: 1fr; }
	}
</style>
