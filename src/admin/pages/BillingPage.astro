---
import { INVOICES, polyline } from '../data/dummy';
import StatusPill from '../components/StatusPill.astro';

const mrrSpark = polyline([18, 20, 19, 24, 23, 28, 27, 32, 31, 36, 35, 41, 44, 48], 300, 54, 5);

function toneFor(status: string): 'green' | 'red' | 'neutral' {
	if (status === 'Paid') return 'green';
	if (status === 'Failed') return 'red';
	return 'neutral';
}
---

<div class="billing-stats">
	<div class="panel mrr-panel">
		<div class="mrr-top">
			<span class="stat-label">Monthly recurring revenue</span>
			<span class="growth-tag">Growth</span>
		</div>
		<span class="mrr-value">$4,920</span>
		<svg viewBox="0 0 300 54" preserveAspectRatio="none" class="mrr-spark" id="mrr-spark-svg">
			<defs>
				<linearGradient id="spark-fill-grad" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="var(--green)" stop-opacity="0.25" />
					<stop offset="100%" stop-color="var(--green)" stop-opacity="0" />
				</linearGradient>
			</defs>
			<polygon points={`0,54 ${mrrSpark} 300,54`} fill="url(#spark-fill-grad)" class="mrr-area" />
			<polyline points={mrrSpark} fill="none" stroke="var(--green)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="mrr-line"></polyline>
			<circle cx="0" cy="0" r="4" class="mrr-dot" id="mrr-dot" />
		</svg>
		<div class="mrr-tooltip" id="mrr-tooltip"></div>
	</div>

	<div class="panel">
		<span class="stat-label">Paying seats</span>
		<span class="stat-value">312</span>
		<span class="stat-delta pos">+18 this month</span>
		<div class="divider"></div>
		<span class="stat-label">Free → Pro conversion</span>
		<span class="stat-value-sm">6.5%</span>
	</div>

	<div class="panel">
		<span class="stat-label">Churn, 30 days</span>
		<span class="stat-value">2.1%</span>
		<span class="stat-delta neg">+0.3 vs last month</span>
		<div class="divider"></div>
		<span class="stat-label">Avg. revenue / user</span>
		<span class="stat-value-sm">$15.77</span>
	</div>
</div>

<div class="table-panel">
	<div class="table-head">
		<span>INVOICE</span><span>CUSTOMER</span><span>DATE</span><span>AMOUNT</span><span>STATUS</span>
	</div>
	{INVOICES.map((i) => (
		<div class="table-row">
			<span class="cell-id">{i.id}</span>
			<span class="cell-customer">{i.customer}</span>
			<span class="cell-date">{i.date}</span>
			<span class="cell-amount">{i.amount}</span>
			<StatusPill status={i.status} tone={toneFor(i.status)} />
		</div>
	))}
</div>

<style>
	.billing-stats {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 14px;
		margin-bottom: 14px;
	}
	.panel {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		padding: 18px 20px;
	}
	.mrr-top {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.stat-label {
		font-size: 12px;
		color: var(--text-dim);
	}
	.growth-tag {
		font-size: 10.5px;
		padding: 3px 8px;
		border-radius: 999px;
		background: var(--accent-softer);
		color: var(--accent);
	}
	.mrr-value {
		font-size: 32px;
		font-weight: 700;
		color: var(--text);
		letter-spacing: -0.02em;
		margin-top: 10px;
		display: block;
	}
	.mrr-spark {
		width: 100%;
		height: 48px;
		margin-top: 10px;
		overflow: visible;
		cursor: crosshair;
		filter: drop-shadow(0 0 4px rgba(var(--green-rgb, 34, 197, 94), 0.35));
	}
	.mrr-line {
		stroke-dasharray: 500;
		stroke-dashoffset: 500;
		animation: draw-line 1.5s ease-out forwards;
	}
	.mrr-area {
		opacity: 0;
		animation: fade-area 0.8s ease-out 1s forwards;
	}
	@keyframes draw-line {
		to { stroke-dashoffset: 0; }
	}
	@keyframes fade-area {
		to { opacity: 1; }
	}
	.mrr-dot {
		fill: var(--green);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}
	.mrr-dot.visible {
		opacity: 1;
		animation: sparkle-pulse 1s ease-in-out infinite;
	}
	.mrr-dot.pinned {
		opacity: 1;
		animation: sparkle-pulse 0.8s ease-in-out infinite;
	}
	@keyframes sparkle-pulse {
		0%, 100% { r: 4; opacity: 1; }
		50% { r: 6; opacity: 0.7; }
	}
	.mrr-tooltip {
		position: absolute;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 3px 8px;
		font-size: 11px;
		font-weight: 600;
		color: var(--green);
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease, transform 0.15s ease;
		transform: translateY(2px);
		white-space: nowrap;
	}
	.mrr-tooltip.visible {
		opacity: 1;
		transform: translateY(0);
	}
	.mrr-panel {
		position: relative;
	}
	.stat-value {
		font-size: 26px;
		font-weight: 700;
		color: var(--text);
		margin-top: 8px;
		display: block;
	}
	.stat-value-sm {
		font-size: 18px;
		font-weight: 700;
		color: var(--text);
		margin-top: 6px;
		display: block;
	}
	.stat-delta {
		font-size: 11.5px;
	}
	.stat-delta.pos {
		color: var(--green);
	}
	.stat-delta.neg {
		color: var(--red);
	}
	.divider {
		height: 1px;
		background: var(--border);
		margin: 14px 0;
	}
	.table-panel {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		overflow: hidden;
	}
	.table-head {
		display: grid;
		grid-template-columns: 1.2fr 1.4fr 1fr 0.9fr 0.9fr;
		padding: 11px 16px;
		border-bottom: 1px solid var(--border);
		font-size: 10.5px;
		letter-spacing: 0.06em;
		color: var(--text-dimmer);
	}
	.table-row {
		display: grid;
		grid-template-columns: 1.2fr 1.4fr 1fr 0.9fr 0.9fr;
		align-items: center;
		padding: 11px 16px;
		border-top: 1px solid var(--border);
	}
	.cell-id {
		font-size: 13px;
		color: var(--text);
	}
	.cell-customer {
		font-size: 12.5px;
		color: var(--text-dim);
	}
	.cell-date {
		font-size: 12px;
		color: var(--text-dim);
	}
	.cell-amount {
		font-size: 13px;
		color: var(--text);
	}
	@media (max-width: 860px) {
		.billing-stats {
			grid-template-columns: 1fr;
		}
		.table-head,
		.table-row {
			grid-template-columns: 1fr 1fr 1fr;
		}
		.cell-date {
			display: none;
		}
	}
</style>

<script>
(() => {
	const data = [18, 20, 19, 24, 23, 28, 27, 32, 31, 36, 35, 41, 44, 48];
	const values = data.map(d => d * 100); // $1800 .. $4800
	const svg = document.getElementById('mrr-spark-svg');
	const dot = document.getElementById('mrr-dot');
	const tooltip = document.getElementById('mrr-tooltip');
	if (!svg || !dot || !tooltip) return;

	const w = 300, h = 54, pad = 5;
	const n = data.length;
	const min = Math.min(...data);
	const max = Math.max(...data);

	function getPoint(i: number): [number, number] {
		const x = (i / (n - 1)) * w;
		const y = pad + ((max - data[i]) / (max - min)) * (h - 2 * pad);
		return [x, y];
	}

	let pinned = false;

	svg.addEventListener('mousemove', (e: MouseEvent) => {
		if (pinned) return;
		const rect = svg.getBoundingClientRect();
		const relX = (e.clientX - rect.left) / rect.width;
		const idx = Math.round(relX * (n - 1));
		const clamped = Math.max(0, Math.min(n - 1, idx));
		showPoint(clamped, e.clientX, rect);
	});

	svg.addEventListener('mouseleave', () => {
		if (pinned) return;
		hidePoint();
	});

	svg.addEventListener('click', (e: MouseEvent) => {
		e.stopPropagation();
		const rect = svg.getBoundingClientRect();
		const relX = (e.clientX - rect.left) / rect.width;
		const idx = Math.round(relX * (n - 1));
		const clamped = Math.max(0, Math.min(n - 1, idx));
		pinned = true;
		dot.classList.add('pinned');
		showPoint(clamped, e.clientX, rect);
	});

	document.addEventListener('click', (e: MouseEvent) => {
		if (!pinned) return;
		if (svg.contains(e.target as Node)) return;
		pinned = false;
		dot.classList.remove('pinned');
		hidePoint();
	});

	function showPoint(idx: number, clientX: number, rect: DOMRect) {
		const [px, py] = getPoint(idx);
		dot.setAttribute('cx', String(px));
		dot.setAttribute('cy', String(py));
		dot.classList.add('visible');

		const dollar = '$' + values[idx].toLocaleString();
		tooltip.textContent = dollar;
		tooltip.classList.add('visible');

		// Position tooltip above the svg relative to the panel
		const panel = svg.closest('.mrr-panel') as HTMLElement;
		if (!panel) return;
		const panelRect = panel.getBoundingClientRect();
		const svgTop = rect.top - panelRect.top;
		const dotScreenX = rect.left + (px / w) * rect.width;
		const tooltipLeft = dotScreenX - panelRect.left;
		const tooltipTop = svgTop + (py / h) * rect.height - 24;

		tooltip.style.left = tooltipLeft + 'px';
		tooltip.style.top = tooltipTop + 'px';
		tooltip.style.transform = 'translate(-50%, 0)';
	}

	function hidePoint() {
		dot.classList.remove('visible');
		tooltip.classList.remove('visible');
	}
})();
</script>
