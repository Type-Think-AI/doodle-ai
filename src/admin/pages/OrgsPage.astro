---
import { getDb } from '../../db/client';
import { listOrgs, thousands, formatDate } from '../../lib/admin/queries';

const db = getDb(Astro as any);
const rows = await listOrgs(db, 50, 0);
const personal = rows.filter((row) => row.isPersonal).length;
const shared = rows.length - personal;
const credits = rows.reduce((sum, row) => sum + row.balance, 0);
---

<div class="orgs-page">
	<div class="admin-stats-grid">
		<div class="admin-stat-card"><span>All organizations</span><strong>{thousands(rows.length)}</strong><small>Every organization in D1</small></div>
		<div class="admin-stat-card"><span>Personal</span><strong>{thousands(personal)}</strong><small>User-owned workspaces</small></div>
		<div class="admin-stat-card"><span>Shared teams</span><strong>{thousands(shared)}</strong><small>Collaborative workspaces</small></div>
		<div class="admin-stat-card"><span>Credits outstanding</span><strong>{thousands(credits)}</strong><small>Across returned balances</small></div>
	</div>

	{rows.length === 0 ? (
		<div class="admin-empty">
			<strong>No organizations yet.</strong>
			<span>Organizations will appear here when users create or join a team.</span>
		</div>
	) : (
		<div class="admin-table-card">
			<div class="admin-table-wrap">
				<table>
					<thead><tr><th>Team</th><th>Type</th><th class="num">Members</th><th class="num">Projects</th><th class="num">Doodles</th><th class="num">Credits</th><th class="num">Monthly cap</th><th>Created</th></tr></thead>
					<tbody>
						{rows.map((row) => (
							<tr>
								<td><strong class="team-name">{row.name}</strong><code>{row.slug}</code></td>
								<td><span class:list={['type-pill', row.isPersonal ? 'personal' : 'team']}>{row.isPersonal ? 'Personal' : 'Team'}</span></td>
								<td class="num">{thousands(row.members)}</td>
								<td class="num">{thousands(row.projects)}</td>
								<td class="num">{thousands(row.generations)}</td>
								<td class="num">{thousands(row.balance)}</td>
								<td class="num">{row.monthlyCreditCap === null ? 'No cap' : thousands(row.monthlyCreditCap)}</td>
								<td>{formatDate(row.createdAt)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	)}
</div>

<style>
	.orgs-page { display: flex; flex-direction: column; gap: 14px; }
	table { min-width: 930px; }
	.team-name, td:first-child code { display: block; }
	.team-name { color: var(--text); font-size: 13px; }
	td:first-child code { margin-top: 3px; color: var(--text-dimmer); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; max-width: 180px; overflow: hidden; text-overflow: ellipsis; }
	.type-pill { display: inline-block; padding: 3px 9px; border-radius: 999px; font-size: 11px; }
	.type-pill.personal { border: 1px solid var(--border2); background: var(--surface2); color: var(--text-dimmer); }
	.type-pill.team { background: var(--blue-faint); color: var(--blue); }
</style>
