---
/**
 * Sparkline area chart showing doodle generation counts by day, with range
 * selector (7d / 14d / 30d). Extracted from OverviewPage to keep that page
 * focused on layout and data orchestration.
 */
import { polylinePoints, thousands } from '../../lib/admin/queries';

interface Props {
	byDay: { day: string; value: number }[];
	totalGenerations: number;
	chartDays: number;
}
const { byDay, totalGenerations, chartDays } = Astro.props;

const W = 620;
const H = 190;
const pad = 12;
const chartValues = byDay.length > 0 ? byDay.map((p) => p.value) : [0];
const chartPoints = polylinePoints(chartValues, W, H, pad);
const chartDots = chartPoints.split(' ').map((point) => {
	const [x, y] = point.split(',');
	return { x, y };
});
const chartFillPoints = `${chartPoints} ${W - pad},${H} ${pad},${H}`;
const gridLines = [32, 78, 124, 170];

function chartDayLabel(day: string | undefined) {
	if (!day) return '—';
	const date = new Date(`${day}T00:00:00`);
	return Number.isNaN(date.getTime()) ? '—' : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

const labelIndexes = [0, 0.25, 0.5, 0.75, 1].map((fraction) =>
	byDay.length > 0 ? Math.floor((byDay.length - 1) * fraction) : -1,
);
const chartLabels = labelIndexes.map((index) => chartDayLabel(index >= 0 ? byDay[index]?.day : undefined));
const rangeOpts = [7, 14, 30];
---

<div class="panel">
	<div class="chart-head">
		<span class="panel-title">Doodles generated</span>
		<div class="range-group">
			{rangeOpts.map((range) => (
				<a href={`?days=${range}`} class:list={['chip', 'chart-range-link', { active: range === chartDays }]}>{range}d</a>
			))}
		</div>
	</div>
	<div class="chart-headline">
		<span class="headline-value">{thousands(totalGenerations)}</span>
		<span class="headline-note">last {chartDays} days</span>
	</div>
	<svg viewBox="0 0 620 190" class="growth-svg" aria-label="Successful doodles generated by day" role="img">
		{gridLines.map((y) => <line x1="0" x2="620" y1={y} y2={y} stroke="var(--border)" stroke-width="1" />)}
		<polygon points={chartFillPoints} fill="rgba(250,183,0,.10)"></polygon>
		<polyline points={chartPoints} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
		{chartDots.map((dot) => <circle cx={dot.x} cy={dot.y} r="3" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />)}
	</svg>
	<div class="chart-labels">
		{chartLabels.map((label) => <span>{label}</span>)}
	</div>
</div>

<style>
	.panel {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		padding: 18px 20px;
	}
	.panel-title { font-size: 13.5px; font-weight: 600; color: var(--text); }
	.chart-head { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
	.range-group { margin-left: auto; display: flex; gap: 3px; }
	.chip {
		padding: 5px 11px;
		border-radius: 999px;
		border: 0;
		font-size: 11.5px;
		background: transparent;
		color: var(--text-dim);
	}
	.chart-range-link { cursor: pointer; text-decoration: none; }
	.chip.active { background: var(--hover); color: var(--text); }
	.chart-headline { display: flex; align-items: baseline; gap: 10px; margin-bottom: 10px; }
	.headline-value { font-size: 28px; font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
	.headline-note { font-size: 12px; color: var(--text-dimmer); }
	.growth-svg { width: 100%; height: 190px; overflow: visible; }
	.chart-labels { display: flex; justify-content: space-between; margin-top: 8px; }
	.chart-labels span { font-size: 10.5px; color: var(--text-dimmer); }
</style>
