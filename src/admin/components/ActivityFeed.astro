---
/**
 * Live-activity timeline + "Needs your attention" card. Extracted from
 * OverviewPage to isolate activity-feed presentation from the dashboard
 * data orchestration.
 */
import { relativeTime } from '../../lib/admin/queries';

interface ActivityEvent {
	kind: 'signup' | 'generation' | 'credit' | 'feedback';
	text: string;
	at: string;
}
interface AttentionItem {
	title: string;
	detail: string;
	tone: string;
	href: string;
}

interface Props {
	activity: ActivityEvent[];
	attention: AttentionItem[];
}
const { activity, attention } = Astro.props;

const ICONS: Record<ActivityEvent['kind'], string> = {
	signup: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.7"/><path d="M5 20c1-4.2 3.6-6.2 7-6.2s6 2 7 6.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
	generation: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	credit: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="2.6" fill="currentColor"/></svg>',
	feedback: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 3v18M6 4h12l-3 4 3 4H6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
};

const TONES: Record<ActivityEvent['kind'], string> = {
	signup: 'blue',
	generation: 'accent',
	credit: 'green',
	feedback: 'red',
};
---

<div class="grid-activity">
	<div class="activity-panel">
		<div class="activity-head">
			<span class="panel-title">Live activity</span>
			<a href="/admin/users" class="activity-link">All users</a>
		</div>
		{activity.length > 0 ? (
			activity.map((event) => {
				const tone = TONES[event.kind];
				return (
					<div class="activity-row">
						<span class="activity-icon" style={`background:var(--${tone}-faint); color:var(--${tone});`} set:html={ICONS[event.kind]} />
						<span class="activity-text">{event.text}</span>
						<span class="activity-time">{relativeTime(event.at)}</span>
					</div>
				);
			})
		) : (
			<div class="empty-state activity-empty">No activity yet.</div>
		)}
	</div>

	<div class="panel">
		<span class="panel-title">Needs your attention</span>
		<p class="panel-sub">Auto-surfaced from current data</p>
		{attention.length > 0 ? (
			<div class="attention-list">
				{attention.map((item) => (
					<div class="attention-row">
						<span class="attention-pip" style={`background:var(--${item.tone});`} />
						<span class="attention-text">
							<span class="attention-title">{item.title}</span>
							<span class="attention-detail">{item.detail}</span>
						</span>
						<a class="attention-cta" href={item.href}>Review</a>
					</div>
				))}
			</div>
		) : (
			<div class="empty-state">Nothing needs attention right now.</div>
		)}
	</div>
</div>

<style>
	.grid-activity { display: grid; grid-template-columns: 1.3fr 1fr; gap: 14px; }
	.panel {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		padding: 18px 20px;
	}
	.panel-title { font-size: 13.5px; font-weight: 600; color: var(--text); }
	.panel-sub { font-size: 11.5px; color: var(--text-dimmer); margin: 5px 0 16px; }
	.activity-panel {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		padding: 6px;
	}
	.activity-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 14px 10px; }
	.activity-link { border: 0; background: transparent; color: var(--blue); font-size: 12px; cursor: pointer; text-decoration: none; }
	.activity-row { display: flex; align-items: center; gap: 11px; padding: 10px 14px; border-top: 1px solid var(--border); }
	.activity-icon { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex: 0 0 28px; }
	.activity-text { font-size: 12.5px; color: var(--text); flex: 1; min-width: 0; }
	.activity-time { font-size: 11px; color: var(--text-dimmer); }
	.attention-list { display: flex; flex-direction: column; gap: 9px; }
	.attention-row { display: flex; align-items: center; gap: 11px; padding: 11px 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface2); }
	.attention-pip { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 8px; }
	.attention-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
	.attention-title { font-size: 12.5px; color: var(--text); }
	.attention-detail { font-size: 11px; color: var(--text-dimmer); }
	.attention-cta { height: 26px; padding: 5px 10px; border-radius: 7px; border: 1px solid var(--border2); background: transparent; color: var(--text-dim); font-size: 11px; cursor: pointer; flex: 0 0 auto; text-decoration: none; }
	.attention-cta:hover { color: var(--text); border-color: var(--border3); }
	.empty-state { font-size: 12px; color: var(--text-dimmer); padding: 16px 0 4px; text-align: center; }
	.activity-empty { border-top: 1px solid var(--border); padding: 24px 14px; }
	@media (max-width: 1200px) { .grid-activity { grid-template-columns: 1fr; } }
</style>
