---
import type { AdminChatDetail } from '../../lib/admin/chats';
import { formatDate, relativeTime, thousands } from '../../lib/admin/queries';
import { resizedCdnImage } from '../../lib/cdn-image';
import GradientAvatar from './GradientAvatar.astro';

interface Props {
	detail: AdminChatDetail;
}

const { detail } = Astro.props;

// Close = drop the ?thread param, keep filter/search/page so the list state survives.
const closeUrl = new URL(Astro.url);
closeUrl.searchParams.delete('thread');

const ownerLabel = detail.userName || detail.userEmail || detail.userId;
// The status chips summarise the thread's generations at a glance.
const statusOrder = ['ok', 'pending', 'failed', 'refunded'];
const orderedStats = [...detail.generationStats].sort(
	(a, b) => statusOrder.indexOf(a.status) - statusOrder.indexOf(b.status),
);
---

<aside class="drawer" aria-label={`Transcript for ${detail.title}`}>
	<div class="drawer-header">
		<div class="identity">
			<GradientAvatar seed={detail.userEmail || detail.userId} size={42} />
			<div>
				<h2>{detail.title}</h2>
				<p>{ownerLabel}</p>
				{detail.userEmail && detail.userName && <span>{detail.userEmail}</span>}
			</div>
		</div>
		<a class="close" href={closeUrl.pathname + closeUrl.search} aria-label="Close transcript">×</a>
	</div>

	<div class="stats" aria-label="Chat summary">
		<div><strong>{thousands(detail.messageCount)}</strong><span>Messages</span></div>
		<div><strong>{thousands(detail.generationCount)}</strong><span>Generations</span></div>
		<div><strong>{detail.skillId || '—'}</strong><span>Skill</span></div>
		<div><strong>{relativeTime(detail.updatedAt)}</strong><span>Last active</span></div>
	</div>

	<div class="meta-row">
		<span>Created {formatDate(detail.createdAt)}</span>
		{orderedStats.length > 0 && (
			<span class="gen-statuses">
				{orderedStats.map((s) => (
					<span class:list={['gen-chip', `gen-${s.status}`]}>{s.count} {s.status}</span>
				))}
			</span>
		)}
	</div>

	<section class="transcript" aria-label="Conversation">
		{detail.messages.length === 0 ? (
			<div class="empty-state">
				<strong>No messages</strong>
				<span>This chat has no messages — the user opened it but never sent anything.</span>
			</div>
		) : (
			detail.messages.map((m) => {
				const isUser = m.role === 'user';
				// Collect every image on this message without duplicating imageUrl if it
				// also appears in the images[] array.
				const gallery = [
					...(m.imageUrl ? [m.imageUrl] : []),
					...(m.images ?? []).filter((u) => u && u !== m.imageUrl),
				];
				return (
					<div class:list={['bubble-row', isUser ? 'from-user' : 'from-assistant']}>
						<div class="bubble">
							<span class="role-label">{isUser ? 'User' : 'Assistant'}</span>
							{m.content.trim().length > 0 ? (
								<p class="bubble-text">{m.content}</p>
							) : (
								<p class="bubble-text empty-text">(no text)</p>
							)}
							{m.refImageUrl && (
								<div class="ref-image">
									<span class="ref-label">Reference</span>
									<img
										src={resizedCdnImage(m.refImageUrl, 240)}
										alt="Reference image attached to this message"
										width="72"
										height="72"
										loading="lazy"
									/>
								</div>
							)}
							{gallery.length > 0 && (
								<div class="bubble-images">
									{gallery.map((imgUrl) => (
										<img
											src={resizedCdnImage(imgUrl, 440)}
											alt={isUser ? 'Image attached by the user' : 'Generated doodle'}
											width="200"
											height="200"
											loading="lazy"
										/>
									))}
								</div>
							)}
							<span class="bubble-time">{relativeTime(m.createdAt)}</span>
						</div>
					</div>
				);
			})
		)}
	</section>
</aside>

<style>
	.drawer {
		position: fixed;
		top: 0;
		right: 0;
		z-index: 20;
		display: flex;
		flex-direction: column;
		width: min(480px, 100vw);
		height: 100vh;
		overflow-y: auto;
		padding: 24px;
		background: var(--surface);
		border-left: 1px solid var(--border);
		box-shadow: -18px 0 50px rgba(0, 0, 0, 0.18);
		font-family: inherit;
	}
	.drawer-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--border);
	}
	.identity {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
	}
	.identity h2 {
		margin: 0;
		font-size: 17px;
		color: var(--text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.identity p,
	.identity span {
		display: block;
		margin: 3px 0 0;
		font-size: 11px;
		color: var(--text-dimmer);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.close {
		font-size: 26px;
		line-height: 1;
		color: var(--text-dimmer);
		text-decoration: none;
	}
	.close:hover {
		color: var(--text);
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 10px;
		padding: 18px 0;
		border-bottom: 1px solid var(--border);
	}
	.stats div {
		min-width: 0;
	}
	.stats strong,
	.stats span {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.stats strong {
		font-size: 14px;
		color: var(--text);
	}
	.stats span {
		margin-top: 3px;
		font-size: 10px;
		color: var(--text-dimmer);
	}
	.meta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		flex-wrap: wrap;
		padding: 14px 0;
		font-size: 11px;
		color: var(--text-dimmer);
		border-bottom: 1px solid var(--border);
	}
	.gen-statuses {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
	}
	.gen-chip {
		padding: 2px 8px;
		border-radius: 999px;
		font-size: 10.5px;
		background: var(--surface2);
		color: var(--text-dim);
		border: 1px solid var(--border2);
	}
	.gen-chip.gen-ok {
		color: var(--green);
	}
	.gen-chip.gen-failed {
		color: var(--red);
	}
	.transcript {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-top: 18px;
	}
	.empty-state {
		display: flex;
		flex-direction: column;
		gap: 6px;
		align-items: center;
		text-align: center;
		padding: 40px 16px;
		border: 1px dashed var(--border2);
		border-radius: 12px;
		background: var(--card);
	}
	.empty-state strong {
		font-size: 13px;
		color: var(--text);
	}
	.empty-state span {
		font-size: 11.5px;
		color: var(--text-dimmer);
		max-width: 280px;
	}
	.bubble-row {
		display: flex;
	}
	.bubble-row.from-user {
		justify-content: flex-end;
	}
	.bubble-row.from-assistant {
		justify-content: flex-start;
	}
	.bubble {
		display: flex;
		flex-direction: column;
		gap: 7px;
		max-width: 88%;
		padding: 11px 13px;
		border-radius: 14px;
		border: 1px solid var(--border2);
		background: var(--card);
	}
	.from-user .bubble {
		background: var(--surface2);
		border-color: var(--border3);
		border-bottom-right-radius: 5px;
	}
	.from-assistant .bubble {
		border-bottom-left-radius: 5px;
	}
	.role-label {
		font-size: 9.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-dimmer);
	}
	.bubble-text {
		margin: 0;
		font-size: 13px;
		line-height: 1.55;
		color: var(--text);
		/* User-supplied text: preserve author line breaks, wrap long unbroken
		   strings (pasted URLs/JSON) instead of overflowing the bubble. */
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		word-break: break-word;
	}
	.bubble-text.empty-text {
		color: var(--text-dimmer);
		font-style: italic;
	}
	.ref-image {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.ref-label {
		font-size: 10px;
		color: var(--text-dimmer);
	}
	.ref-image img {
		width: 72px;
		height: 72px;
		border-radius: 8px;
		object-fit: cover;
		background: var(--surface2);
		border: 1px solid var(--border2);
	}
	.bubble-images {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.bubble-images img {
		width: 200px;
		max-width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		border-radius: 10px;
		object-fit: cover;
		background: var(--surface2);
		border: 1px solid var(--border2);
	}
	.bubble-time {
		font-size: 10px;
		color: var(--text-dimmer);
		align-self: flex-end;
	}

	@media (max-width: 500px) {
		.drawer {
			width: 100vw;
			padding: 20px 16px;
			border-left: none;
		}
		.close {
			min-width: 44px;
			min-height: 44px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 28px;
		}
		.stats {
			grid-template-columns: repeat(2, 1fr);
		}
		.bubble {
			max-width: 92%;
		}
		.bubble-images img {
			width: 160px;
		}
	}
</style>
