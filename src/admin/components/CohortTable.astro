---
import SampleBadge from './SampleBadge.astro';

interface Props {
	cohortHeads: string[];
	cohorts: { label: string; cells: { value: string; style: string }[] }[];
}

const { cohortHeads, cohorts } = Astro.props;
---

<div class="panel">
	<div class="panel-heading-inline">
		<span class="panel-title">Retention by signup week</span>
		<SampleBadge reason="needs a per-cohort retention query; not implemented yet" />
	</div>
	<p class="panel-sub">% still generating</p>
	<div class="cohort-table">
		<div class="cohort-row cohort-head">
			<span></span>
			{cohortHeads.map((head) => <span class="cohort-head-cell">{head}</span>)}
		</div>
		{cohorts.map((cohort) => (
			<div class="cohort-row">
				<span class="cohort-label">{cohort.label}</span>
				{cohort.cells.map((cell) => <span class="cohort-cell" style={cell.style}>{cell.value}</span>)}
			</div>
		))}
	</div>
</div>

<style>
	.panel {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--card);
		padding: 18px 20px;
	}
	.panel-title {
		font-size: 13.5px;
		font-weight: 600;
		color: var(--text);
	}
	.panel-sub {
		font-size: 11.5px;
		color: var(--text-dimmer);
		margin: 5px 0 16px;
	}
	.panel-heading-inline {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.cohort-table {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}
	.cohort-row {
		display: grid;
		grid-template-columns: 44px repeat(5, 1fr);
		gap: 5px;
		align-items: center;
	}
	.cohort-head-cell {
		font-size: 9.5px;
		color: var(--text-dimmer);
		text-align: center;
	}
	.cohort-label {
		font-size: 10px;
		color: var(--text-dimmer);
	}
	.cohort-cell {
		font-size: 9.5px;
		text-align: center;
		padding: 6px 0;
		border-radius: 5px;
	}
</style>
