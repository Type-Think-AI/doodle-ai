---
import { ADMIN_NAV } from '../data/nav';
import type { AdminContext } from '../../lib/auth/admin-guard';

interface Props {
	active: string;
	admin: AdminContext;
	/** Real per-item counts resolved server-side. Absent keys render no badge. */
	badges?: Record<string, string>;
}

const { active, admin, badges = {} } = Astro.props;

// 'support' never sees pages that exist purely to perform a privileged
// action — hiding them beats showing a link that 403s.
const nav = ADMIN_NAV.map((group) => ({
	...group,
	items: group.items.filter((item) => !item.adminOnly || admin.platformRole === 'admin'),
})).filter((group) => group.items.length > 0);

const displayName = admin.user.name || admin.user.email;
const initial = (admin.user.name || admin.user.email).trim().charAt(0).toUpperCase() || 'A';
const rolePill = admin.platformRole === 'admin' ? 'ADMIN' : 'SUPPORT';

const ICONS: Record<string, string> = {
	overview:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M4 19V11M9.7 19V5M15.3 19v-6M21 19V8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>',
	users:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 20c.8-3.6 2.7-5.4 5.5-5.4s4.7 1.8 5.5 5.4M15 20c.5-2.6 1.9-4 3.7-4s2.9 1 3.3 3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
	orgs:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="8.5" width="7" height="11" rx="1.6" stroke="currentColor" stroke-width="1.6"/><rect x="13.5" y="4.5" width="7" height="15" rx="1.6" stroke="currentColor" stroke-width="1.6"/><path d="M6.2 12.2h1.6M6.2 15.4h1.6M16.2 8h1.6M16.2 11.2h1.6M16.2 14.4h1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
	projects:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M3.5 7.5A2 2 0 0 1 5.5 5.5h3.2l1.6 2.2h8.2a2 2 0 0 1 2 2v8.3a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-10.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
	media:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="4.5" width="17" height="15" rx="2.4" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="9.8" r="1.7" stroke="currentColor" stroke-width="1.5"/><path d="M4 16.5l4.4-3.6 3.5 2.8 3-2.4 5.1 4.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	chats:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M3.5 6.5A2 2 0 0 1 5.5 4.5h9a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H8l-4.5 3v-10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.5 17.2h6.2l4.3 2.8v-3.1a2 2 0 0 0 1.5-1.9v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	skills:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"/><circle cx="16" cy="16" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M10.4 10.4 13.6 13.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
	credits:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.6" fill="currentColor"/></svg>',
	batches:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.6"/><path d="M15 17h5M17.5 14.5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
	billing:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5.5" width="17" height="13" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 10h17" stroke="currentColor" stroke-width="1.6"/></svg>',
	marketing:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M4 15V9l14-4v18l-14-4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 15v4a2 2 0 0 0 4 0v-3" stroke="currentColor" stroke-width="1.5"/></svg>',
	seo:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M15.2 15.2 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M7.8 11.4l1.9 2 3-4.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	feedback:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M20 12.5c0 3.9-3.6 7-8 7-1 0-2-.16-2.9-.46L4.5 20.5l1.2-3.3A6.6 6.6 0 0 1 4 12.5c0-3.9 3.6-7 8-7s8 3.1 8 7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
	audit:
		'<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M6 3.5h8.5L19 8v12.5H6V3.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3.5V8h5M9 12.5h6M9 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
};
---

<aside class="sidebar" id="admin-sidebar">
	<div class="sidebar-top">
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" style="flex:0 0 24px;">
			<path
				d="M3 15c2-10 4 5 6-4s3 8 6-2 4 9 6-3"
				stroke="var(--accent)"
				stroke-width="2.4"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
		<span class="sidebar-label brand">Doodle AI</span>
		<span class="sidebar-label admin-pill">{rolePill}</span>
		<button class="nav-toggle" id="nav-toggle" title="Collapse" type="button">
			<svg width="13" height="13" viewBox="0 0 24 24" fill="none">
				<path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
				></path>
			</svg>
		</button>
	</div>

	<nav class="sidebar-nav">
		{
			nav.map((group) => (
				<div class="nav-group">
					<span class="sidebar-label group-label">{group.group.toUpperCase()}</span>
					{group.items.map((item) => (
						<a href={item.href} class="nav-item" class:list={{ active: active === item.key }} title={item.label}>
							<span class="nav-icon" set:html={ICONS[item.key]} />
							<span class="sidebar-label">{item.label}</span>
							{badges[item.key] && <span class="sidebar-label nav-badge">{badges[item.key]}</span>}
						</a>
					))}
				</div>
			))
		}
	</nav>

	<div class="sidebar-user">
		{
			admin.user.image ? (
				<img class="avatar avatar-img" src={admin.user.image} alt="" width="30" height="30" />
			) : (
				<span class="avatar">{initial}</span>
			)
		}
		<span class="sidebar-label user-info">
			<span class="user-name">{displayName}</span>
			<span class="user-email">{admin.user.email}</span>
		</span>
	</div>
</aside>

<!-- Mobile bottom tab bar (shown only ≤860px) -->
<nav class="admin-mobile-bar" aria-label="Admin navigation">
	<a href="/admin" class:list={['tab', { active: active === 'overview' }]} title="Overview">
		<span set:html={ICONS.overview} />
		<span class="tab-label">Overview</span>
	</a>
	<a href="/admin/users" class:list={['tab', { active: active === 'users' }]} title="Users">
		<span set:html={ICONS.users} />
		<span class="tab-label">Users</span>
	</a>
	<a href="/admin/skills" class:list={['tab', { active: active === 'skills' }]} title="Skills">
		<span set:html={ICONS.skills} />
		<span class="tab-label">Skills</span>
	</a>
	<a href="/admin/credits" class:list={['tab', { active: active === 'credits' }]} title="Credits">
		<span set:html={ICONS.credits} />
		<span class="tab-label">Credits</span>
	</a>
	<button type="button" class="tab" id="admin-menu-toggle" title="More pages">
		<svg width="17" height="17" viewBox="0 0 24 24" fill="none">
			<path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
		</svg>
		<span class="tab-label">More</span>
	</button>
</nav>

<!-- Mobile slide-out drawer with all nav items -->
<div class="admin-drawer-backdrop" id="admin-drawer-backdrop"></div>
<nav class="admin-mobile-drawer" id="admin-mobile-drawer" aria-label="All admin pages">
	<div class="drawer-head">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
			<path d="M3 15c2-10 4 5 6-4s3 8 6-2 4 9 6-3" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
		<strong>Admin</strong>
		<span class="drawer-pill">{rolePill}</span>
	</div>
	{nav.map((group) => (
		<div class="drawer-group">
			<span class="drawer-group-label">{group.group}</span>
			{group.items.map((item) => (
				<a href={item.href} class:list={['drawer-link', { active: active === item.key }]}>
					<span set:html={ICONS[item.key]} />
					{item.label}
					{badges[item.key] && <span class="drawer-badge">{badges[item.key]}</span>}
				</a>
			))}
		</div>
	))}
	<div class="drawer-user">
		<span class="avatar">{initial}</span>
		<span>{displayName}</span>
	</div>
</nav>

<style>
	/* --- Mobile bottom bar --- */
	.admin-mobile-bar {
		display: none;
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 30;
		align-items: center;
		justify-content: space-around;
		height: 56px;
		padding: 0 4px calc(env(safe-area-inset-bottom, 0px));
		background: var(--bg);
		border-top: 1px solid var(--border);
	}
	.tab {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 3px;
		min-height: 48px;
		padding: 6px 2px;
		color: var(--text-dimmer);
		text-decoration: none;
		font-size: 10px;
		border: none;
		background: transparent;
		cursor: pointer;
	}
	.tab.active {
		color: var(--accent);
	}
	.tab-label {
		font-size: 10px;
		white-space: nowrap;
	}

	/* --- Drawer backdrop + panel --- */
	.admin-drawer-backdrop {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 39;
		background: rgba(0, 0, 0, 0.55);
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	.admin-drawer-backdrop.open {
		opacity: 1;
	}
	.admin-mobile-drawer {
		display: none;
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 40;
		width: min(300px, 80vw);
		background: var(--bg);
		border-left: 1px solid var(--border);
		padding: 20px 16px 24px;
		overflow-y: auto;
		transform: translateX(100%);
		transition: transform 0.22s ease;
		flex-direction: column;
		gap: 16px;
	}
	.admin-mobile-drawer.open {
		transform: translateX(0);
	}
	.drawer-head {
		display: flex;
		align-items: center;
		gap: 8px;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--border);
	}
	.drawer-head strong {
		font-size: 16px;
		color: var(--text);
	}
	.drawer-pill {
		font-size: 10px;
		padding: 2px 6px;
		border-radius: 5px;
		background: var(--surface2);
		border: 1px solid var(--border2);
		color: var(--text-dimmer);
	}
	.drawer-group {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.drawer-group-label {
		font-size: 10px;
		letter-spacing: 0.08em;
		color: var(--text-dimmer);
		padding: 8px 0 6px;
		font-weight: 600;
	}
	.drawer-link {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 8px;
		border-radius: 9px;
		color: var(--text-dim);
		font-size: 14px;
		text-decoration: none;
		min-height: 44px;
	}
	.drawer-link:hover,
	.drawer-link.active {
		background: var(--hover);
		color: var(--text);
	}
	.drawer-link.active {
		color: var(--accent);
	}
	.drawer-badge {
		margin-left: auto;
		font-size: 10px;
		padding: 2px 7px;
		border-radius: 999px;
		background: var(--surface2);
		border: 1px solid var(--border2);
		color: var(--text-dimmer);
	}
	.drawer-user {
		margin-top: auto;
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 12px 8px 0;
		border-top: 1px solid var(--border);
		font-size: 12px;
		color: var(--text-dim);
	}

	@media (max-width: 860px) {
		.admin-mobile-bar {
			display: flex;
		}
		.admin-drawer-backdrop,
		.admin-mobile-drawer {
			display: flex;
		}
	}
</style>

<style>
	.sidebar {
		width: 230px;
		flex: 0 0 230px;
		background: var(--bg);
		border-right: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		padding: 18px 10px 14px;
		transition: width 0.16s ease;
	}
	.sidebar.collapsed {
		width: 68px;
		flex: 0 0 68px;
	}
	.sidebar.collapsed .sidebar-label {
		display: none;
	}
	.sidebar-top {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 0 10px 4px;
		height: 36px;
	}
	.brand {
		font-size: 15px;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text);
		white-space: nowrap;
	}
	.admin-pill {
		font-size: 10px;
		padding: 2px 6px;
		border-radius: 5px;
		background: var(--surface2);
		border: 1px solid var(--border2);
		color: var(--muted3, var(--text-dimmer));
	}
	.nav-toggle {
		margin-left: auto;
		width: 24px;
		height: 24px;
		border-radius: 7px;
		border: 1px solid var(--border2);
		background: transparent;
		color: var(--text-dimmer);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 24px;
	}
	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin-top: 18px;
		min-height: 0;
		overflow: auto;
	}
	.nav-group {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.group-label {
		font-size: 10px;
		letter-spacing: 0.1em;
		color: var(--muted3, var(--text-dimmer));
		padding: 0 12px 6px;
		white-space: nowrap;
	}
	.nav-item {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 34px;
		padding: 0 10px;
		border-radius: 9px;
		color: var(--text-dim);
		font-size: 13.5px;
		text-decoration: none;
		white-space: nowrap;
	}
	.nav-item:hover {
		background: var(--hover);
		color: var(--text);
	}
	.nav-item.active {
		background: var(--accent-softer);
		color: var(--accent);
	}
	.nav-icon {
		flex: 0 0 18px;
		display: flex;
		align-items: center;
	}
	.nav-badge {
		margin-left: auto;
		font-size: 10px;
		padding: 2px 7px;
		border-radius: 999px;
		background: var(--surface2);
		border: 1px solid var(--border2);
		color: var(--text-dimmer);
	}
	.sidebar-user {
		margin-top: auto;
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 8px 8px 0;
	}
	.avatar {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12.5px;
		font-weight: 700;
		color: #1a1a1a;
		flex: 0 0 30px;
	}
	.avatar-img {
		object-fit: cover;
		display: block;
	}
	.user-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.user-name {
		font-size: 12.5px;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.user-email {
		font-size: 11px;
		color: var(--text-dimmer);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	@media (max-width: 860px) {
		.sidebar {
			display: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const sidebar = document.getElementById('admin-sidebar');
	toggle?.addEventListener('click', () => {
		sidebar?.classList.toggle('collapsed');
	});

	// Mobile drawer toggle
	const menuBtn = document.getElementById('admin-menu-toggle');
	const drawer = document.getElementById('admin-mobile-drawer');
	const backdrop = document.getElementById('admin-drawer-backdrop');
	function openDrawer() { drawer?.classList.add('open'); backdrop?.classList.add('open'); }
	function closeDrawer() { drawer?.classList.remove('open'); backdrop?.classList.remove('open'); }
	menuBtn?.addEventListener('click', openDrawer);
	backdrop?.addEventListener('click', closeDrawer);
	// Close on link click for immediate navigation feel
	drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));
</script>
