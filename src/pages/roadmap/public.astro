---
// /roadmap/public — USER feedback board. Visible to everyone.
//
// Signed-in users can add feedback notes (appear as stickies).
// Admins can edit/delete anything (triage). Anonymous can only view.
// This is where the feedback dialog's sticky notes land.
export const prerender = false;

import AppShellLayout from '../../layouts/AppShellLayout.astro';
import RoadmapBoard from '../../components/app/RoadmapBoard.tsx';
import { resolvePlatformRole } from '../../lib/auth/admin-guard';
import { resolveTldrawLicenseKey } from '../../lib/tldraw-license';

const ROOM = 'public-v6';

type RoadmapEnv = { ROADMAP_ROOM?: unknown };
const env = (Astro.locals as { runtime?: { env?: RoadmapEnv } })?.runtime?.env;
const hasSync = !!env?.ROADMAP_ROOM;
const resolved = hasSync ? await resolvePlatformRole(Astro as never) : null;
const canSeed = !hasSync || resolved?.platformRole === 'admin';

// Same Worker env the ROADMAP_ROOM check above reads, resolved through
// readSecret because this one arrives as a Secrets Store binding.
const tldrawLicenseKey = await resolveTldrawLicenseKey(Astro.locals);
---

<AppShellLayout title="Roadmap — Doodle AI" active="roadmap" showFooter
  description="The Doodle AI public roadmap. See what's coming and drop your own feedback as a sticky note.">
  <div class="roadmap-page">
    <div class="roadmap-stage">
      <RoadmapBoard client:only="react" room={ROOM} connectPath={`/api/roadmap/connect/${ROOM}`} canSeed={canSeed} variant="public" licenseKey={tldrawLicenseKey} />
    </div>
  </div>
</AppShellLayout>

<style>
  /* Unlike the team board at /roadmap, this page is public and indexable, so it
     carries the site footer for nav and interlinking. That means the board can
     no longer fill the shell: with `height: 100%` the canvas ate the whole
     viewport and the footer sat below an unreachable fold. A bounded height
     leaves the canvas fully usable and lets the column scroll to the footer.
     The container stays visible and sized on first paint — tldraw never
     initialises inside a zero-height or display:none box. */
  .roadmap-page {
    display: flex;
    min-height: 0;
    padding: 0;
  }
  .roadmap-stage {
    flex: 1;
    min-width: 0;
    height: clamp(420px, 78dvh, 900px);
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 860px) {
    .roadmap-stage {
      height: clamp(380px, 70dvh, 640px);
    }
  }
</style>

<style is:global>
  .roadmap-stage .tl-container,
  .roadmap-stage .tl-theme__dark {
    --tl-color-background: var(--stage);
    --tl-color-grid: hsl(0, 0%, 38%);
  }
  .roadmap-stage .tlui-layout__bottom { padding-bottom: 10px; }
</style>

<script>
  window.dispatchEvent(new Event("doodleai:sidebar-collapse"));
</script>
