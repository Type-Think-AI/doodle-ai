---
import AppShellLayout from '../../layouts/AppShellLayout.astro';
import Lightbox from '../../components/app/Lightbox.astro';
import { SKILLS } from '../../lib/skills';

export function getStaticPaths() {
	return SKILLS.filter((skill) => skill.runnable).map((skill) => ({
		params: { skill: skill.id },
		props: { skill },
	}));
}

const { skill } = Astro.props;
---

<AppShellLayout title={`${skill.name} — DoodleBooth`} description={skill.desc} active="skills" crumb={skill.name} showHelper={false}>
	<div
		class="create-page"
		id="createPage"
		data-skill={skill.id}
		data-aspect={skill.aspectRatio}
		data-requires-photo={skill.requiresPhoto ? 'true' : 'false'}
	>
		<div class="create-panel" id="panelInput">
			<h1 class="create-title">{skill.name}</h1>
			<p class="create-tagline">{skill.tagline}</p>

			{skill.requiresPhoto ? (
				<Fragment>
					<label class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Upload a photo" for="fileInput">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4M12 4l-4 4M12 4l4 4"></path><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path></svg>
						<p class="main">Tap to upload a photo</p>
						<p>or drag one in</p>
					</label>

					<button class="camera-open-btn" type="button" id="cameraOpenBtn">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"></path><circle cx="12" cy="13.5" r="3.5"></circle></svg>
						Take a photo
					</button>
					<input type="file" id="cameraFallbackInput" accept="image/*" capture="environment" hidden />

					<div class="preview-row" id="previewRow" hidden>
						<img id="previewImg" alt="Your uploaded photo" />
						<div class="meta idle" id="previewMeta">Ready to doodle</div>
						<button class="link" type="button" id="changeBtn">Change</button>
					</div>

					<input type="file" id="fileInput" accept="image/*" />
				</Fragment>
			) : (
				<div class="surprise-field">
					<label for="surpriseDesc">Optional: describe a character</label>
					<textarea id="surpriseDesc" rows="2" placeholder="Leave blank for a random fictional character"></textarea>
				</div>
			)}

			<p class="key-banner" id="keyBanner" hidden>
				Add your PicX API key in <a href="/settings">Settings</a> to generate.
			</p>

			<button class="cta" type="button" id="generateBtn" disabled>Create my doodle</button>
			<p class="status" id="statusMsg" role="status" aria-live="polite"></p>
		</div>

		<div class="result print-strip" id="resultView" hidden>
			<p class="stub">your doodle · {skill.name}</p>
			<div class="result-stage" id="resultStage" role="button" tabindex="0" aria-label="View full doodle"></div>
			<div class="result-actions">
				<button class="cta ghost" type="button" id="downloadBtn">Download</button>
				<button class="cta ghost" type="button" id="retryBtn">Try another</button>
			</div>
			<div class="share-row" id="shareRow">
				<button class="share-btn" type="button" id="shareWhatsappBtn" aria-label="Share on WhatsApp">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.87.5 3.62 1.44 5.13L2 22l5.13-1.55a9.8 9.8 0 0 0 4.9 1.31h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.02c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.13.11-1.82-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.16-4.93-4.35-.15-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.26-.29.57-.36.76-.36h.55c.18 0 .43-.03.66.5.24.55.83 2.03.9 2.18.07.15.11.32.02.51-.09.19-.14.31-.27.48-.13.17-.29.38-.41.51-.13.15-.27.31-.12.58.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.05.16-.17.68-.79.86-1.06.18-.27.36-.22.6-.13.24.08 1.51.71 1.77.84.26.13.44.19.5.3.06.11.06.62-.18 1.3Z"></path></svg>
				</button>
				<button class="share-btn" type="button" id="shareXBtn" aria-label="Share on X">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.2 8.24L22.6 22h-6.9l-5.4-7.06L4 22H1l7.7-8.8L1.4 2h7l4.9 6.5L18.9 2Zm-2.4 18h1.9L7.6 4H5.6l10.9 16Z"></path></svg>
				</button>
				<button class="share-btn" type="button" id="shareCopyBtn" aria-label="Copy link">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
				</button>
			</div>
			<p class="share-copied" id="shareCopied" hidden>Link copied ✓</p>
		</div>
	</div>

	<Lightbox />

	<!-- Camera capture: live viewfinder with shutter, using getUserMedia. -->
	<div class="camera-backdrop" id="cameraBackdrop" role="dialog" aria-modal="true" aria-label="Take a photo">
		<div class="camera-stage">
			<video id="cameraVideo" autoplay playsinline muted></video>
			<canvas id="cameraCanvas" hidden></canvas>
			<button class="camera-close" id="cameraClose" type="button" aria-label="Close camera">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"></path></svg>
			</button>
			<p class="camera-error" id="cameraError" hidden></p>
		</div>
		<div class="camera-controls">
			<button class="camera-switch" id="cameraSwitch" type="button" aria-label="Switch camera" hidden>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 2l4 4-4 4"></path><path d="M21 6H8a5 5 0 0 0-5 5"></path><path d="M7 22l-4-4 4-4"></path><path d="M3 18h13a5 5 0 0 0 5-5"></path></svg>
			</button>
			<button class="camera-shutter" id="cameraShutter" type="button" aria-label="Capture photo"></button>
			<span class="camera-controls-spacer" aria-hidden="true"></span>
		</div>
	</div>
</AppShellLayout>

<script src="../../scripts/app/create.ts"></script>

<style>
	.create-page { max-width: 560px; margin: 0 auto; padding: 32px 20px 64px; }
	.create-panel { display: flex; flex-direction: column; }
	.create-title { font-size: 26px; font-weight: 600; letter-spacing: -0.02em; color: var(--text); margin: 0 0 4px; }
	.create-tagline { font-size: 14px; color: var(--text-dim); margin: 0 0 22px; }

	.dropzone {
		border: 2px dashed var(--border3);
		border-radius: 16px;
		padding: 26px 16px;
		text-align: center;
		cursor: pointer;
		display: block;
		margin-bottom: 12px;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.dropzone:hover, .dropzone.drag { border-color: var(--accent); background: var(--accent-softer); }
	.dropzone svg { width: 34px; height: 34px; margin-bottom: 8px; color: var(--text-dim); }
	.dropzone p { margin: 0; font-size: 14px; color: var(--text-dim); }
	.dropzone p.main { color: var(--text); font-weight: 500; margin-bottom: 2px; }
	input[type='file'] { display: none; }

	.camera-open-btn {
		width: 100%;
		height: 46px;
		margin: 0 0 14px;
		border: 1px solid var(--border3);
		border-radius: 999px;
		background: transparent;
		color: var(--text);
		font-family: inherit;
		font-weight: 500;
		font-size: 14px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}
	.camera-open-btn:hover { background: var(--hover); }
	.camera-open-btn svg { width: 18px; height: 18px; }

	.preview-row { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
	.preview-row img { width: 64px; height: 64px; object-fit: cover; border-radius: 50%; border: 2px solid var(--border3); }
	.preview-row .meta { flex: 1; font-size: 13px; color: var(--text-dim); }
	.preview-row .meta.uploading { color: var(--accent); }
	.preview-row .meta.done { color: #37b24d; }
	.preview-row .meta.error { color: #ff8a8a; }
	.preview-row button.link {
		background: none; border: none; color: var(--blue); font-size: 13px; cursor: pointer;
		padding: 0; text-decoration: underline; font-family: inherit;
	}

	.surprise-field { margin-bottom: 14px; }
	.surprise-field label { display: block; font-size: 12.5px; color: var(--text-dim); margin-bottom: 6px; }
	.surprise-field textarea {
		width: 100%; resize: vertical; font-family: inherit; font-size: 14px;
		padding: 10px 12px; border: 1px solid var(--border2); border-radius: 12px;
		background: var(--surface2); color: var(--text); box-sizing: border-box;
	}

	.key-banner { font-size: 13px; color: var(--text-dim); margin: 0 0 12px; }
	.key-banner a { color: var(--blue); text-decoration: underline; }

	.cta {
		width: 100%;
		height: 50px;
		border: 0;
		border-radius: 999px;
		background: var(--send-bg);
		color: var(--send-fg);
		font-family: inherit;
		font-weight: 600;
		font-size: 15px;
		cursor: pointer;
		transition: transform 0.12s ease, opacity 0.12s ease;
	}
	.cta:hover:not(:disabled) { transform: translateY(-1px); }
	.cta:disabled { opacity: 0.5; cursor: default; transform: none; }
	.cta.ghost { background: transparent; border: 1px solid var(--border3); color: var(--text); height: 44px; }

	.status { text-align: center; font-size: 13.5px; color: var(--text-dim); margin-top: 14px; min-height: 18px; }
	.status.err { color: #ff8a8a; }

	.result.print-strip {
		max-width: 340px;
		margin: 0 auto;
	}
	.result .stub { text-align: center; font-size: 14px; color: var(--text-dim); margin: 0 0 10px; }
	.result-stage {
		width: 100%;
		aspect-ratio: 1 / 1;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--border2);
		cursor: zoom-in;
	}
	.result-stage.aspect-3-2 { aspect-ratio: 3 / 2; }
	.result-stage img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.result-actions { display: flex; gap: 10px; margin-top: 14px; }
	.result-actions .cta { margin: 0; }
	.share-row { display: flex; gap: 8px; justify-content: center; margin-top: 12px; }
	.share-btn {
		width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border3);
		background: transparent; color: var(--text-dim); display: flex; align-items: center;
		justify-content: center; cursor: pointer;
	}
	.share-btn svg { width: 16px; height: 16px; }
	.share-btn:hover { color: var(--text); background: var(--hover); }
	.share-copied { text-align: center; font-size: 12px; color: #37b24d; margin: 8px 0 0; }

	.camera-backdrop {
		position: fixed; inset: 0; z-index: 75; display: none; flex-direction: column; background: #0c0906;
	}
	.camera-backdrop.open { display: flex; }
	.camera-stage { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
	.camera-stage video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
	.camera-stage video[data-facing='environment'] { transform: none; }
	.camera-close {
		position: absolute; top: 18px; right: 18px; width: 40px; height: 40px; border: 1px solid rgba(255,255,255,.4);
		border-radius: 50%; background: rgba(255,255,255,.1); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer;
	}
	.camera-close svg { width: 18px; height: 18px; }
	.camera-error {
		position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); max-width: 280px; text-align: center;
		color: #fff; font-size: 13.5px; line-height: 1.5; margin: 0; padding: 14px 18px; background: rgba(255,255,255,.08); border-radius: 12px;
	}
	.camera-controls {
		display: flex; align-items: center; justify-content: space-between; padding: 20px 28px calc(20px + env(safe-area-inset-bottom, 0px)); background: #0c0906;
	}
	.camera-controls-spacer, .camera-switch { width: 44px; height: 44px; }
	.camera-switch {
		border: 1px solid rgba(255,255,255,.4); border-radius: 50%; background: rgba(255,255,255,.1); color: #fff;
		display: flex; align-items: center; justify-content: center; cursor: pointer;
	}
	.camera-switch svg { width: 20px; height: 20px; }
	.camera-shutter { width: 68px; height: 68px; border-radius: 50%; border: 4px solid #fff; background: transparent; cursor: pointer; padding: 0; position: relative; }
	.camera-shutter::after { content: ''; position: absolute; inset: 6px; border-radius: 50%; background: #fff; transition: transform 0.12s ease; }
	.camera-shutter:active::after { transform: scale(0.82); }
</style>

<style is:global>
	/* The result <img> is created client-side by create.ts, so its rule
	   needs to be global (Astro's scoped-CSS attribute never reaches
	   elements that weren't in the original server-rendered markup). */
	.result-stage img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
