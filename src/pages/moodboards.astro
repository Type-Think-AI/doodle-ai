---
import AppShellLayout from '../layouts/AppShellLayout.astro';
import Lightbox from '../components/app/Lightbox.astro';
---

<AppShellLayout title="Moodboards — Doodle AI" active="moodboards">
	<div class="mood-page">
		<h1>Moodboards</h1>
		<p class="mood-sub">Doodles you've generated on this device, saved locally in your browser.</p>

		<div class="mood-grid" id="moodGrid"></div>
		<p class="mood-empty" id="moodEmpty" hidden>
			Nothing here yet — <a href="/skills">pick a skill</a> and create your first doodle.
		</p>
	</div>

	<Lightbox />
</AppShellLayout>

<script src="../scripts/app/moodboards-page.ts"></script>

<style>
	.mood-page { max-width: 1180px; margin: 0 auto; padding: 26px 40px 64px; }
	.mood-page h1 { font-size: 30px; font-weight: 600; letter-spacing: -0.02em; color: var(--text); margin: 0 0 6px; }
	.mood-sub { margin: 0 0 24px; font-size: 14px; color: var(--text-dimmer); }

	.mood-grid { columns: 4; column-gap: 16px; }
	.mood-empty { color: var(--text-dimmer); font-size: 14px; }
	.mood-empty a { color: var(--blue); text-decoration: underline; }

	@media (max-width: 980px) {
		.mood-grid { columns: 3; }
	}
	@media (max-width: 720px) {
		.mood-page { padding: 20px; }
		.mood-grid { columns: 2; column-gap: 10px; }
	}
</style>

<style is:global>
	/* Grid cells are built client-side by moodboards-page.ts, so their rules
	   need to be global (Astro's scoped CSS only reaches static markup). */
	.mood-cell {
		position: relative;
		break-inside: avoid;
		margin-bottom: 16px;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--border);
		cursor: pointer;
	}
	.mood-cell:hover { border-color: var(--border3); }
	.mood-cell img { width: 100%; display: block; overflow: hidden; font-size: 0; color: transparent; }
	.mood-remove {
		position: absolute;
		top: 6px;
		right: 6px;
		width: 24px;
		height: 24px;
		border: 1px solid var(--border3);
		border-radius: 50%;
		background: rgba(15, 15, 15, 0.72);
		color: #fff;
		font-size: 15px;
		line-height: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 0;
	}
	.mood-remove:hover { background: var(--accent); color: var(--send-fg); }
</style>
