---
import AppShellLayout from '../layouts/AppShellLayout.astro';
import SkillCard from '../components/app/SkillCard.astro';
import PromptComposer from '../components/app/PromptComposer.astro';
import { SKILLS } from '../lib/skills';
import { OG_IMAGE } from '../consts';

/* The homepage shows the catalogue almost in full — 20 of 21 — so a visitor can
   see the range without a second click, with the trailing "See all" row as the
   handoff to /skills for the remainder. */
const HOME_SKILL_COUNT = 20;
const featuredSkills = SKILLS.slice(0, HOME_SKILL_COUNT);

/* The first grid row is above the fold and holds the LCP candidate, so those
   cards load eagerly with fetchpriority=high; the other 16 stay lazy. Four
   covers the widest (desktop 4-up) row — at the 3-up and 2-up breakpoints this
   eagerly loads at most two extra cards, which is a cheaper trade than a
   lazy-loaded LCP image. */
const PRIORITY_SKILL_COUNT = 4;
---

<AppShellLayout
	title="Doodle AI — AI Doodle Avatar Generator from Your Photo"
	description="Turn your photo into a playful hand-drawn doodle avatar with Doodle AI, powered by PicX AI."
	image={OG_IMAGE.home}
	markdownUrl="/index.md"
	active="chat"
	showFooter={true}
>
	<div class="home-page">
		<div class="home-hero">
			<h1>What should we doodle?</h1>
			<p class="home-sub">Attach a photo and tell me what you want, or just describe a character for a surprise.</p>
			<PromptComposer id="home" variant="hero" placeholder="Describe a doodle or attach a photo" />
		</div>

		<div class="home-skills">
			<div class="home-skills-head">
				<h2>Skills</h2>
				<a href="/skills">Browse all {SKILLS.length}
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12h13m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
				</a>
			</div>
			<div class="home-skills-grid">
				{featuredSkills.map((skill, i) => <SkillCard skill={skill} priority={i < PRIORITY_SKILL_COUNT} />)}
			</div>
			<a class="home-skills-more" href="/skills">
				See all {SKILLS.length} skills
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h13m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
			</a>
		</div>
	</div>
</AppShellLayout>

<script src="../scripts/app/home.ts"></script>

<style>
	.home-page { max-width: 1000px; margin: 0 auto; padding: 48px 20px 64px; }

	.home-hero { max-width: 680px; margin: 0 auto 56px; text-align: left; }
	.home-hero h1 { font-size: 34px; font-weight: 500; letter-spacing: -0.02em; color: var(--text); margin: 0 0 8px; text-align: center; }
	.home-sub { font-size: 14px; color: var(--text-dimmer); margin: 0 0 26px; text-align: center; }

	.home-skills-head { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
	.home-skills-head h2 { font-size: 18px; font-weight: 600; color: var(--text); margin: 0; }
	.home-skills-head a { margin-left: auto; display: flex; align-items: center; gap: 6px; min-height: 44px; color: var(--text); font-size: 13.5px; }
	.home-skills-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }

	/* Second, wider handoff to /skills below the grid. The header link is easy
	   to miss once you have scrolled past it, and this is the point at which a
	   visitor has just looked at eight cards and wants the rest. Flat row with a
	   thin rule, not a card. */
	.home-skills-more {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 48px;
		margin-top: 22px;
		border: 1px solid var(--border2);
		border-radius: 999px;
		color: var(--text-dim);
		font-size: 13.5px;
		font-weight: 500;
		transition: border-color 0.2s ease, color 0.2s ease;
	}
	.home-skills-more:hover { border-color: var(--border3); color: var(--text); }
	.home-skills-more:focus-visible { outline: 2px solid var(--border3); outline-offset: 3px; }

	@media (max-width: 980px) {
		.home-skills-grid { grid-template-columns: repeat(3, 1fr); }
	}
	@media (max-width: 720px) {
		.home-page { padding: 32px 16px 48px; }
		.home-hero h1 { font-size: 26px; }
		.home-skills-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
	}
</style>
