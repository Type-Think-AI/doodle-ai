---
import AppShellLayout from '../layouts/AppShellLayout.astro';
import HomeHero from '../components/app/HomeHero.astro';
import HomeStartHere from '../components/app/HomeStartHere.astro';
import HomeSkillsRail from '../components/app/HomeSkillsRail.astro';
import { OG_IMAGE } from '../consts';
import '../styles/home-conversion.css';
import '../styles/growth.css';
---

<AppShellLayout
	title="Doodle AI — AI Doodle Avatar Generator from Your Photo"
	description="Turn your photo into a playful hand-drawn doodle avatar with Doodle AI, powered by PicX AI."
	image={OG_IMAGE.home}
	markdownUrl="/index.md"
	active="chat"
	showFooter={true}
>
	<div class="home-page">
		<HomeHero />
		<HomeStartHere />
		<HomeSkillsRail />
	</div>
</AppShellLayout>

<script src="../scripts/app/home.ts"></script>
<script src="../scripts/app/home-filters.ts"></script>
<script src="../scripts/app/composer-credit-hint.ts"></script>
