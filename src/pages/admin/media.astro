---
// Server-rendered, never static — see src/pages/admin/index.astro for why
// this line is load-bearing rather than a formality. Without it Astro bakes
// this page into static HTML, which serves the generated-image gallery
// publicly and bypasses the /admin/* auth middleware.
export const prerender = false;

import AdminLayout from '../../admin/layouts/AdminLayout.astro';
import MediaPage from '../../admin/pages/MediaPage.astro';

const admin = Astro.locals.admin!;
---

<AdminLayout active="media" admin={admin}>
	<MediaPage />
</AdminLayout>
