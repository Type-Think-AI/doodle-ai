---
export const prerender = false;
import AppLayout from '../../layouts/AppLayout.astro';
const { token } = Astro.params;
---

<AppLayout title="Shared board — Doodle AI" description="Shared Doodle AI board." noindex>
  <main class="share-page" id="sharePage" data-token={token}>
    <header class="share-header">
      <a href="/" class="share-brand"><span>〰</span>Doodle AI</a>
      <span class="share-label">Shared board</span>
    </header>
    <section class="share-content">
      <div>
        <span class="team-kicker" id="shareOrg">Shared workspace</span>
        <h1 id="shareTitle">Loading…</h1>
        <p id="shareDescription">Checking the link.</p>
      </div>
      <div class="share-grid" id="shareGrid"></div>
      <p class="share-error" id="shareError" hidden></p>
      <p class="share-disclosure" id="shareDisclosure" hidden>
        Revoking this link stops it from resolving, but does <strong>not</strong> un-publish
        PicX CDN image URLs — those remain publicly accessible by design.
      </p>
    </section>
  </main>
</AppLayout>

<script src="../../scripts/app/share-page.ts"></script>

<style>
  .share-page{min-height:100dvh;background:var(--bg);color:var(--text)}
  .share-header{display:flex;justify-content:space-between;align-items:center;padding:24px 32px;border-bottom:1px solid var(--border)}
  .share-brand{display:flex;align-items:center;gap:8px;font-weight:650;text-decoration:none;color:var(--text)}
  .share-brand span{color:var(--accent);font-size:25px}
  .share-label{color:var(--text-dimmer);font-size:11px}
  .share-content{max-width:1180px;margin:0 auto;padding:56px 44px 80px}
  .team-kicker{display:block;color:var(--accent);font-size:10px;font-weight:750;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px}
  .share-content h1{font-size:clamp(30px,5vw,50px);letter-spacing:-.06em}
  .share-content p{margin-top:9px;color:var(--text-dim);font-size:13px}
  .share-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-top:38px}
  .share-grid:empty{display:none}
  .share-error{color:var(--red)!important}
  .share-disclosure{margin-top:32px;padding-top:16px;border-top:1px solid var(--border);color:var(--text-dimmer);font-size:11px;line-height:1.5}
  .share-disclosure strong{color:var(--text-dim)}
  @media(max-width:760px){.share-header{padding:20px}.share-content{padding:36px 20px 60px}}
</style>

<style is:global>
  /* The grid CELLS are created at runtime by share-page.ts, and Astro's scoped
     CSS only rewrites selectors it can see in the static markup — a scoped
     `.share-asset img` rule therefore never matches a client-built <figure>.
     These have to be global.

     This was a real defect, not a precaution: without it the doodles rendered
     at their intrinsic size (1024px+) and a single image overflowed the whole
     viewport instead of forming a grid. */
  .share-asset {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    margin: 0;
  }
  /* height:auto with width:100% preserves each doodle's real proportions —
     no forced square crop. */
  .share-asset img {
    display: block;
    width: 100%;
    height: auto;
  }
  .share-asset figcaption {
    padding: 10px;
    color: var(--text-dim);
    font-size: 11px;
  }
</style>
