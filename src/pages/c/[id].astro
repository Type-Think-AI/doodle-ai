---
export const prerender = false;
import AppShellLayout from '../../layouts/AppShellLayout.astro';
import Lightbox from '../../components/app/Lightbox.astro';
import PromptComposer from '../../components/app/PromptComposer.astro';
import DoodleCanvas from '../../components/app/DoodleCanvas.tsx';

// Scopes the canvas's local persistence so each conversation keeps its own
// board. Route param only — the thread's contents still live in localStorage
// and are read client-side, same as before.
const threadId = Astro.params.id ?? 'new';
---

<AppShellLayout title="Chat — Doodle AI" active="chat">
	<!-- data-whiteboard starts "true": the canvas is the point of this screen,
	     so it is shown by default rather than hidden behind a toggle. This is
	     also load-bearing — tldraw mounted inside a display:none container
	     never finishes initializing (renders its container, never calls
	     onMount, never accepts an image), so the canvas must be visible on
	     first paint. The toggle still closes/reopens it; by then the editor
	     already exists and only needs a re-measure. -->
	<div class="chat-split" id="chatSplit" data-whiteboard="true">
		<div class="chat-page" id="chatPage">
			<button type="button" class="whiteboard-toggle" id="whiteboardToggle" aria-pressed="true">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18M9 9v9" stroke="currentColor" stroke-width="1.6"/></svg>
				<span>Canvas</span>
			</button>

			<div class="chat-thread" id="chatThread">
				<div class="chat-empty" id="chatEmpty">
					<h1>What should we doodle?</h1>
					<p>Attach a photo and tell me what you want, or just describe a character for a surprise.</p>
				</div>
			</div>

			<div class="chat-composer">
				<PromptComposer id="chat" variant="compact" placeholder="Describe a doodle or attach a photo" />
			</div>
		</div>

		<!-- Draggable divider between the chat column and the board. Sits
		     between the two panes so the pointer maths is a straight
		     "where is the cursor inside .chat-split" — see chat.ts. Exposed as
		     a real separator (role + tabindex) so it is keyboard-operable,
		     not mouse-only. -->
		<div
			class="chat-split-handle"
			id="chatSplitHandle"
			role="separator"
			aria-orientation="vertical"
			aria-label="Resize chat and canvas"
			tabindex="0"
		></div>

		<!-- Infinite canvas (tldraw). Replaces the old fixed thumbnail grid,
		     which could only ever show an image index. Generated doodles are
		     placed as real image shapes chat.ts pushes over the
		     "doodleai:canvas-add" event, so this island stays decoupled from
		     the vanilla chat controller. client:only is required: tldraw is
		     browser-only and must never enter the Worker/SSR bundle. -->
		<div class="canvas-panel" id="canvasPanel">
			<!-- No header bar: it stacked a second strip of chrome directly above
			     tldraw's own menu row, and the skill chips overflowed their track.
			     The board is full-bleed instead. The chat pane's "Canvas" toggle
			     still opens/closes the panel, and skills are still pickable from
			     the composer with "/" — so nothing here was the only route to a
			     feature. Close stays as a floating control because on mobile the
			     board replaces the chat outright and this is the way back. -->
			<div class="canvas-stage" id="canvasStage">
				<DoodleCanvas client:only="react" threadId={threadId} />
				<div class="canvas-empty-hint" id="canvasEmptyHint">
					<p>Your doodles will appear here as you generate them.<br/>Pan, zoom, resize, draw on them — it's your infinite canvas.</p>
				</div>
				<button type="button" class="canvas-close" id="whiteboardClose" aria-label="Close canvas">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
				</button>
			</div>
		</div>
	</div>

	<Lightbox />
</AppShellLayout>

<script src="../../scripts/app/chat.ts"></script>

<style>
	.chat-split {
		display: flex;
		height: 100%;
		min-height: 0;
	}
	.chat-page {
		max-width: 760px;
		margin: 0 auto;
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 0 20px;
		min-width: 0;
		transition: flex-basis 0.18s ease;
	}
	/* Whiteboard mode: chat narrows and the board takes the rest. The width is
	   a custom property rather than a hardcoded percentage so the drag handle
	   can rewrite it live (and restore it from localStorage) without this rule
	   needing to know anything about resizing. */
	.chat-split[data-whiteboard="true"] .chat-page {
		max-width: none;
		margin: 0;
		flex: 0 0 var(--chat-split-w, 30%);
		border-right: 1px solid var(--border);
	}
	/* No transition while dragging — animating flex-basis on every pointermove
	   makes the divider lag behind the cursor. */
	.chat-split[data-resizing="true"] .chat-page { transition: none; }
	.chat-split[data-resizing="true"] { cursor: col-resize; user-select: none; }

	.chat-split-handle {
		display: none;
		flex: 0 0 7px;
		margin: 0 -3px; /* straddle the border so the grab zone is wider than the visual line */
		cursor: col-resize;
		position: relative;
		z-index: 5;
		background: transparent;
		touch-action: none;
	}
	.chat-split[data-whiteboard="true"] .chat-split-handle { display: block; }
	/* The visible hairline only appears on hover/drag/focus, so at rest the
	   split reads as a single quiet rule rather than a piece of UI. */
	.chat-split-handle::after {
		content: '';
		position: absolute;
		inset: 0 3px;
		background: var(--accent);
		opacity: 0;
		transition: opacity 140ms ease-out;
	}
	.chat-split-handle:hover::after,
	.chat-split-handle:focus-visible::after,
	.chat-split[data-resizing="true"] .chat-split-handle::after { opacity: 0.55; }
	.chat-split-handle:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
	.whiteboard-toggle {
		display: flex;
		align-items: center;
		gap: 7px;
		align-self: flex-start;
		margin: 14px 0 0;
		padding: 7px 12px;
		border: 1px solid var(--border2);
		border-radius: 999px;
		background: var(--surface2);
		color: var(--text-dim);
		font-size: 12.5px;
		font-family: inherit;
		cursor: pointer;
	}
	.whiteboard-toggle:hover { color: var(--text); background: var(--hover); }
	.whiteboard-toggle[aria-pressed="true"] { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border2)); }

	.canvas-panel {
		flex: 1 1 70%;
		min-width: 0;
		display: none;
		flex-direction: column;
		/* overflow:hidden prevents the tldraw toolbar (which sits at its own
		   bottom edge) from bleeding past the viewport if the panel + header
		   heights don't leave enough room. Without this, the toolbar is
		   clipped by the viewport rather than the panel — visually identical
		   to "working but slightly cut off" on 900px heights. */
		overflow: hidden;
	}
	.chat-split[data-whiteboard="true"] .canvas-panel { display: flex; }

	/* Floating over the board rather than sitting in a header strip. Raised
	   above tldraw's own UI layer (z-index 300) so it can't end up underneath
	   a toolbar, and offset from the top-right corner tldraw leaves free now
	   that the style panel is gone. */
	.canvas-close {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 320;
		width: 30px;
		height: 30px;
		border: 1px solid var(--border2);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface2) 82%, transparent);
		backdrop-filter: blur(6px);
		color: var(--text-dim);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.canvas-close:hover { background: var(--hover); color: var(--text); }
	.canvas-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

	/* tldraw measures itself against its container, so the stage needs a
	   definite size — `flex: 1` with `min-height: 0` gives it one inside the
	   column without the canvas pushing the header off-screen. `position:
	   relative` is the positioning context the canvas root absolutely fills
	   (the root supplies its own inset:0 — see DoodleCanvas.tsx). */
	.canvas-stage {
		flex: 1;
		min-height: 0;
		min-width: 0;
		position: relative;
	}
	.canvas-empty-hint {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		z-index: 0;
	}
	/* `display: flex` above outranks the `hidden` attribute's built-in
	   `display: none`, so setting hint.hidden = true left the placeholder
	   painted on top of the doodles it was meant to make way for. */
	.canvas-empty-hint[hidden] { display: none; }
	.canvas-empty-hint p {
		text-align: center;
		font-size: 13px;
		line-height: 1.6;
		color: var(--text-dimmer);
		max-width: 320px;
	}
	@media (max-width: 860px) {
		/* No room to split a phone screen two ways — canvas mode replaces
		   the chat outright instead, with the close button as the way back.
		   The divider goes with it: there is nothing left to drag against, and
		   a 7px grab strip on a touch screen is a mis-tap waiting to happen. */
		.chat-split[data-whiteboard="true"] .chat-page { display: none; }
		.chat-split[data-whiteboard="true"] .canvas-panel { flex: 1 1 auto; width: 100%; }
		.chat-split[data-whiteboard="true"] .chat-split-handle { display: none; }
		/* Bigger tap target than the desktop 30px, per the app's touch convention. */
		.canvas-close { width: 44px; height: 44px; top: 10px; right: 10px; }

		/* .chat-split is height:100% of .app-shell-content, which drops its fixed
		   viewport height at this breakpoint — so the only thing giving this
		   subtree a height on mobile was .chat-page's own min-height below. With
		   the canvas open .chat-page is display:none, which left .chat-split,
		   .canvas-panel and .canvas-stage all measuring 390x0: tldraw sizes from
		   its container, so the board mounted into zero height and the whole
		   canvas — close button included — was invisible and un-tappable.
		   Matches .chat-page's own reservation so the board ends flush above the
		   fixed bottom nav. */
		.chat-split[data-whiteboard="true"] { min-height: calc(100dvh - var(--mobile-nav-h, 72px)); }
	}
	.chat-thread {
		flex: 1;
		overflow: auto;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 28px 0 20px;
	}
	.chat-empty {
		margin: auto;
		text-align: center;
		max-width: 420px;
	}
	.chat-empty h1 { font-size: 30px; font-weight: 500; letter-spacing: -0.02em; color: var(--text); margin: 0 0 8px; }
	.chat-empty p { font-size: 14px; color: var(--text-dimmer); margin: 0; }

	.chat-composer {
		position: sticky;
		bottom: 0;
		padding: 10px 0 22px;
		background: var(--surface);
	}

	/* .app-shell drops its fixed viewport height at this same breakpoint
	   (app-shell.css) so pages with natural page-scroll (Home, Skills,
	   Moodboards) work on mobile. Chat needs the opposite — a real
	   viewport-height column so its thread scrolls internally and the
	   composer stays pinned above the fixed bottom nav — so it restores
	   that height itself here instead of inheriting the collapsed one.
	   --mobile-nav-h (set by mobile-nav-height.ts from the nav's real
	   rendered height) matches .app-shell-content's mobile nav reservation.
	   That reservation would otherwise double up: .app-shell-content also
	   pads itself by the same amount, which — stacked under this min-height
	   — left a blank gap between the composer and the bottom nav. Chat owns
	   the reservation itself here, so it cancels the shared one back out. */
	@media (max-width: 860px) {
		.chat-page { height: auto; min-height: calc(100dvh - var(--mobile-nav-h, 72px)); }
		:global(.app-shell-content) { padding-bottom: 0; }
	}

	@media (max-width: 720px) {
		.chat-page { padding: 0 14px; }
		.chat-empty h1 { font-size: 24px; }
	}
</style>

<style is:global>
	/* ---- tldraw canvas theming ----
	   tldraw's classes are generated inside a client:only island, so Astro's
	   scoped-CSS attribute never reaches them — these have to be global, and
	   are namespaced under .canvas-stage so they can't leak to another board.
	   Both are tldraw's own documented custom properties rather than element
	   overrides, so tldraw keeps full control of layout and only the palette
	   changes: a near-black plane with a low-contrast dot grid. */
	.canvas-stage .tl-container,
	.canvas-stage .tl-theme__dark {
		--tl-color-background: var(--stage);
		--tl-color-grid: hsl(0, 0%, 38%);
	}

	/* tldraw's bottom cluster (zoom control bottom-left, tool row bottom-centre)
	   carries no padding of its own — it expects the host to leave room. The
	   canvas stage runs to the exact viewport bottom, so the row landed flush
	   on the edge and its icons read as sliced off. This is the clearance
	   tldraw assumes, applied here rather than by shrinking the stage, so the
	   board itself still uses the full height. */
	.canvas-stage .tlui-layout__bottom { padding-bottom: 10px; }

	/* The placeholder has to sit ABOVE the board, not behind it: tldraw paints
	   an opaque background over the full stage, so a hint at z-index 0 is
	   invisible on an empty canvas. pointer-events stays none, so it never
	   intercepts a drag — and tldraw's own UI layer is z-index 300, well clear
	   of this, so the toolbar is unaffected. */
	.canvas-stage .canvas-empty-hint { z-index: 2; }

	/* Message bubbles are built client-side by chat.ts, so this block is
	   global — Astro's scoped-CSS attribute never reaches elements created
	   after the initial render. */
	.chat-msg { display: flex; }
	.chat-msg-user { justify-content: flex-end; }
	.chat-bubble {
		max-width: 84%;
		padding: 11px 14px;
		border-radius: 16px;
		font-size: 14.5px;
		line-height: 1.55;
		white-space: pre-wrap;
	}
	.chat-msg-user .chat-bubble { background: var(--surface2); color: var(--text); border: 1px solid var(--border2); }
	.chat-msg-assistant .chat-bubble { background: var(--card); color: var(--text); border: 1px solid var(--border); }
	.chat-bubble-photo { width: 96px; height: 96px; object-fit: cover; border-radius: 10px; margin-bottom: 8px; display: block; overflow: hidden; font-size: 0; color: transparent; }
	.chat-bubble-thinking { display: flex; align-items: center; gap: 9px; color: var(--text-dimmer); }
	.chat-thinking-spinner {
		width: 15px;
		height: 15px;
		flex: 0 0 15px;
		border-radius: 50%;
		border: 2px solid var(--border3);
		border-top-color: var(--text-dim);
		animation: chat-thinking-spin 0.7s linear infinite;
	}
	@keyframes chat-thinking-spin { to { transform: rotate(360deg); } }
	.chat-bubble-streaming::after {
		content: "";
		display: inline-block;
		width: 7px;
		height: 14px;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: var(--text-dimmer);
		animation: chat-streaming-caret 0.8s ease-in-out infinite;
	}
	@keyframes chat-streaming-caret { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
	.chat-bubble-images { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px; margin-top: 10px; }
	.chat-bubble-image-wrap { position: relative; border-radius: 12px; overflow: hidden; border: 1px solid var(--border2); cursor: zoom-in; }
	.chat-bubble-image-wrap img { width: 100%; display: block; aspect-ratio: 1 / 1; object-fit: cover; overflow: hidden; font-size: 0; color: transparent; }
	.chat-bubble-image-source { cursor: default; }
	.chat-bubble-image-tag {
		position: absolute;
		left: 8px;
		bottom: 8px;
		padding: 3px 9px;
		border-radius: 999px;
		background: rgba(15, 15, 15, 0.72);
		color: #fff;
		font-size: 11px;
	}
	.chat-bubble-actions { display: flex; gap: 8px; margin-top: 8px; }
	.chat-bubble-actions button {
		height: 30px;
		padding: 0 12px;
		border-radius: 999px;
		border: 1px solid var(--border3);
		background: transparent;
		color: var(--text-dim);
		font-size: 12px;
		cursor: pointer;
		font-family: inherit;
	}
	.chat-bubble-actions button:hover { color: var(--text); background: var(--hover); }

	/* Remix/Save/Download are plain-text buttons at 30px tall on desktop,
	   sized for mouse precision — too small for the 44px touch-target
	   convention this app uses elsewhere on mobile. Bump their height and
	   let the row wrap instead of overflow, since the three labels
	   ("Remix", "Save to moodboard", "Download") don't reliably fit on one
	   line inside the 84%-wide bubble at 320-375px. */
	@media (max-width: 860px) {
		.chat-bubble-actions { flex-wrap: wrap; gap: 10px; }
		.chat-bubble-actions button {
			height: 44px;
			padding: 0 14px;
			font-size: 13px;
		}
	}
</style>
