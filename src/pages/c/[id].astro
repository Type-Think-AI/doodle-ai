---
export const prerender = false;
import AppShellLayout from '../../layouts/AppShellLayout.astro';
import Lightbox from '../../components/app/Lightbox.astro';
import PromptComposer from '../../components/app/PromptComposer.astro';
import { SKILLS } from '../../lib/skills';

const runnableSkills = SKILLS.filter((s) => s.runnable);
---

<AppShellLayout title="Chat — Doodle AI" active="chat">
	<div class="chat-split" id="chatSplit">
		<div class="chat-page" id="chatPage">
			<button type="button" class="whiteboard-toggle" id="whiteboardToggle" aria-pressed="false">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18M9 9v9" stroke="currentColor" stroke-width="1.6"/></svg>
				<span>Whiteboard</span>
			</button>

			<div class="chat-thread" id="chatThread">
				<div class="chat-empty" id="chatEmpty">
					<h1>What should we doodle?</h1>
					<p>Attach a photo and tell me what you want, or just describe a character for a surprise.</p>
				</div>
			</div>

			<div class="chat-composer">
				<PromptComposer id="chat" variant="compact" placeholder="Describe a doodle or attach a photo" />
			</div>
		</div>

		<!-- All uploaded/generated images from this chat, laid out as a grid
		     (docs task: whiteboard mode). Hidden until toggled on; chat.ts
		     builds the tiles and skill-pick row client-side, same reasoning as
		     the message bubbles below being is:global. -->
		<div class="whiteboard-panel" id="whiteboardPanel" hidden>
			<div class="whiteboard-header">
				<h2>Whiteboard</h2>
				<div class="whiteboard-skills" id="whiteboardSkills">
					{runnableSkills.map((skill) => (
						<button type="button" class="whiteboard-skill-btn" data-skill-id={skill.id}>{skill.name}</button>
					))}
				</div>
				<button type="button" class="whiteboard-close" id="whiteboardClose" aria-label="Close whiteboard">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
				</button>
			</div>
			<div class="whiteboard-grid" id="whiteboardGrid"></div>
			<p class="whiteboard-empty" id="whiteboardEmpty" hidden>Nothing generated yet — doodles and uploads from this chat will show up here.</p>
		</div>
	</div>

	<Lightbox />
</AppShellLayout>

<script src="../../scripts/app/chat.ts"></script>

<style>
	.chat-split {
		display: flex;
		height: 100%;
		min-height: 0;
	}
	.chat-page {
		max-width: 760px;
		margin: 0 auto;
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 0 20px;
		min-width: 0;
		transition: flex-basis 0.18s ease;
	}
	/* Whiteboard mode: chat narrows to ~30% instead of centering at a fixed
	   760px, and the panel takes the rest. Percentages, not a fixed px split,
	   so the ratio holds as the window resizes. */
	.chat-split[data-whiteboard="true"] .chat-page {
		max-width: none;
		margin: 0;
		flex: 0 0 30%;
		border-right: 1px solid var(--border);
	}
	.whiteboard-toggle {
		display: flex;
		align-items: center;
		gap: 7px;
		align-self: flex-start;
		margin: 14px 0 0;
		padding: 7px 12px;
		border: 1px solid var(--border2);
		border-radius: 999px;
		background: var(--surface2);
		color: var(--text-dim);
		font-size: 12.5px;
		font-family: inherit;
		cursor: pointer;
	}
	.whiteboard-toggle:hover { color: var(--text); background: var(--hover); }
	.whiteboard-toggle[aria-pressed="true"] { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border2)); }

	.whiteboard-panel {
		flex: 1 1 70%;
		min-width: 0;
		display: none;
		flex-direction: column;
		height: 100%;
	}
	.chat-split[data-whiteboard="true"] .whiteboard-panel { display: flex; }
	.whiteboard-header {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 16px 20px;
		border-bottom: 1px solid var(--border);
	}
	.whiteboard-header h2 { font-size: 15px; font-weight: 600; color: var(--text); margin: 0; flex: 0 0 auto; }
	.whiteboard-skills {
		flex: 1;
		min-width: 0;
		display: flex;
		gap: 7px;
		overflow-x: auto;
	}
	.whiteboard-close {
		flex: 0 0 auto;
		width: 28px;
		height: 28px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--text-dimmer);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.whiteboard-close:hover { background: var(--hover); color: var(--text); }

	.whiteboard-skill-btn {
		flex: 0 0 auto;
		height: 30px;
		padding: 0 12px;
		border-radius: 999px;
		border: 1px solid var(--border3);
		background: transparent;
		color: var(--text-dim);
		font-size: 12px;
		font-family: inherit;
		cursor: pointer;
		white-space: nowrap;
	}
	.whiteboard-skill-btn:hover { color: var(--text); background: var(--hover); }
	.whiteboard-skill-btn[data-active="true"] { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border3)); }

	@media (max-width: 860px) {
		/* No room to split a phone screen two ways — whiteboard mode replaces
		   the chat outright instead, with the close button as the way back. */
		.chat-split[data-whiteboard="true"] .chat-page { display: none; }
		.chat-split[data-whiteboard="true"] .whiteboard-panel { flex: 1 1 auto; width: 100%; }
	}
	.chat-thread {
		flex: 1;
		overflow: auto;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 28px 0 20px;
	}
	.chat-empty {
		margin: auto;
		text-align: center;
		max-width: 420px;
	}
	.chat-empty h1 { font-size: 30px; font-weight: 500; letter-spacing: -0.02em; color: var(--text); margin: 0 0 8px; }
	.chat-empty p { font-size: 14px; color: var(--text-dimmer); margin: 0; }

	.chat-composer {
		position: sticky;
		bottom: 0;
		padding: 10px 0 22px;
		background: var(--surface);
	}

	/* .app-shell drops its fixed viewport height at this same breakpoint
	   (app-shell.css) so pages with natural page-scroll (Home, Skills,
	   Moodboards) work on mobile. Chat needs the opposite — a real
	   viewport-height column so its thread scrolls internally and the
	   composer stays pinned above the fixed bottom nav — so it restores
	   that height itself here instead of inheriting the collapsed one.
	   --mobile-nav-h (set by mobile-nav-height.ts from the nav's real
	   rendered height) matches .app-shell-content's mobile nav reservation.
	   That reservation would otherwise double up: .app-shell-content also
	   pads itself by the same amount, which — stacked under this min-height
	   — left a blank gap between the composer and the bottom nav. Chat owns
	   the reservation itself here, so it cancels the shared one back out. */
	@media (max-width: 860px) {
		.chat-page { height: auto; min-height: calc(100dvh - var(--mobile-nav-h, 72px)); }
		:global(.app-shell-content) { padding-bottom: 0; }
	}

	@media (max-width: 720px) {
		.chat-page { padding: 0 14px; }
		.chat-empty h1 { font-size: 24px; }
	}
</style>

<style is:global>
	/* Message bubbles are built client-side by chat.ts, so this block is
	   global — Astro's scoped-CSS attribute never reaches elements created
	   after the initial render. */
	.chat-msg { display: flex; }
	.chat-msg-user { justify-content: flex-end; }
	.chat-bubble {
		max-width: 84%;
		padding: 11px 14px;
		border-radius: 16px;
		font-size: 14.5px;
		line-height: 1.55;
		white-space: pre-wrap;
	}
	.chat-msg-user .chat-bubble { background: var(--surface2); color: var(--text); border: 1px solid var(--border2); }
	.chat-msg-assistant .chat-bubble { background: var(--card); color: var(--text); border: 1px solid var(--border); }
	.chat-bubble-photo { width: 96px; height: 96px; object-fit: cover; border-radius: 10px; margin-bottom: 8px; display: block; overflow: hidden; font-size: 0; color: transparent; }
	.chat-bubble-thinking { display: flex; align-items: center; gap: 9px; color: var(--text-dimmer); }
	.chat-thinking-spinner {
		width: 15px;
		height: 15px;
		flex: 0 0 15px;
		border-radius: 50%;
		border: 2px solid var(--border3);
		border-top-color: var(--text-dim);
		animation: chat-thinking-spin 0.7s linear infinite;
	}
	@keyframes chat-thinking-spin { to { transform: rotate(360deg); } }
	.chat-bubble-streaming::after {
		content: "";
		display: inline-block;
		width: 7px;
		height: 14px;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: var(--text-dimmer);
		animation: chat-streaming-caret 0.8s ease-in-out infinite;
	}
	@keyframes chat-streaming-caret { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
	.chat-bubble-images { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px; margin-top: 10px; }
	.chat-bubble-image-wrap { position: relative; border-radius: 12px; overflow: hidden; border: 1px solid var(--border2); cursor: zoom-in; }
	.chat-bubble-image-wrap img { width: 100%; display: block; aspect-ratio: 1 / 1; object-fit: cover; overflow: hidden; font-size: 0; color: transparent; }
	.chat-bubble-image-source { cursor: default; }
	.chat-bubble-image-tag {
		position: absolute;
		left: 8px;
		bottom: 8px;
		padding: 3px 9px;
		border-radius: 999px;
		background: rgba(15, 15, 15, 0.72);
		color: #fff;
		font-size: 11px;
	}
	.chat-bubble-actions { display: flex; gap: 8px; margin-top: 8px; }
	.chat-bubble-actions button {
		height: 30px;
		padding: 0 12px;
		border-radius: 999px;
		border: 1px solid var(--border3);
		background: transparent;
		color: var(--text-dim);
		font-size: 12px;
		cursor: pointer;
		font-family: inherit;
	}
	.chat-bubble-actions button:hover { color: var(--text); background: var(--hover); }

	/* Remix/Save/Download are plain-text buttons at 30px tall on desktop,
	   sized for mouse precision — too small for the 44px touch-target
	   convention this app uses elsewhere on mobile. Bump their height and
	   let the row wrap instead of overflow, since the three labels
	   ("Remix", "Save to moodboard", "Download") don't reliably fit on one
	   line inside the 84%-wide bubble at 320-375px. */
	@media (max-width: 860px) {
		.chat-bubble-actions { flex-wrap: wrap; gap: 10px; }
		.chat-bubble-actions button {
			height: 44px;
			padding: 0 14px;
			font-size: 13px;
		}
	}

	/* Whiteboard grid — built client-side by chat.ts (renderWhiteboard), same
	   reasoning as the chat bubbles above for why this is global. */
	.whiteboard-grid {
		flex: 1;
		overflow: auto;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 12px;
		padding: 18px 20px 24px;
		align-content: start;
	}
	.whiteboard-tile {
		aspect-ratio: 1 / 1;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--border2);
		background: var(--surface2);
		padding: 0;
		cursor: zoom-in;
	}
	.whiteboard-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.whiteboard-tile:hover { border-color: var(--border3); }
	.whiteboard-empty {
		margin: auto;
		padding: 0 24px;
		text-align: center;
		font-size: 13px;
		color: var(--text-dimmer);
		max-width: 320px;
	}
</style>
