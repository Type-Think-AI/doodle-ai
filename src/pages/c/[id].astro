---
export const prerender = false;
import AppShellLayout from '../../layouts/AppShellLayout.astro';
import Lightbox from '../../components/app/Lightbox.astro';
import PromptComposer from '../../components/app/PromptComposer.astro';
import DoodleCanvas from '../../components/app/DoodleCanvas.tsx';
import '../../styles/chat-page.css';
import '../../styles/chat-bubbles.css';

// Scopes the canvas's local persistence so each conversation keeps its own
// board. Route param only — the thread's contents still live in localStorage
// and are read client-side, same as before.
const threadId = Astro.params.id ?? 'new';
---

<AppShellLayout title="Chat — Doodle AI" active="chat">
	<!-- data-whiteboard starts "true": the canvas is the point of this screen,
	     so it is shown by default rather than hidden behind a toggle. This is
	     also load-bearing — tldraw mounted inside a display:none container
	     never finishes initializing (renders its container, never calls
	     onMount, never accepts an image), so the canvas must be visible on
	     first paint. The toggle still closes/reopens it; by then the editor
	     already exists and only needs a re-measure. -->
	<div
		class="chat-split"
		id="chatSplit"
		data-whiteboard="true"
		style="--bg:#141414;--stage:#0a0a0a;--surface:#141414;--surface2:#141414;--card:#1a1a1a;--card-hover:#1f1f1f;--prompt-bg:#1c1c1e;--icon-hover:#2a2a2d;--border:#262626;--border2:#292929;--border3:#3a3a3a;--hover:#1f1f1f;--text:#dddddd;--text-dim:#999999;--text-dimmer:#8a8a8a;color:#dddddd;"
	>
		<div class="chat-page" id="chatPage" style="color:#dddddd;">
			<button type="button" class="whiteboard-toggle" id="whiteboardToggle" aria-pressed="true">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18M9 9v9" stroke="currentColor" stroke-width="1.6"/></svg>
				<span>Canvas</span>
			</button>

			<div class="chat-thread" id="chatThread">
				<div class="chat-empty" id="chatEmpty">
					<h1>What should we doodle?</h1>
					<p>Attach a photo and tell me what you want, or just describe a character for a surprise.</p>
				</div>
			</div>

			<div class="chat-composer">
				<PromptComposer id="chat" variant="compact" placeholder="Describe a doodle or attach a photo" />
			</div>
		</div>

		<!-- Draggable divider between the chat column and the board. -->
		<div
			class="chat-split-handle"
			id="chatSplitHandle"
			role="separator"
			aria-orientation="vertical"
			aria-label="Resize chat and canvas"
			tabindex="0"
		></div>

		<!-- Infinite canvas (tldraw). client:only is required: tldraw is
		     browser-only and must never enter the Worker/SSR bundle. -->
		<div class="canvas-panel" id="canvasPanel">
			<div class="canvas-stage" id="canvasStage">
				<DoodleCanvas client:only="react" threadId={threadId} />
				<div class="canvas-empty-hint" id="canvasEmptyHint">
					<p>Your doodles will appear here as you generate them.<br/>Pan, zoom, resize, draw on them — it's your infinite canvas.</p>
				</div>
				<button type="button" class="canvas-close" id="whiteboardClose" aria-label="Close canvas">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
				</button>
			</div>
		</div>
	</div>

	<Lightbox />
</AppShellLayout>

<script src="../../scripts/app/chat/index.ts"></script>
