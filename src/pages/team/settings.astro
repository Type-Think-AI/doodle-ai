---
export const prerender = false;
import AppShellLayout from '../../layouts/AppShellLayout.astro';
---

<AppShellLayout title="Team settings — Doodle AI" description="Manage your Doodle AI team workspace." active="team">
  <main class="team-settings" id="teamSettings">
    <a href="/team" class="back-link">← Team workspace</a>
    <header class="settings-heading"><div><span class="team-kicker">Workspace administration</span><h1>Manage team</h1><p>Members, permissions, invitations, and shared capacity.</p></div><button type="button" class="team-button team-button-primary" id="settingsInviteButton">Invite teammates</button></header>
    <section class="settings-card"><div class="settings-card-heading"><div><span class="team-kicker">Identity</span><h2>Team profile</h2></div></div><form id="renameTeamForm" class="rename-form"><input id="renameTeamInput" maxlength="60" /><button type="submit" class="team-button team-button-primary">Save name</button><span id="renameStatus" role="status"></span></form></section>
    <section class="settings-card" id="members"><div class="settings-card-heading"><div><span class="team-kicker">People</span><h2>Members</h2></div><span id="memberCountLabel" class="settings-muted"></span></div><div class="member-table" id="settingsMembers"><div class="team-loading">Loading members…</div></div></section>
    <section class="settings-card"><div class="settings-card-heading"><div><span class="team-kicker">Access</span><h2>Invite links</h2><p>Reusable links can be revoked at any time and never grant owner access.</p></div><button type="button" class="team-button" id="createLinkButton">Create link</button></div><div class="invite-links" id="inviteLinks"><div class="team-loading">Loading links…</div></div></section>
    <section class="settings-card"><div class="settings-card-heading"><div><span class="team-kicker">Capacity</span><h2>Credits</h2><p id="creditSummary">Loading shared balance…</p></div><a class="team-button" href="/settings?tab=billing">Billing</a></div><div class="ledger-list" id="ledgerList"><div class="team-loading">Loading ledger…</div></div></section>
  </main>
</AppShellLayout>

<script src="../../scripts/app/team-settings.ts"></script>

<style>
  .team-settings{max-width:1000px;margin:0 auto;padding:32px 44px 80px}.back-link{color:var(--text-dim);font-size:12px}.back-link:hover{color:var(--text)}.settings-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:28px 0 34px;border-bottom:1px solid var(--border)}.team-kicker{display:block;color:var(--accent);font-size:10px;font-weight:750;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px}.settings-heading h1{font-size:clamp(30px,5vw,46px);letter-spacing:-.06em;line-height:1}.settings-heading p{margin-top:10px;color:var(--text-dim);font-size:13px}.team-button{min-height:38px;display:inline-flex;align-items:center;justify-content:center;padding:0 15px;border:1px solid var(--border3);border-radius:999px;background:transparent;color:var(--text);font:inherit;font-size:12px;cursor:pointer}.team-button:hover{background:var(--hover)}.team-button-primary{border-color:var(--accent);background:var(--accent);color:var(--send-fg);font-weight:700}.settings-card{margin-top:24px;padding:22px;border:1px solid var(--border);border-radius:16px;background:var(--card)}.settings-card-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:18px}.settings-card-heading h2{font-size:19px;letter-spacing:-.04em}.settings-card-heading p{margin-top:6px;color:var(--text-dim);font-size:12px}.settings-muted{color:var(--text-dimmer);font-size:11px}.rename-form{display:flex;align-items:center;gap:9px}.rename-form input{flex:1;min-height:40px;padding:0 11px;border:1px solid var(--border2);border-radius:9px;background:var(--bg);color:var(--text);font:inherit;font-size:13px}.rename-form input:focus{outline:2px solid var(--accent)}#renameStatus{color:#62d78b;font-size:11px}.member-table{display:grid;gap:7px}.member-row{display:grid;grid-template-columns:1fr 130px 130px;align-items:center;gap:12px;padding:11px 0;border-top:1px solid var(--border);font-size:12px}.member-identity{display:flex;align-items:center;gap:9px;min-width:0}.member-avatar{width:30px;height:30px;display:grid;place-items:center;flex:0 0 30px;border-radius:50%;background:var(--accent);color:var(--send-fg);font-size:11px;font-weight:700;background-position:center;background-size:cover}.member-identity strong,.member-identity small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.member-identity small,.member-spend{margin-top:3px;color:var(--text-dimmer);font-size:10px}.member-role{justify-self:start;padding:5px 8px;border-radius:999px;background:var(--hover);color:var(--text-dim);font-size:10px}.invite-links{display:grid;gap:8px}.invite-link-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 0;border-top:1px solid var(--border);font-size:12px}.invite-link-url{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-dim)}.invite-link-actions{display:flex;align-items:center;gap:8px;flex:0 0 auto}.invite-link-actions small{color:var(--text-dimmer);font-size:10px}.mini-button{min-height:28px;padding:0 9px;border:1px solid var(--border2);border-radius:7px;background:transparent;color:var(--text-dim);font:inherit;font-size:10px;cursor:pointer}.mini-button:hover{background:var(--hover);color:var(--text)}.ledger-list{display:grid;gap:8px}.ledger-row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--border);font-size:12px}.ledger-row small{display:block;margin-top:3px;color:var(--text-dimmer);font-size:10px}.ledger-positive{color:#62d78b}.ledger-negative{color:#ff8b80}.team-loading{padding:20px;color:var(--text-dimmer);font-size:12px;border:1px dashed var(--border2);border-radius:12px}@media(max-width:700px){.team-settings{padding:24px 20px 60px}.settings-heading{align-items:flex-start;flex-direction:column}.rename-form{align-items:stretch;flex-direction:column}.rename-form .team-button{align-self:flex-start}.member-row{grid-template-columns:1fr auto}.member-spend{display:none}.invite-link-row{align-items:flex-start;flex-direction:column}.invite-link-actions{width:100%;justify-content:space-between}}
</style>
