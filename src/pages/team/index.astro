---
export const prerender = false;
import AppShellLayout from '../../layouts/AppShellLayout.astro';
---

<AppShellLayout title="Team workspace — Doodle AI" description="Your shared Doodle AI production workspace." active="team">
  <main class="team-page" id="teamPage">
    <header class="team-hero">
      <div><span class="team-kicker">Workspace</span><h1 id="teamName">Your team</h1><p id="teamMeta">Loading your shared studio…</p></div>
      <div class="team-actions"><button type="button" class="team-button team-button-primary" id="teamInviteButton">Invite teammates</button><a class="team-button" href="/team/settings">Manage team</a></div>
    </header>

    <section class="team-stat-grid" aria-label="Workspace summary">
      <article class="team-stat-card"><span>Shared credits</span><strong id="teamBalance">—</strong><small id="teamSpend">Loading monthly spend…</small></article>
      <article class="team-stat-card"><span>Projects</span><strong id="teamProjectCount">—</strong><small>Active production spaces</small></article>
      <article class="team-stat-card"><span>Members</span><strong id="teamMemberCount">—</strong><small>People in this workspace</small></article>
    </section>

    <section class="team-section"><div class="team-section-heading"><div><span class="team-kicker">Production</span><h2>Projects</h2></div><a href="/projects" class="team-muted-link">View all</a></div><div class="project-grid" id="teamProjects"><div class="team-loading">Loading projects…</div></div></section>
    <section class="team-section"><div class="team-section-heading"><div><span class="team-kicker">Capacity</span><h2>People</h2></div><a href="/team/settings#members" class="team-muted-link">Manage members</a></div><div class="member-strip" id="teamMembers"><div class="team-loading">Loading members…</div></div></section>
    <section class="team-section team-next"><div><span class="team-kicker">Next step</span><h2>Make the workspace useful immediately</h2><p>Create a project, add references, and move the first generation into review. Client links only show approved or in-review work.</p></div><a class="team-button team-button-primary" href="/projects">Open projects</a></section>
  </main>
</AppShellLayout>

<script src="../../scripts/app/team-page.ts"></script>

<style>
  .team-page { max-width: 1180px; margin: 0 auto; padding: 42px 44px 80px; }
  .team-hero { display:flex; justify-content:space-between; align-items:flex-end; gap:24px; padding-bottom:34px; border-bottom:1px solid var(--border); }
  .team-kicker { display:block; color:var(--accent); font-size:10px; font-weight:750; letter-spacing:.14em; text-transform:uppercase; margin-bottom:8px; }
  .team-hero h1 { font-size:clamp(30px,5vw,48px); line-height:1; letter-spacing:-.06em; }
  .team-hero p, .team-next p { margin-top:10px; color:var(--text-dim); font-size:13px; }
  .team-actions { display:flex; gap:9px; flex-wrap:wrap; justify-content:flex-end; }
  .team-button { min-height:38px; display:inline-flex; align-items:center; justify-content:center; padding:0 15px; border:1px solid var(--border3); border-radius:999px; background:transparent; color:var(--text); font:inherit; font-size:12px; cursor:pointer; }
  .team-button:hover { background:var(--hover); }
  .team-button-primary { border-color:var(--accent); background:var(--accent); color:var(--send-fg); font-weight:700; }
  .team-button-primary:hover { filter:brightness(1.05); background:var(--accent); }
  .team-stat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:24px; }
  .team-stat-card { padding:20px; border:1px solid var(--border); border-radius:16px; background:var(--card); }
  .team-stat-card span { color:var(--text-dim); font-size:12px; }.team-stat-card strong { display:block; margin-top:10px; font-size:28px; letter-spacing:-.04em; }.team-stat-card small { display:block; margin-top:5px; color:var(--text-dimmer); font-size:11px; }
  .team-section { margin-top:48px; }.team-section-heading { display:flex; align-items:end; justify-content:space-between; margin-bottom:16px; }.team-section h2 { font-size:22px; letter-spacing:-.04em; }.team-muted-link { color:var(--text-dim); font-size:12px; }.team-muted-link:hover { color:var(--text); }
  .project-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }.project-card { display:flex; flex-direction:column; min-height:150px; padding:18px; border:1px solid var(--border); border-radius:15px; background:var(--card); }.project-card:hover { background:var(--card-hover); border-color:var(--border3); }.project-card h3 { font-size:16px; letter-spacing:-.02em; }.project-card p { margin-top:7px; color:var(--text-dim); font-size:12px; line-height:1.45; }.project-card-footer { display:flex; justify-content:space-between; gap:10px; margin-top:auto; padding-top:20px; color:var(--text-dimmer); font-size:11px; }.project-status { color:var(--accent); }.team-loading { padding:24px; color:var(--text-dimmer); font-size:12px; border:1px dashed var(--border2); border-radius:14px; }.member-strip { display:flex; flex-wrap:wrap; gap:10px; }.member-card { min-width:190px; display:flex; align-items:center; gap:10px; padding:12px 14px; border:1px solid var(--border); border-radius:13px; background:var(--card); }.member-avatar { width:30px; height:30px; display:grid; place-items:center; border-radius:50%; background:var(--accent); color:var(--send-fg); font-size:12px; font-weight:700; }.member-card strong { display:block; font-size:12px; }.member-card small { display:block; margin-top:3px; color:var(--text-dimmer); font-size:10px; }.team-next { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:24px; border:1px solid var(--border); border-radius:16px; background:linear-gradient(120deg,var(--card),transparent); }.team-next h2 { font-size:18px; }.team-next p { max-width:600px; line-height:1.5; }
  @media(max-width:760px){.team-page{padding:26px 20px 60px}.team-hero{align-items:flex-start;flex-direction:column}.team-actions{justify-content:flex-start}.team-stat-grid{grid-template-columns:1fr}.project-grid{grid-template-columns:1fr}.team-next{align-items:flex-start;flex-direction:column}}
</style>
