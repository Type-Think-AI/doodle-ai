---
export const prerender = false;
import AppShellLayout from '../../layouts/AppShellLayout.astro';
---

<AppShellLayout title="Projects — Doodle AI" description="Shared production projects for your team." active="projects">
  <main class="projects-page" id="projectsPage">
    <header class="projects-heading"><div><span class="team-kicker">Production workspace</span><h1>Projects</h1><p>Keep briefs, references, generations, and client review in one place.</p></div><button type="button" class="team-button team-button-primary" id="newProjectButton">New project</button></header>
    <form class="new-project-form" id="newProjectForm" hidden><label><span>Project name</span><input id="newProjectName" maxlength="80" placeholder="Spring campaign concepts" /></label><label><span>Brief <em>optional</em></span><textarea id="newProjectBrief" maxlength="4000" rows="3" placeholder="What are we making and who is it for?"></textarea></label><div><button type="submit" class="team-button team-button-primary">Create project</button><button type="button" class="team-button" id="cancelProjectButton">Cancel</button></div><p id="projectFormError" class="project-error" hidden></p></form>
    <div class="projects-grid" id="projectsGrid"><div class="team-loading">Loading projects…</div></div>
  </main>
</AppShellLayout>

<script src="../../scripts/app/projects-page.ts"></script>

<style>
  .projects-page{max-width:1180px;margin:0 auto;padding:42px 44px 80px}.projects-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding-bottom:30px;border-bottom:1px solid var(--border)}.team-kicker{display:block;color:var(--accent);font-size:10px;font-weight:750;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px}.projects-heading h1{font-size:clamp(30px,5vw,46px);letter-spacing:-.06em;line-height:1}.projects-heading p{margin-top:10px;color:var(--text-dim);font-size:13px}.team-button{min-height:38px;display:inline-flex;align-items:center;justify-content:center;padding:0 15px;border:1px solid var(--border3);border-radius:999px;background:transparent;color:var(--text);font:inherit;font-size:12px;cursor:pointer}.team-button:hover{background:var(--hover)}.team-button-primary{border-color:var(--accent);background:var(--accent);color:var(--send-fg);font-weight:700}.new-project-form{display:grid;gap:14px;margin:24px 0;padding:20px;border:1px solid var(--border);border-radius:15px;background:var(--card)}.new-project-form label{display:grid;gap:7px;color:var(--text-dim);font-size:12px}.new-project-form em{color:var(--text-dimmer);font-style:normal}.new-project-form input,.new-project-form textarea{width:100%;padding:10px 12px;border:1px solid var(--border2);border-radius:9px;background:var(--bg);color:var(--text);font:inherit;font-size:13px}.new-project-form textarea{resize:vertical}.new-project-form input:focus,.new-project-form textarea:focus{outline:2px solid var(--accent);outline-offset:1px}.new-project-form>div{display:flex;gap:8px}.project-error{color:#ff7b72;font-size:12px}.projects-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:26px}.project-tile{min-height:180px;display:flex;flex-direction:column;padding:19px;border:1px solid var(--border);border-radius:16px;background:var(--card)}.project-tile:hover{border-color:var(--border3);background:var(--card-hover)}.project-tile h2{font-size:17px;letter-spacing:-.03em}.project-tile p{margin-top:8px;color:var(--text-dim);font-size:12px;line-height:1.5}.project-tile-footer{display:flex;justify-content:space-between;margin-top:auto;padding-top:20px;color:var(--text-dimmer);font-size:11px}.project-empty{grid-column:1/-1;padding:48px;text-align:center;border:1px dashed var(--border2);border-radius:15px;color:var(--text-dim);font-size:13px}.project-empty a{color:var(--accent)}@media(max-width:760px){.projects-page{padding:26px 20px 60px}.projects-heading{align-items:flex-start;flex-direction:column}.projects-grid{grid-template-columns:1fr}}
</style>
