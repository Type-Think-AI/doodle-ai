---
export const prerender = false;
import AppShellLayout from '../../layouts/AppShellLayout.astro';
const { id } = Astro.params;
---

<AppShellLayout title="Project — Doodle AI" description="Review and share a Doodle AI project." active="projects">
  <main class="project-detail" id="projectDetail" data-project-id={id}>
    <a href="/projects" class="back-link">← Projects</a>
    <header class="project-detail-heading"><div><span class="team-kicker">Project</span><h1 id="detailProjectName">Loading…</h1><p id="detailProjectBrief">Loading project details…</p></div><div class="detail-actions"><button type="button" class="team-button" id="shareProjectButton">Create review link</button><button type="button" class="team-button team-button-primary" id="addAssetButton">Add asset</button></div></header>
    <div class="review-note"><strong>Client review is intentional.</strong><span>Only work marked In review or Approved appears in a share link. PicX image URLs remain public even after a share link is revoked.</span></div>
    <section class="batch-panel"><div><span class="team-kicker">Variants</span><h2>Generate alternatives</h2><p>Create several directions and review the outputs together.</p></div><div class="batch-controls"><select id="batchSkill"><option value="normal">Doodle Avatar</option><option value="collage">Close-up collage</option><option value="full-body">Full-body collage</option><option value="surprise">Surprise</option></select><select id="batchCount"><option value="3">3 variants</option><option value="6">6 variants</option><option value="12">12 variants</option></select><button type="button" class="team-button team-button-primary" id="runBatchButton">Run batch</button></div><p id="batchStatus" class="batch-status" role="status"></p></section>
    <section class="asset-section"><div class="asset-section-heading"><div><span class="team-kicker">Deliverables</span><h2>Project assets</h2></div><div class="review-filters" id="reviewFilters"><button type="button" data-state="all" data-active="true">All</button><button type="button" data-state="draft">Draft</button><button type="button" data-state="in_review">In review</button><button type="button" data-state="approved">Approved</button></div></div><div class="asset-grid" id="assetGrid"><div class="team-loading">Loading assets…</div></div></section>
    <div class="asset-add-panel" id="assetAddPanel" hidden><label>Image URL<input id="assetUrlInput" placeholder="https://…" /></label><label>Name<input id="assetNameInput" placeholder="Hero direction" /></label><button type="button" class="team-button team-button-primary" id="saveAssetButton">Add to project</button><p id="assetError" class="project-error" hidden></p></div>
  </main>
</AppShellLayout>

<script src="../../scripts/app/project-detail.ts"></script>

<style>
  .project-detail{max-width:1180px;margin:0 auto;padding:32px 44px 80px}.back-link{color:var(--text-dim);font-size:12px}.back-link:hover{color:var(--text)}.project-detail-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:28px 0 30px;border-bottom:1px solid var(--border)}.team-kicker{display:block;color:var(--accent);font-size:10px;font-weight:750;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px}.project-detail h1{font-size:clamp(30px,5vw,48px);letter-spacing:-.06em;line-height:1}.project-detail-heading p{max-width:650px;margin-top:10px;color:var(--text-dim);font-size:13px;line-height:1.5}.detail-actions{display:flex;gap:8px;flex-wrap:wrap}.team-button{min-height:38px;display:inline-flex;align-items:center;justify-content:center;padding:0 15px;border:1px solid var(--border3);border-radius:999px;background:transparent;color:var(--text);font:inherit;font-size:12px;cursor:pointer}.team-button:hover{background:var(--hover)}.team-button-primary{border-color:var(--accent);background:var(--accent);color:var(--send-fg);font-weight:700}.review-note{display:flex;gap:8px;margin-top:22px;padding:13px 15px;border:1px solid var(--border);border-radius:12px;color:var(--text-dim);font-size:11px;line-height:1.45}.review-note strong{color:var(--text)}.asset-section{margin-top:44px}.asset-section-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:16px}.asset-section h2{font-size:22px;letter-spacing:-.04em}.review-filters{display:flex;gap:4px;flex-wrap:wrap}.review-filters button{padding:7px 10px;border:1px solid var(--border2);border-radius:999px;background:transparent;color:var(--text-dim);font:inherit;font-size:11px;cursor:pointer}.review-filters button[data-active="true"]{border-color:var(--accent);color:var(--accent);background:var(--accent-softer)}.asset-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.asset-card{position:relative;overflow:hidden;border:1px solid var(--border);border-radius:14px;background:var(--card)}.asset-card img{width:100%;aspect-ratio:1/1;display:block;object-fit:cover;background:var(--surface2)}.asset-card-body{padding:11px}.asset-card-body strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.asset-card-body small{display:block;margin-top:5px;color:var(--text-dimmer);font-size:10px}.asset-card-controls{display:flex;gap:5px;padding:0 11px 11px}.asset-card-controls button{flex:1;min-height:28px;padding:0 5px;border:1px solid var(--border2);border-radius:7px;background:transparent;color:var(--text-dim);font:inherit;font-size:10px;cursor:pointer}.asset-card-controls button:hover{background:var(--hover);color:var(--text)}.asset-state{position:absolute;top:8px;left:8px;padding:4px 7px;border-radius:999px;background:rgba(10,10,10,.75);color:#fff;font-size:9px}.asset-add-panel{display:grid;grid-template-columns:1fr 1fr auto;align-items:end;gap:10px;margin-top:20px;padding:16px;border:1px solid var(--border);border-radius:13px;background:var(--card)}.asset-add-panel label{display:grid;gap:6px;color:var(--text-dim);font-size:11px}.asset-add-panel input{min-height:36px;padding:0 9px;border:1px solid var(--border2);border-radius:8px;background:var(--bg);color:var(--text);font:inherit;font-size:12px}.project-error{grid-column:1/-1;color:#ff7b72;font-size:11px}.team-loading{padding:24px;color:var(--text-dimmer);font-size:12px;border:1px dashed var(--border2);border-radius:14px;grid-column:1/-1}@media(max-width:800px){.project-detail{padding:24px 20px 60px}.project-detail-heading{align-items:flex-start;flex-direction:column}.asset-grid{grid-template-columns:repeat(2,1fr)}.asset-add-panel{grid-template-columns:1fr}.asset-section-heading{align-items:flex-start;flex-direction:column}}
</style>
<style>
  .batch-panel{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:28px;padding:18px 20px;border:1px solid var(--border);border-radius:15px;background:var(--card)}.batch-panel h2{font-size:17px;letter-spacing:-.03em}.batch-panel p{margin-top:6px;color:var(--text-dim);font-size:12px}.batch-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.batch-controls select{min-height:36px;padding:0 9px;border:1px solid var(--border2);border-radius:8px;background:var(--bg);color:var(--text);font:inherit;font-size:11px}.batch-status{min-height:1em;color:var(--accent)!important}@media(max-width:800px){.batch-panel{align-items:flex-start;flex-direction:column}.batch-controls{justify-content:flex-start}}
</style>
