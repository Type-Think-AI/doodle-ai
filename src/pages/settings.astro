---
import AppLayout from '../layouts/AppLayout.astro';
import AuthDialog from '../components/app/AuthDialog.astro';
import UpgradeContactDialog from '../components/app/UpgradeContactDialog.astro';
import { THEMES } from '../lib/doodle-constants';
import { SIGNUP_GRANT_CREDITS } from '../lib/credits/costs';

const settingsTabs = [
  {
    id: 'general',
    label: 'General',
    description: 'Profile and preferences',
    icon: '<path d="M4.5 8.5 12 4l7.5 4.5v7L12 20l-7.5-4.5v-7Z"/><path d="m4.8 8.7 7.2 4.1 7.2-4.1M12 12.8V20"/>',
  },
  {
    id: 'subscription',
    label: 'Subscription',
    description: 'Plan and credits',
    icon: '<circle cx="12" cy="12" r="8.2"/><path d="M12 3.8v8.4h8.2"/>',
  },
  {
    id: 'connectors',
    label: 'Connectors',
    description: 'Provider connections',
    icon: '<circle cx="7" cy="7" r="2"/><circle cx="17" cy="17" r="2"/><circle cx="17" cy="7" r="2"/><path d="m8.5 8.5 7 7M9 7h6"/>',
  },
  {
    id: 'billing',
    label: 'Billing',
    description: 'Credit packs',
    icon: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M3.5 9.5h17M7 14h3"/>',
  },
];
---

<AppLayout title="Settings — Doodle AI">
  <div class="settings-shell" id="settingsRoot">
    <header class="settings-topbar">
      <a class="settings-back" href="/" aria-label="Back to Doodle AI">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
        <span class="settings-brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2.5 15c1.5-6.5 3-9.5 4.8-9.5S9 10 11 10s2-6 4.3-6 2.6 6.8 4.2 6.8 1.5-2.3 3-2.3"/></svg></span>
        <span class="settings-brand-name">Doodle AI</span>
      </a>
    </header>

    <div class="settings-frame">
      <aside class="settings-rail" aria-label="Settings sections">
        <h1>Settings</h1>
        <nav class="settings-tabs" role="tablist" aria-label="Settings sections">
          {settingsTabs.map((tab, index) => (
            <button
              type="button"
              class="settings-tab"
              data-settings-tab={tab.id}
              id={`settings-tab-${tab.id}`}
              role="tab"
              aria-controls={`settings-panel-${tab.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={tab.icon}></svg>
              <span><strong>{tab.label}</strong><small>{tab.description}</small></span>
            </button>
          ))}
        </nav>
      </aside>

      <main class="settings-main">
        <div class="settings-mobile-heading"><span>Settings</span><span class="settings-mobile-rule" aria-hidden="true"></span></div>

        <section class="settings-panel" id="settings-panel-general" data-settings-panel="general" role="tabpanel" aria-labelledby="settings-tab-general">
          <button class="settings-panel-toggle" type="button" data-settings-toggle="general" aria-expanded="true">
            <span><b>General</b><small>Profile and preferences</small></span><span aria-hidden="true">⌄</span>
          </button>
          <div class="settings-panel-body">
            <div class="settings-section-heading"><span class="settings-kicker">Workspace</span><h2>General</h2><p>Make Doodle AI feel like your creative space.</p></div>

            <div class="profile-section" id="settingsProfileCard">
              <div class="profile-heading">
                <div class="profile-identity"><div class="profile-avatar" id="settingsProfileAvatar" aria-hidden="true">?</div><div><h3 id="settingsProfileName">Your profile</h3><p id="settingsProfileEmail">Sign in to sync your profile</p></div></div>
                <button type="button" class="settings-outline-button" id="settingsAvatarButton">Change avatar</button>
                <input type="file" id="settingsAvatarInput" accept="image/*" hidden />
              </div>
              <div class="settings-form-grid">
                <label class="settings-field" for="settingsFullName"><span>Full name</span><input id="settingsFullName" type="text" autocomplete="name" placeholder="Your name" /></label>
                <label class="settings-field" for="settingsNickname"><span>What should Doodle AI call you?</span><input id="settingsNickname" type="text" autocomplete="nickname" placeholder="e.g. Yash" /></label>
              </div>
              <label class="settings-field" for="settingsPreferences"><span>Personal preferences for responses</span><textarea id="settingsPreferences" maxlength="1000" rows="4" placeholder="e.g. I prefer concise responses, simple language…"></textarea></label>
              <div class="settings-form-footer"><span id="settingsPreferencesCount">0/1000</span><div><span class="settings-save-status" id="settingsSaveStatus" role="status" aria-live="polite"></span><button type="button" class="settings-primary-button" id="settingsSaveProfile">Save changes</button></div></div>
            </div>
            <div class="settings-signin-row" id="settingsSignInCard" hidden><div><strong>Sign in to manage your profile</strong><p>Your account details and saved preferences sync across devices.</p></div><button type="button" class="settings-outline-button" id="settingsProfileSignIn">Sign in</button></div>

            <div class="settings-subsection"><div><h3>Appearance</h3><p>Choose the interface theme for this browser.</p></div><div class="appearance-row" id="appearanceRow" role="radiogroup" aria-label="Theme"><button type="button" class="appearance-card" data-theme-opt="dark" aria-pressed="false"><span class="appearance-swatch appearance-swatch-dark"><i></i><i></i></span><span>Dark</span></button><button type="button" class="appearance-card" data-theme-opt="light" aria-pressed="false"><span class="appearance-swatch appearance-swatch-light"><i></i><i></i></span><span>Light</span></button></div></div>
            <div class="settings-subsection settings-subsection-last"><div><h3>Doodle defaults</h3><p>Used by Doodle Avatar and Surprise Me.</p></div><label class="settings-select-field" for="styleThemeSelect"><span>Visual style</span><select id="styleThemeSelect">{THEMES.map((theme) => <option value={theme.id}>{theme.label}</option>)}</select></label></div>
          </div>
        </section>

        <section class="settings-panel" id="settings-panel-subscription" data-settings-panel="subscription" role="tabpanel" aria-labelledby="settings-tab-subscription" hidden>
          <button class="settings-panel-toggle" type="button" data-settings-toggle="subscription" aria-expanded="false"><span><b>Subscription</b><small>Plan and credits</small></span><span aria-hidden="true">⌄</span></button>
          <div class="settings-panel-body">
            <div class="subscription-heading"><div><span class="settings-kicker">Current plan</span><h2>Free</h2></div><button class="upgrade-button" type="button" id="settingsUpgradeButton">Upgrade</button></div>
            <div class="credit-hero">
              <div class="credit-total"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="8" width="26" height="16" rx="4"/><path d="M9 16h7M12.5 12.5 16 16l-3.5 3.5"/></svg><strong id="settingsCreditBalance">{SIGNUP_GRANT_CREDITS}</strong><span>Credits left</span><button type="button" class="help-icon" aria-label="Credits are used for generations">?</button></div>
              <div class="credit-message"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"/></svg><span>Upgrade to get the capacity that exactly matches your needs.</span></div>
            </div>
            <div class="usage-heading"><h3>Usage</h3><div class="range-switcher" role="group" aria-label="Usage range"><button type="button" data-usage-range="day" aria-pressed="true">Day</button><button type="button" data-usage-range="week" aria-pressed="false">Week</button><button type="button" data-usage-range="month" aria-pressed="false">Month</button><button type="button" data-usage-range="year" aria-pressed="false">Year</button></div></div>
            <div class="usage-chart" role="img" aria-label="Sample daily credit usage chart"><div class="chart-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="chart-bars"><div class="chart-bar" style="--bar-height: 0%"><span></span><small>Aug 3</small></div><div class="chart-bar" style="--bar-height: 0%"><span></span><small>Aug 5</small></div><div class="chart-bar" style="--bar-height: 0%"><span></span><small>Aug 7</small></div><div class="chart-bar" style="--bar-height: 0%"><span></span><small>Aug 11</small></div><div class="chart-bar" style="--bar-height: 0%"><span></span><small>Aug 15</small></div><div class="chart-bar" style="--bar-height: 0%"><span></span><small>Aug 19</small></div><div class="chart-bar chart-bar-active" style="--bar-height: 26%"><span></span><small>Aug 23</small></div></div></div>
            <p class="usage-note">Sample usage data — live credit analytics will appear here.</p>
            <div class="history-section"><h3>Credits history</h3><div class="history-empty"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12M6 8h12M6 12h8M6 16h10M6 20h7"/></svg><span>No credit activity yet</span></div></div>
            <p class="upgrade-status" id="settingsUpgradeStatus" role="status" aria-live="polite"></p>
          </div>
        </section>

        <section class="settings-panel" id="settings-panel-connectors" data-settings-panel="connectors" role="tabpanel" aria-labelledby="settings-tab-connectors" hidden>
          <button class="settings-panel-toggle" type="button" data-settings-toggle="connectors" aria-expanded="false"><span><b>Connectors</b><small>Provider connections</small></span><span aria-hidden="true">⌄</span></button>
          <div class="settings-panel-body"><div class="settings-section-heading"><span class="settings-kicker">Infrastructure</span><h2>Connectors</h2><p>Doodle AI manages the provider connections used by your workspace.</p></div><div class="flat-list"><div class="flat-list-row"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 16 0"/><path d="M7 12a5 5 0 0 1 10 0"/><circle cx="12" cy="15" r="2"/></svg><div><strong>PicX image generation</strong><p>Server-owned connection for uploads and account-credit generations.</p></div><span class="connected-status">Connected</span></div><div class="flat-list-row"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="7" r="2"/><circle cx="17" cy="17" r="2"/><path d="m8.5 8.5 7 7"/></svg><div><strong>OpenRouter agent routing</strong><p>Routes the conversational assistant that helps choose a skill.</p></div><span class="connected-status">Connected</span></div></div><div class="settings-note"><strong>Your credentials stay protected.</strong><span>Provider credentials are never entered into or stored in your browser.</span></div></div>
        </section>

        <section class="settings-panel" id="settings-panel-billing" data-settings-panel="billing" role="tabpanel" aria-labelledby="settings-tab-billing" hidden>
          <button class="settings-panel-toggle" type="button" data-settings-toggle="billing" aria-expanded="false"><span><b>Billing</b><small>Credit packs</small></span><span aria-hidden="true">⌄</span></button>
          <div class="settings-panel-body"><div class="settings-section-heading"><span class="settings-kicker">Credits</span><h2>Billing</h2><p>Buy more creative time when you need it.</p></div><div class="flat-list billing-list"><div class="billing-row"><div><strong>Starter</strong><span>25 credits · For a few experiments</span></div><button type="button" data-upgrade-pack="Starter · 25 credits">Get credits</button></div><div class="billing-row billing-row-featured"><div><strong>Creator</strong><span>100 credits · For a full creative session</span></div><button type="button" data-upgrade-pack="Creator · 100 credits">Get credits</button></div><div class="billing-row"><div><strong>Studio</strong><span>250 credits · For frequent making</span></div><button type="button" data-upgrade-pack="Studio · 250 credits">Get credits</button></div></div><div class="history-section"><h3>Recent transactions</h3><div class="history-empty"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12M6 8h12M6 12h8M6 16h10M6 20h7"/></svg><span>No transactions yet</span></div></div></div>
        </section>
      </main>
    </div>
  </div>
  <AuthDialog />
  <UpgradeContactDialog />
</AppLayout>

<script src="../scripts/app/settings.ts"></script>

<style>
  .settings-shell { min-height: 100dvh; background: var(--bg); color: var(--text); }
  .settings-topbar { height: 68px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; }
  .settings-back { display: inline-flex; align-items: center; gap: 10px; color: var(--text); }
  .settings-back > svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .settings-brand-mark { width: 28px; height: 28px; display: grid; place-items: center; }
  .settings-brand-mark svg { width: 24px; height: 24px; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .settings-brand-name { font-weight: 650; letter-spacing: -.02em; }
  .settings-frame { display: grid; grid-template-columns: 276px minmax(0, 1fr); min-height: calc(100dvh - 68px); }
  .settings-rail { padding: 38px 20px 48px 28px; }
  .settings-rail h1 { margin: 0 0 24px; font-size: 23px; letter-spacing: -.04em; }
  .settings-tabs { display: flex; flex-direction: column; gap: 3px; }
  .settings-tab { width: 100%; min-height: 45px; display: flex; align-items: center; gap: 12px; padding: 8px 14px; border: 0; border-radius: 9px; color: var(--text-dim); background: transparent; text-align: left; font: inherit; cursor: pointer; }
  .settings-tab:hover { color: var(--text); background: var(--hover); }
  .settings-tab[aria-selected="true"] { color: var(--text); background: var(--hover); }
  .settings-tab svg { width: 19px; height: 19px; flex: 0 0 19px; fill: none; stroke: currentColor; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }
  .settings-tab[aria-selected="true"] svg { color: var(--accent); }
  .settings-tab span { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .settings-tab strong { font-size: 13.5px; font-weight: 550; }
  .settings-tab small { color: var(--text-dimmer); font-size: 10.5px; line-height: 1.2; }
  .settings-main { width: min(1140px, 100%); padding: 46px 64px 80px 54px; }
  .settings-mobile-heading { display: none; }
  .settings-panel[hidden] { display: none; }
  .settings-panel-body { display: flex; flex-direction: column; }
  .settings-panel-toggle { display: none; }
  .settings-section-heading { margin-bottom: 30px; }
  .settings-kicker { display: block; color: var(--accent); font-size: 10px; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 8px; }
  .settings-section-heading h2, .subscription-heading h2 { margin: 0; font-size: clamp(26px, 3vw, 36px); letter-spacing: -.055em; line-height: 1; }
  .settings-section-heading p { margin: 9px 0 0; color: var(--text-dim); font-size: 13px; }
  .profile-section { padding: 0 0 30px; border-bottom: 1px solid var(--border); }
  .profile-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 26px; }
  .profile-identity { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .profile-avatar { width: 58px; height: 58px; display: grid; place-items: center; flex: 0 0 58px; border-radius: 50%; background: var(--accent); background-position: center; background-size: cover; color: var(--send-fg); font-size: 21px; font-weight: 700; }
  .profile-identity h3 { margin: 0; font-size: 18px; letter-spacing: -.03em; }
  .profile-identity p { margin: 5px 0 0; color: var(--text-dim); font-size: 12px; }
  .settings-outline-button, .settings-primary-button, .upgrade-button { min-height: 36px; padding: 0 16px; border-radius: 999px; font: inherit; font-size: 12px; cursor: pointer; }
  .settings-outline-button { border: 1px solid var(--border3); background: transparent; color: var(--text); }
  .settings-outline-button:hover { background: var(--hover); }
  .settings-outline-button:disabled { cursor: default; opacity: .5; }
  .settings-primary-button, .upgrade-button { border: 1px solid var(--text); background: var(--text); color: var(--bg); font-weight: 700; }
  .settings-primary-button:hover, .upgrade-button:hover { background: var(--accent); border-color: var(--accent); color: var(--send-fg); }
  .settings-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 18px; }
  .settings-field { display: flex; flex-direction: column; gap: 8px; color: var(--text-dim); font-size: 12px; }
  .settings-field input, .settings-field textarea, .settings-select-field select { width: 100%; box-sizing: border-box; border: 1px solid var(--border2); border-radius: 7px; background: transparent; color: var(--text); padding: 11px 12px; outline: none; font: inherit; }
  .settings-field input { height: 40px; } .settings-field textarea { min-height: 92px; resize: vertical; line-height: 1.5; }
  .settings-field input:focus, .settings-field textarea:focus, .settings-select-field select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-softer); }
  .settings-form-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 10px; color: var(--text-dimmer); font-size: 10.5px; }
  .settings-form-footer > div { display: flex; align-items: center; gap: 12px; } .settings-save-status { color: #62d78b; min-height: 1em; }
  .settings-signin-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .settings-signin-row p { margin: 5px 0 0; color: var(--text-dim); font-size: 12px; }
  .settings-subsection { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 25px 0; border-bottom: 1px solid var(--border); }
  .settings-subsection > div:first-child { flex: 1; min-width: 0; }
  .settings-subsection-last { border-bottom: 0; padding-bottom: 40px; }
  .settings-subsection h3, .usage-heading h3, .history-section h3 { margin: 0; font-size: 15px; letter-spacing: -.02em; } .settings-subsection p { margin: 5px 0 0; color: var(--text-dim); font-size: 12px; }
  .appearance-row { display: flex; gap: 15px; } .appearance-card { display: flex; flex-direction: column; align-items: center; gap: 6px; border: 0; background: transparent; color: var(--text-dim); font: inherit; font-size: 11px; cursor: pointer; }
  .appearance-swatch { width: 78px; height: 45px; display: flex; flex-direction: column; gap: 5px; padding: 9px; border: 2px solid var(--border2); border-radius: 7px; } .appearance-card[aria-pressed="true"] .appearance-swatch { border-color: var(--accent); }
  .appearance-swatch i { display: block; width: 62%; height: 5px; border-radius: 4px; background: #444; } .appearance-swatch i + i { width: 40%; } .appearance-swatch-light { background: #fff; } .appearance-swatch-light i { background: #ccc; }
  .appearance-card[aria-pressed="true"] { color: var(--text); }
  .settings-select-field { display: flex; align-items: center; gap: 14px; color: var(--text-dim); font-size: 12px; flex-shrink: 0; } .settings-select-field select { width: 170px; height: 38px; appearance: auto; background: var(--surface2, transparent); }
  .subscription-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .credit-hero { padding: 28px 34px; border: 1px solid var(--border); border-radius: 22px; margin-bottom: 8px; }
  .credit-total { display: flex; align-items: center; gap: 13px; } .credit-total svg { width: 31px; height: 31px; fill: none; stroke: var(--text); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .credit-total strong { font-size: 29px; letter-spacing: -.04em; } .credit-total > span { color: var(--text-dim); font-size: 13px; } .help-icon { width: 17px; height: 17px; padding: 0; border: 1px solid var(--text-dimmer); border-radius: 50%; color: var(--text-dim); background: transparent; font-size: 10px; cursor: help; }
  .credit-message { display: flex; align-items: center; gap: 12px; margin-top: 24px; color: var(--text-dim); font-size: 13px; } .credit-message svg { width: 20px; height: 20px; fill: none; stroke: var(--text-dim); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .usage-heading { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 56px; margin-bottom: 28px; } .range-switcher { display: flex; align-items: center; gap: 2px; padding: 3px; border-radius: 999px; background: var(--hover); }
  .range-switcher button { min-width: 54px; height: 30px; padding: 0 10px; border: 1px solid transparent; border-radius: 999px; color: var(--text-dim); background: transparent; font: inherit; font-size: 11px; cursor: pointer; } .range-switcher button[aria-pressed="true"] { border-color: var(--border3); color: var(--text); background: var(--surface2); }
  .usage-chart { position: relative; height: 290px; margin-bottom: 28px; } .chart-lines { position: absolute; inset: 0 0 35px; display: flex; flex-direction: column; justify-content: space-between; } .chart-lines i { display: block; border-top: 1px dashed var(--border); }
  .chart-bars { position: absolute; inset: 0 0 0; display: flex; align-items: flex-end; justify-content: space-around; gap: 8px; padding: 0 32px; } .chart-bar { position: relative; width: 28px; height: 100%; display: flex; align-items: flex-end; justify-content: center; } .chart-bar span { width: 16px; height: var(--bar-height); min-height: 2px; border-radius: 4px 4px 0 0; background: var(--blue); opacity: .85; } .chart-bar small { position: absolute; bottom: 0; transform: translateY(22px); color: var(--text-dimmer); font-size: 10px; white-space: nowrap; } .chart-bar-active span { background: #8bb6f4; }
  .usage-note { color: var(--text-dimmer); font-size: 11px; } .history-section { margin-top: 58px; padding-top: 24px; border-top: 1px solid var(--border); } .history-empty { display: flex; align-items: center; gap: 10px; margin-top: 20px; color: var(--text-dimmer); font-size: 12px; } .history-empty svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; } .upgrade-status { min-height: 17px; margin-top: 18px; color: var(--accent); font-size: 11px; }
  .flat-list { border-top: 1px solid var(--border); } .flat-list-row, .billing-row { display: flex; align-items: center; gap: 14px; min-height: 76px; padding: 14px 0; border-bottom: 1px solid var(--border); } .flat-list-row > svg { width: 22px; height: 22px; flex: 0 0 22px; fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; } .flat-list-row > div { flex: 1; } .flat-list-row strong, .billing-row strong { display: block; font-size: 13px; } .flat-list-row p, .billing-row span { margin-top: 5px; color: var(--text-dim); font-size: 12px; } .connected-status { color: #62d78b; font-size: 11px; }
  .settings-note { display: flex; flex-direction: column; gap: 5px; margin-top: 24px; padding: 16px 0; color: var(--text); font-size: 12px; } .settings-note span { color: var(--text-dim); }
  .billing-row > div { flex: 1; } .billing-row button { height: 32px; padding: 0 13px; border: 1px solid var(--border2); border-radius: 999px; color: var(--text); background: transparent; font: inherit; font-size: 11px; cursor: pointer; } .billing-row button:hover { border-color: var(--text); background: var(--hover); } .billing-row button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; } .billing-row-featured strong { color: var(--accent); } .billing-row-featured button { border-color: var(--accent-soft, var(--border2)); color: var(--accent); }
  @media (max-width: 900px) { .settings-frame { grid-template-columns: 220px minmax(0, 1fr); } .settings-main { padding: 40px 30px 70px; } .settings-tab small { display: none; } }
  @media (max-width: 700px) {
    .settings-topbar { height: 60px; padding: 0 18px; } .settings-brand-name { font-size: 14px; } .settings-frame { display: block; min-height: calc(100dvh - 60px); } .settings-rail { display: none; } .settings-main { width: auto; padding: 0 18px 60px; }
