---
/**
 * Public page for one skill: /skills/<generation-mode-id>/
 *
 * These pages are the app's main indexable content (see the note in
 * src/pages/sitemap.xml.ts), so each one has to stand on its own rather than
 * restate the marketplace card. The layout is deliberately built around
 * *looking* at the skill rather than reading about it:
 *
 *   1. A large sample of real output as the hero, with the input photo inset
 *      over it when we have one — likeness is what people actually judge these
 *      tools on, and a before/after shown in one frame makes that judgeable at
 *      a glance instead of requiring a scroll.
 *   2. The full SKILL.md body inside its own scrollable file card, so the exact
 *      instructions the agent reads are explorable without the document
 *      hijacking the page's own flow. Headings inside it are demoted by
 *      rehypeDemoteSkillHeadings so the page keeps a single <h1>.
 *   3. A horizontal rail of *every* other skill, so a visitor can hop
 *      skill→skill without going back to the index — and so each skill page
 *      links to all the others rather than a chosen four.
 */
import { getCollection, render } from 'astro:content';
import AppShellLayout from '../../layouts/AppShellLayout.astro';
import SkillCard from '../../components/app/SkillCard.astro';
import { SKILLS, buildSkillThumbnail, relatedSkills } from '../../lib/skills';

export async function getStaticPaths() {
	const docs = await getCollection('skillDocs');
	return SKILLS.map((skill) => ({
		params: { id: skill.id },
		props: { skill, doc: docs.find((entry) => entry.id === skill.packageName) },
	}));
}

const { skill, doc } = Astro.props;
const thumb = buildSkillThumbnail(skill);
// Nearest-first, but every sibling: the rail scrolls, so there is no reason to
// truncate the internal linking to four.
const others = relatedSkills(skill, SKILLS.length);

// The SKILL.md body. A skill without a doc entry still renders the rest of the
// page rather than failing the build — the loader already guarantees the file
// exists, so this only guards against the collection id drifting.
const Body = doc ? (await render(doc)).Content : null;

const site = Astro.site?.origin ?? 'https://doodleai.art';
const canonical = `${site}/skills/${skill.id}/`;
const heroImage = skill.thumbnailUrl;

const specs: { label: string; value: string }[] = [
	{ label: 'Your photo', value: skill.requiresPhoto ? 'Required' : 'Not needed' },
	{ label: 'Output', value: skill.aspectRatio === '1:1' ? 'Square 1:1' : 'Landscape 3:2' },
	{ label: 'Category', value: skill.category },
	{ label: 'Cost', value: '1 credit' },
];

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Skills', item: `${site}/skills/` },
		{ '@type': 'ListItem', position: 2, name: skill.name },
	],
};

// SoftwareApplication rather than HowTo: this page describes a tool, and the
// step markup a HowTo needs would have to be invented. Only fields the page
// genuinely shows are included, and no aggregateRating is claimed.
const appSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: `${skill.name} — Doodle AI`,
	applicationCategory: 'DesignApplication',
	operatingSystem: 'Web',
	url: canonical,
	description: skill.longDesc,
	...(heroImage ? { image: heroImage } : {}),
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'Free credits on signup' },
};
---

<AppShellLayout
	title={`${skill.name} — Doodle AI`}
	description={skill.longDesc}
	image={heroImage}
	active="skills"
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />

	<div class="sk">
		<nav class="sk-crumbs" aria-label="Breadcrumb">
			<ol>
				<li>
					<a href="/skills">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
						Skills
					</a>
				</li>
				<li aria-hidden="true">/</li>
				<li><span aria-current="page">{skill.name}</span></li>
			</ol>
		</nav>

		<div class="sk-hero">
			<figure class="sk-shot">
				<div class="sk-shot-frame">
					{skill.thumbnailUrl ? (
						<img
							src={skill.thumbnailUrl}
							alt={`${skill.name} example output generated by Doodle AI`}
							loading="eager"
						/>
					) : (
						<Fragment set:html={thumb} />
					)}

					{skill.sourceImageUrl && (
						<div class="sk-shot-from">
							<img
								src={skill.sourceImageUrl}
								alt={`The photo used as input for ${skill.name}`}
								width="128"
								height="128"
								loading="lazy"
							/>
							<span>from this photo</span>
						</div>
					)}

					{!skill.runnable && <span class="sk-shot-flag">Roadmap</span>}
				</div>
				<figcaption>
					{skill.thumbnailUrl
						? 'A real run of this skill. The input is a synthetic portrait, not a customer photo.'
						: 'Preview artwork — this skill has no sample output yet.'}
				</figcaption>
			</figure>

			<div class="sk-intro">
				<div class="sk-id">
					<span class="sk-icon">
						{skill.thumbnailUrl
							? <img src={skill.thumbnailUrl} alt="" width="44" height="44" loading="eager" />
							: <Fragment set:html={thumb} />}
					</span>
					<span class={`sk-status ${skill.runnable ? 'is-live' : 'is-soon'}`}>
						{skill.runnable ? 'Ready to use' : 'Coming soon'}
					</span>
				</div>

				<h1>{skill.name}</h1>
				<p class="sk-tagline">{skill.tagline}</p>

				{skill.runnable ? (
					<a class="sk-cta" href={`/?skill=${skill.id}`}>Use this skill</a>
				) : (
					<span class="sk-cta is-disabled" aria-disabled="true">Not available yet</span>
				)}

				<dl class="sk-spec">
					{specs.map((spec) => (
						<div>
							<dt>{spec.label}</dt>
							<dd>{spec.value}</dd>
						</div>
					))}
				</dl>

				<ul class="sk-tags">
					{skill.tags.map((tag) => <li>{tag}</li>)}
				</ul>
			</div>
		</div>

		<section class="sk-block">
			<div class="sk-block-head"><h2>What it does</h2></div>
			<div class="sk-duo">
				<article class="sk-note">
					<h3>What you get back</h3>
					<p>{skill.longDesc}</p>
				</article>
				<article class="sk-note">
					<h3>When the agent picks it</h3>
					<p>{skill.description}</p>
				</article>
			</div>
		</section>

		{Body && (
			<section class="sk-block">
				<div class="sk-block-head">
					<h2>The full skill file</h2>
					<p class="sk-hint">Every skill is one <code>SKILL.md</code> — this is the exact file the agent reads.</p>
				</div>
				<div class="sk-doc">
					<div class="sk-doc-bar">
						<span class="sk-doc-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<code>src/mastra/skills/{skill.packageName}/SKILL.md</code>
					</div>
					<div class="sk-doc-body" tabindex="0" role="region" aria-label={`${skill.name} SKILL.md contents`}>
						<Body />
					</div>
				</div>
			</section>
		)}

		{others.length > 0 && (
			<section class="sk-block">
				<div class="sk-block-head">
					<h2>More skills</h2>
					<a class="sk-all" href="/skills">Browse all {SKILLS.length} <span aria-hidden="true">→</span></a>
				</div>
				<ul class="sk-rail">
					{others.map((other) => (
						<li><SkillCard skill={other} /></li>
					))}
				</ul>
			</section>
		)}
	</div>
</AppShellLayout>

<style>
	.sk { max-width: 1060px; margin: 0 auto; padding: 22px 40px 72px; }

	/* Breadcrumb */
	.sk-crumbs { margin-bottom: 22px; }
	.sk-crumbs ol { list-style: none; display: flex; align-items: center; gap: 8px; margin: 0; padding: 0; font-size: 13.5px; }
	.sk-crumbs li { color: var(--text-dimmer); }
	.sk-crumbs a { display: inline-flex; align-items: center; gap: 6px; color: var(--text-dim); text-decoration: none; font-weight: 500; }
	.sk-crumbs a:hover { color: var(--text); }
	.sk-crumbs span { color: var(--text); font-weight: 500; }

	/* ---- Hero: big sample beside the identity/spec column ---- */
	.sk-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr); gap: 30px; align-items: start; }

	.sk-shot { margin: 0; display: flex; flex-direction: column; gap: 10px; }
	.sk-shot-frame {
		position: relative;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid var(--border2);
		background: var(--surface2);
		line-height: 0;
	}
	/* The frame follows the sample's own ratio rather than forcing a square.
	   Sample outputs are not all 1:1 (a skill's declared aspectRatio describes
	   what it generates, not what the recorded thumbnail happens to be), and
	   cropping a doodle cuts off the lettering that makes it readable. */
	.sk-shot-frame img { width: 100%; height: auto; display: block; }
	/* The synthetic SVG preview has no intrinsic size, so it needs a box. */
	.sk-shot-frame :global(svg) { width: 100%; height: auto; aspect-ratio: 1 / 1; display: block; }
	.sk-shot figcaption { font-size: 12px; line-height: 1.55; color: var(--text-dimmer); }

	/* Input photo inset over the output, so before/after reads in one frame.
	   Anchored top-left: these outputs are greeting-card compositions whose
	   hand-lettering sits along the bottom edge, and the roadmap flag owns the
	   top-right corner. */
	.sk-shot-from {
		position: absolute;
		left: 12px;
		top: 12px;
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 7px 13px 7px 7px;
		border-radius: 999px;
		background: rgba(12, 12, 12, 0.76);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.14);
		max-width: calc(100% - 24px);
	}
	.sk-shot-from img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; flex: 0 0 34px; }
	.sk-shot-from span { font-size: 11.5px; color: rgba(255, 255, 255, 0.86); white-space: nowrap; }

	.sk-shot-flag {
		position: absolute;
		right: 12px;
		top: 12px;
		padding: 4px 11px;
		border-radius: 999px;
		background: rgba(12, 12, 12, 0.76);
		border: 1px solid rgba(255, 255, 255, 0.14);
		color: rgba(255, 255, 255, 0.86);
		font-size: 11.5px;
	}

	/* Identity column */
	.sk-intro { display: flex; flex-direction: column; align-items: flex-start; padding-top: 2px; }
	.sk-id { display: flex; align-items: center; gap: 11px; margin-bottom: 15px; }
	.sk-icon { width: 44px; height: 44px; flex: 0 0 44px; border-radius: 13px; overflow: hidden; border: 1px solid var(--border2); }
	.sk-icon img, .sk-icon :global(svg) { width: 100%; height: 100%; display: block; object-fit: cover; }
	.sk-status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		border-radius: 999px;
		font-size: 12px;
		border: 1px solid var(--border2);
		color: var(--text-dim);
	}
	.sk-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
	.sk-status.is-live { color: var(--accent); border-color: var(--accent-softer); background: var(--accent-softer); }

	.sk h1 { font-size: 32px; font-weight: 600; letter-spacing: -0.025em; color: var(--text); margin: 0 0 8px; line-height: 1.15; }
	.sk-tagline { font-size: 15.5px; line-height: 1.6; color: var(--text-dim); margin: 0 0 22px; }

	.sk-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 26px;
		border-radius: 999px;
		background: var(--send-bg);
		color: var(--send-fg);
		font-size: 14.5px;
		font-weight: 600;
		text-decoration: none;
		margin-bottom: 24px;
	}
	.sk-cta:hover { filter: brightness(1.06); }
	.sk-cta.is-disabled { background: var(--surface2); color: var(--text-dimmer); border: 1px solid var(--border2); }

	/* Spec card — flat rows separated by thin rules, not a stack of panels. */
	.sk-spec {
		width: 100%;
		margin: 0 0 18px;
		border: 1px solid var(--border2);
		border-radius: 14px;
		overflow: hidden;
		background: var(--surface);
	}
	.sk-spec > div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 11px 16px;
		border-bottom: 1px solid var(--border2);
	}
	.sk-spec > div:last-child { border-bottom: 0; }
	.sk-spec dt { font-size: 13px; color: var(--text-dimmer); }
	.sk-spec dd { margin: 0; font-size: 13px; color: var(--text); font-weight: 500; text-transform: capitalize; }

	.sk-tags { display: flex; flex-wrap: wrap; gap: 7px; list-style: none; margin: 0; padding: 0; }
	.sk-tags li { padding: 5px 11px; border-radius: 999px; border: 1px solid var(--border2); font-size: 12px; color: var(--text-dim); }

	/* ---- Blocks ---- */
	.sk-block { margin-top: 46px; }
	.sk-block-head { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
	.sk-block-head h2 { font-size: 18px; font-weight: 600; color: var(--text); margin: 0; letter-spacing: -0.01em; }
	.sk-hint { font-size: 12.5px; color: var(--text-dimmer); margin: 0; }
	.sk-hint code { font-size: 11.5px; padding: 1px 5px; border-radius: 5px; background: var(--surface2); border: 1px solid var(--border2); }
	.sk-all { margin-left: auto; font-size: 13px; color: var(--text-dim); text-decoration: none; white-space: nowrap; }
	.sk-all:hover { color: var(--text); }

	.sk-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
	.sk-note { border: 1px solid var(--border2); border-radius: 14px; background: var(--surface); padding: 18px 20px; }
	.sk-note h3 { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-dimmer); margin: 0 0 9px; }
	.sk-note p { margin: 0; font-size: 14.5px; line-height: 1.7; color: var(--text-dim); }

	/* ---- SKILL.md file card, scrollable in place ---- */
	.sk-doc { position: relative; border: 1px solid var(--border2); border-radius: 14px; background: var(--surface); overflow: hidden; }
	/* Fade the bottom edge so a card whose file overflows reads as scrollable
	   rather than as text that has been cut off. pointer-events:none keeps the
	   scroll region itself fully usable underneath. */
	.sk-doc::after {
		content: '';
		position: absolute;
		left: 1px;
		right: 1px;
		bottom: 0;
		height: 56px;
		pointer-events: none;
		background: linear-gradient(to bottom, transparent, var(--surface));
	}
	.sk-doc-bar {
		display: flex;
		align-items: center;
		gap: 11px;
		padding: 10px 15px;
		border-bottom: 1px solid var(--border2);
		background: var(--surface2);
	}
	.sk-doc-dots { display: inline-flex; gap: 5px; flex: 0 0 auto; }
	.sk-doc-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--border3); }
	.sk-doc-bar code { font-size: 11.5px; color: var(--text-dimmer); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

	.sk-doc-body {
		max-height: 560px;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 22px 26px 28px;
		font-size: 14.5px;
		line-height: 1.75;
		color: var(--text-dim);
	}
	.sk-doc-body:focus-visible { outline: 2px solid var(--border3); outline-offset: -2px; }
	.sk-doc-body :global(h2) { font-size: 17px; font-weight: 600; color: var(--text); margin: 0 0 12px; letter-spacing: -0.01em; }
	.sk-doc-body :global(h3) { font-size: 14.5px; font-weight: 600; color: var(--text); margin: 26px 0 8px; }
	.sk-doc-body :global(h4) { font-size: 13.5px; font-weight: 600; color: var(--text); margin: 20px 0 6px; }
	.sk-doc-body :global(p) { margin: 0 0 13px; }
	.sk-doc-body :global(ul), .sk-doc-body :global(ol) { margin: 0 0 13px; padding-left: 21px; }
	.sk-doc-body :global(li) { margin-bottom: 5px; }
	.sk-doc-body :global(a) { color: var(--text); text-decoration: underline; text-underline-offset: 2px; }
	.sk-doc-body :global(strong) { color: var(--text); font-weight: 600; }
	.sk-doc-body :global(code) { font-size: 12.5px; padding: 1px 5px; border-radius: 5px; background: var(--surface2); border: 1px solid var(--border2); }
	.sk-doc-body :global(pre) { padding: 14px 16px; border-radius: 11px; background: var(--surface2); border: 1px solid var(--border2); overflow-x: auto; margin: 0 0 15px; }
	.sk-doc-body :global(pre code) { background: none; border: 0; padding: 0; }
	.sk-doc-body :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: 13px; display: block; overflow-x: auto; }
	.sk-doc-body :global(th), .sk-doc-body :global(td) { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border2); vertical-align: top; }
	.sk-doc-body :global(th) { color: var(--text); font-weight: 600; }
	.sk-doc-body :global(blockquote) { margin: 0 0 15px; padding-left: 13px; border-left: 2px solid var(--border2); color: var(--text-dimmer); }
	.sk-doc-body :global(hr) { border: 0; border-top: 1px solid var(--border2); margin: 24px 0; }

	/* ---- Horizontal rail of every other skill ---- */
	/* Kept inside the content column (no negative-margin bleed) so the first
	   card lines up with the section heading; the clipped final card is what
	   signals there is more to scroll. */
	.sk-rail {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 186px;
		gap: 16px;
		list-style: none;
		margin: 0;
		padding: 2px 0 14px;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x proximity;
		scrollbar-width: thin;
	}
	.sk-rail > li { scroll-snap-align: start; min-width: 0; }

	@media (max-width: 900px) {
		.sk-hero { grid-template-columns: minmax(0, 1fr); gap: 22px; }
		.sk-shot { max-width: 460px; }
		.sk-duo { grid-template-columns: minmax(0, 1fr); }
	}

	@media (max-width: 720px) {
		.sk { padding: 18px 20px 64px; }
		.sk h1 { font-size: 26px; }
		.sk-shot { max-width: none; }
		.sk-cta { width: 100%; }
		.sk-block { margin-top: 36px; }
		.sk-doc-body { max-height: 420px; padding: 18px 18px 22px; }
		.sk-rail { grid-auto-columns: 148px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.sk-rail { scroll-behavior: auto; }
	}
</style>
