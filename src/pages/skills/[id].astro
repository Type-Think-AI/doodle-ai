---
import AppShellLayout from '../../layouts/AppShellLayout.astro';
import { SKILLS, buildSkillThumbnail } from '../../lib/skills';

export function getStaticPaths() {
	return SKILLS.map((skill) => ({ params: { id: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;
const thumb = buildSkillThumbnail(skill);
---

<AppShellLayout title={`${skill.name} — Doodle AI`} description={skill.desc} active="skills">
	<div class="detail-page">
		<a class="detail-back" href="/skills">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path></svg>
			Skills
		</a>

		<div class="detail-head">
			<div class="detail-thumb" set:html={thumb} />
			<div class="detail-headings">
				<span class="detail-name">{skill.name}</span>
				<span class="detail-tagline">{skill.tagline}</span>
			</div>
			<div class="detail-actions">
				{skill.runnable ? (
					<a class="detail-run" href={`/?skill=${skill.id}`}>Use this skill</a>
				) : (
					<span class="detail-run detail-run-disabled">Coming soon</span>
				)}
			</div>
		</div>

		<div class="detail-meta">
			<span>Requires photo <b>{skill.requiresPhoto ? 'Yes' : 'No'}</b></span>
			<span>Output <b>{skill.aspectRatio}</b></span>
			<span>Category <b>{skill.category}</b></span>
		</div>

		<h2>Description</h2>
		<p class="detail-desc">{skill.longDesc}</p>

		<div class="detail-tags">
			{skill.tags.map((t) => <span>{t}</span>)}
		</div>
	</div>
</AppShellLayout>


<style>
	.detail-page { max-width: 900px; margin: 0 auto; padding: 26px 40px 64px; }
	.detail-back {
		display: flex;
		align-items: center;
		gap: 9px;
		color: var(--text);
		font-size: 17px;
		font-weight: 600;
		margin-bottom: 36px;
	}
	.detail-head { display: flex; align-items: center; gap: 18px; margin-bottom: 22px; flex-wrap: wrap; }
	.detail-thumb {
		width: 62px;
		height: 62px;
		flex: 0 0 62px;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--border2);
	}
	.detail-thumb :global(svg) { width: 100%; height: 100%; display: block; }
	.detail-headings { display: flex; flex-direction: column; gap: 5px; }
	.detail-name { font-size: 26px; font-weight: 600; letter-spacing: -0.02em; color: var(--text); }
	.detail-tagline { font-size: 14px; color: var(--text-dim); }
	.detail-actions { margin-left: auto; }
	.detail-run {
		display: inline-flex;
		align-items: center;
		height: 38px;
		padding: 0 22px;
		border-radius: 999px;
		border: 0;
		background: var(--send-bg);
		color: var(--send-fg);
		font-size: 14px;
		font-weight: 500;
		font-family: inherit;
		cursor: pointer;
	}
	.detail-run-disabled { background: var(--surface2); color: var(--text-dimmer); border: 1px solid var(--border2); }

	.detail-meta {
		display: flex;
		align-items: center;
		gap: 28px;
		flex-wrap: wrap;
		padding-bottom: 26px;
		font-size: 13.5px;
		color: var(--text-dimmer);
	}
	.detail-meta b { color: var(--text); font-weight: 500; }

	.detail-page h2 { font-size: 19px; font-weight: 600; color: var(--text); margin: 0 0 14px; }
	.detail-desc { margin: 0 0 26px; font-size: 15px; line-height: 1.75; color: var(--text-dim); max-width: 74ch; }

	.detail-tags { display: flex; flex-wrap: wrap; gap: 8px; }
	.detail-tags span {
		padding: 6px 12px;
		border-radius: 999px;
		border: 1px solid var(--border2);
		font-size: 12.5px;
		color: var(--text-dim);
	}

	@media (max-width: 720px) {
		.detail-page { padding: 20px; }
		.detail-actions { margin-left: 0; width: 100%; }
		.detail-run { width: 100%; justify-content: center; }
	}
</style>
