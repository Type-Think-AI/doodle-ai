---
import AppLayout from './AppLayout.astro';
import Sidebar from '../components/app/Sidebar.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/mobile/MobileNav.astro';
import AuthDialog from '../components/app/AuthDialog.astro';
import FeedbackDialog from '../components/app/FeedbackDialog.astro';
import UpgradeContactDialog from '../components/app/UpgradeContactDialog.astro';
import InstallPrompt from '../components/app/InstallPrompt.astro';
import AccountMenu from '../components/app/AccountMenu.astro';
import TeamNameDialog from '../components/app/TeamNameDialog.astro';
import JoinTeamDialog from '../components/app/JoinTeamDialog.astro';
import InviteTeamDialog from '../components/app/InviteTeamDialog.astro';
import Toast from '../components/app/Toast.astro';
import '../styles/app-shell.css';

interface Props {
  title: string;
  description?: string;
  /** Open Graph image. Forwarded to AppLayout so shell pages can set a social card. */
  image?: string;
  active: 'chat' | 'skills' | 'showcase' | 'boards' | 'characters' | 'settings' | 'roadmap';
  /**
   * Override the footer decision for this page.
   *
   * The default derives from `active` (see below). Pass `true` on a canvas
   * surface that is ALSO a public/indexable page and therefore wants the
   * footer's nav and interlinking — /roadmap/public is the case this exists
   * for. A page opting in must give its canvas a bounded height instead of
   * filling the shell, otherwise the footer sits below an unreachable 100dvh
   * canvas.
   */
  showFooter?: boolean;
  /** Path to this page's Markdown twin, forwarded to AppLayout. */
  markdownUrl?: string;
}
const { title, description, image, active, showFooter: showFooterProp, markdownUrl } = Astro.props;
// The marketing footer (CTA hero, marquee, partner grid) belongs on the
// content-browsing pages (skills, boards index, characters) — it was added
// there deliberately. "chat" and "roadmap" are live tool surfaces with a
// sticky composer / full-bleed canvas; appending a full marketing footer
// under them pushes the shell past 100dvh and becomes scrollable-into on
// mobile, replacing the tool with a landing page.
//
// A board DETAIL page (/b/:id) is also a tool surface — it has a pinned
// composer — but shares active="boards" with the browsable index, so it
// cannot be distinguished here. It passes showFooter={false} explicitly.
const showFooter = showFooterProp ?? (active !== 'chat' && active !== 'roadmap');

/* The wrapper below is <main>, not a div: it is this page's single main landmark.
   The 2026-08-28 audit failed "Document does not have a main landmark" because
   every shell page (home, skills, chat, characters, boards, roadmap, status)
   rendered only divs here, while the standalone pages outside this shell already
   had their own <main>.

   A page nested inside this layout must therefore NOT add a second <main> —
   /boards and /b/[id] were converted to divs when this landed. Kept as a
   frontmatter comment rather than an HTML comment so the rationale does not ship
   to every client on every page. */
---

<AppLayout title={title} description={description} image={image} markdownUrl={markdownUrl}>
  <div class="app-shell">
    <Sidebar active={active} />

    <main class:list={['app-shell-main', { 'has-footer': showFooter }]}>
      <div class="app-shell-content">
        <slot />
      </div>
      {showFooter && <Footer />}
    </main>
  </div>

  <MobileNav active={active} />
  <InstallPrompt />
  <AuthDialog />
  <FeedbackDialog />
  <UpgradeContactDialog />
  <AccountMenu />
  <TeamNameDialog />
  <JoinTeamDialog />
  <InviteTeamDialog />
  <Toast />
</AppLayout>

<script src="../scripts/app/install-prompt.ts"></script>
<script src="../scripts/app/mobile-nav-height.ts"></script>
