---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	/**
	 * Open Graph type. Editorial pages pass "article" so the keyword-URL content
	 * is not announced as a generic website node.
	 */
	ogType?: 'website' | 'article';
}

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { THEME_STORAGE_KEY } from '../lib/theme';
import WebMcpTools from '../components/agentic/WebMcpTools.astro';
import '../styles/app.css';

const {
	title = `${SITE_TITLE} — AI Doodle Avatar Generator`,
	description = SITE_DESCRIPTION,
	image = '/icon-512.png',
	noindex = false,
	ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://doodleai.art');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${site.href}#website`,
			name: 'Doodle AI',
			url: site.href,
			description: SITE_DESCRIPTION,
			potentialAction: {
				'@type': 'SearchAction',
				target: { '@type': 'EntryPoint', urlTemplate: `${site.href}skills/?q={search_term_string}` },
				'query-input': 'required name=search_term_string',
			},
		},
		{
			'@type': 'SoftwareApplication',
			'@id': `${site.href}#application`,
			name: 'Doodle AI',
			applicationCategory: 'MultimediaApplication',
			operatingSystem: 'Web',
			url: site.href,
			description: SITE_DESCRIPTION,
			image: ogImage.href,
			isAccessibleForFree: true,
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
				description: '5 free credits on signup',
			},
		},
		{
			'@type': 'Organization',
			'@id': `${site.href}#organization`,
			name: 'Doodle AI',
			url: site.href,
			logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', site).href },
			sameAs: ['https://github.com/Type-Think-AI'],
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="application-name" content="Doodle AI" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />

		<!-- Sets [data-theme] before first paint so a stored "light" preference
		     never flashes the dark default. Kept inline (not a module import)
		     so it runs synchronously, ahead of any other script or stylesheet. -->
		<script is:inline define:vars={{ THEME_STORAGE_KEY }}>
			try {
				if (localStorage.getItem(THEME_STORAGE_KEY) === "light") {
					document.documentElement.setAttribute("data-theme", "light");
				}
			} catch {
				// localStorage may be unavailable before the page has loaded.
			}
		</script>

		<!-- Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#fab700" />

		<!-- CDN preconnect. No font preload: this site renders in the system UI
		     font stack (see src/styles/app.css) and declares no @font-face at
		     all, so the Atkinson preload inherited from the Astro starter was
		     downloading ~23 KB on every page load and discarding it — the browser
		     reported it as "preloaded but not used within a few seconds". -->
		<link rel="preconnect" href="https://cdn.picxstudio.com" crossorigin />

		<!-- Primary -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="x-default" href={canonical} />
		<!-- Machine-readable discovery hint. A rel="alternate" with a JSON type
		     is the standard alternate-representation pattern (same mechanism as
		     the RSS alternate); it lets an agent find the article index from any
		     page's <head> without crawling. Mirrors the public sitemap; robots.txt
		     Allows the path. No account data, no secrets. -->
		<link
			rel="alternate"
			type="application/json"
			href={new URL('/api/agent-index.json', site)}
			title="Doodle AI article index (machine-readable)"
		/>
		{noindex
			? <meta name="robots" content="noindex, nofollow" />
			: <meta name="robots" content="index, follow, max-image-preview:large" />
		}

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="doodleai.art" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Doodle AI hand-drawn avatar creator" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Doodle AI hand-drawn avatar creator" />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!--
			Per-page <head> additions. Editorial articles use this to emit their
			Article / BreadcrumbList / FAQPage JSON-LD. The canonical, OG, and
			Twitter tags above already cover every route, so pages must not
			re-declare them here.
		-->
		<slot name="head" />

		<!--
			DataFast analytics (default script — uses cookies for visitor identification).
			Added here so every page, current and future, is covered from one place.
			Notes:
			 - Cookie usage is disclosed in /privacy-policy. If this is ever swapped for
			   script.cookieless.js, the DataFast dashboard toggle must match the URL.
			 - DataFast disables itself on localhost, so this only reports in production.
		-->
		<script
			defer
			data-website-id="dfid_2nlWf6zeRWRAFhLFpeRq6"
			data-domain="doodleai.art"
			src="https://datafa.st/js/script.js"
		></script>

		<!--
			Mixpanel product analytics + Session Replay.

			Loaded as a bundled module (src/scripts/app/analytics-boot.ts) rather than
			the CDN loader stub that used to sit here inline. The stub queued calls on
			a window array, so it was untyped, un-awaitable, and — pasted twice — ran
			init() twice on every page load. Replay config and the reasoning behind each
			non-default option live in src/scripts/app/replay-config.ts.
		-->
		<script src="../scripts/app/analytics-boot.ts"></script>

		<!-- Google Analytics 4 (GA4) — async, non-blocking. -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-K6KZRWJH8H"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(...args){window.dataLayer.push(args);}
			gtag('js', new Date());
			gtag('config', 'G-K6KZRWJH8H', { send_page_view: true });
		</script>
	</head>
	<body>
		<slot />
		<!-- Registers read-only WebMCP tools when the browser exposes
		     document.modelContext. Renders no markup; see the component for why
		     nothing that spends a credit is exposed. -->
		<WebMcpTools />
	</body>
</html>
