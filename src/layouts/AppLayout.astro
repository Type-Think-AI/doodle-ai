---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	/**
	 * Open Graph type. Editorial pages pass "article" so the keyword-URL content
	 * is not announced as a generic website node.
	 */
	ogType?: 'website' | 'article';
}

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { THEME_STORAGE_KEY } from '../lib/theme';
import '../styles/app.css';

const {
	title = `${SITE_TITLE} — AI Doodle Avatar Generator`,
	description = SITE_DESCRIPTION,
	image = '/icon-512.png',
	noindex = false,
	ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://doodleai.art');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${site.href}#website`,
			name: 'Doodle AI',
			url: site.href,
			description: SITE_DESCRIPTION,
		},
		{
			'@type': 'SoftwareApplication',
			'@id': `${site.href}#application`,
			name: 'Doodle AI',
			applicationCategory: 'MultimediaApplication',
			operatingSystem: 'Web',
			url: site.href,
			description: SITE_DESCRIPTION,
			image: ogImage.href,
			isAccessibleForFree: true,
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="application-name" content="Doodle AI" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />

		<!-- Sets [data-theme] before first paint so a stored "light" preference
		     never flashes the dark default. Kept inline (not a module import)
		     so it runs synchronously, ahead of any other script or stylesheet. -->
		<script is:inline define:vars={{ THEME_STORAGE_KEY }}>
			try {
				if (localStorage.getItem(THEME_STORAGE_KEY) === "light") {
					document.documentElement.setAttribute("data-theme", "light");
				}
			} catch {
				// localStorage may be unavailable before the page has loaded.
			}
		</script>

		<!-- Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#fab700" />

		<!-- Primary -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="doodleai.art" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Doodle AI hand-drawn avatar creator" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Doodle AI hand-drawn avatar creator" />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!--
			Per-page <head> additions. Editorial articles use this to emit their
			Article / BreadcrumbList / FAQPage JSON-LD. The canonical, OG, and
			Twitter tags above already cover every route, so pages must not
			re-declare them here.
		-->
		<slot name="head" />

		<!--
			DataFast analytics (default script — uses cookies for visitor identification).
			Added here so every page, current and future, is covered from one place.
			Notes:
			 - Cookie usage is disclosed in /privacy-policy. If this is ever swapped for
			   script.cookieless.js, the DataFast dashboard toggle must match the URL.
			 - DataFast disables itself on localhost, so this only reports in production.
		-->
		<script
			defer
			data-website-id="dfid_2nlWf6zeRWRAFhLFpeRq6"
			data-domain="doodleai.art"
			src="https://datafa.st/js/script.js"
		></script>

		<!-- Mixpanel product analytics — event tracking, funnels, identity. -->
		<script is:inline>
			(function(f,b){if(!b.__SV){var e,g,i,h;window.mixpanel=b;b._i=[];b.init=function(e,f,c){function g(a,d){var b=d.split(".");2==b.length&&(a=a[b[0]],d=b[1]);a[d]=function(){a.push([d].concat(Array.prototype.slice.call(arguments,0)))}}var a=b;"undefined"!==typeof c?a=b[c]=[]:c="mixpanel";a.people=a.people||[];a.toString=function(a){var d="mixpanel";"mixpanel"!==c&&(d+="."+c);a||(d+=" (stub)");return d};a.people.toString=function(){return a.toString(1)+".people (stub)"};i="disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" ");for(h=0;h<i.length;h++)g(a,i[h]);var j="set set_once union unset remove delete".split(" ");a.get_group=function(){function b(c){d[c]=function(){call2_args=arguments;call2=[c].concat(Array.prototype.slice.call(call2_args,0));a.push([e,call2])}}for(var d={},e=["get_group"].concat(Array.prototype.slice.call(arguments,0)),c=0;c<j.length;c++)b(j[c]);return d};b._i.push([e,f,c])};b.__SV=1.2;e=f.createElement("script");e.type="text/javascript";e.async=!0;e.src="https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";g=f.getElementsByTagName("script")[0];g.parentNode.insertBefore(e,g)}})(document,window.mixpanel||[]);

			mixpanel.init("2f06c42c258b8121e6d3feb324179bf2", {
				debug: false,
				track_pageview: true,
				persistence: "localStorage"
			});
		</script>

		<!-- Google Analytics 4 (GA4) — async, non-blocking. -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-K6KZRWJH8H"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-K6KZRWJH8H', { send_page_view: true });
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
