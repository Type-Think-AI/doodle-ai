---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { THEME_STORAGE_KEY } from '../lib/theme';
import '../styles/app.css';

const {
	title = `${SITE_TITLE} — AI Doodle Avatar Generator`,
	description = SITE_DESCRIPTION,
	image = '/icon-512.png',
	noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://doodleai.art');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${site.href}#website`,
			name: 'Doodle AI',
			url: site.href,
			description: SITE_DESCRIPTION,
		},
		{
			'@type': 'SoftwareApplication',
			'@id': `${site.href}#application`,
			name: 'Doodle AI',
			applicationCategory: 'MultimediaApplication',
			operatingSystem: 'Web',
			url: site.href,
			description: SITE_DESCRIPTION,
			image: ogImage.href,
			isAccessibleForFree: true,
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="application-name" content="Doodle AI" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />

		<!-- Sets [data-theme] before first paint so a stored "light" preference
		     never flashes the dark default. Kept inline (not a module import)
		     so it runs synchronously, ahead of any other script or stylesheet. -->
		<script is:inline define:vars={{ THEME_STORAGE_KEY }}>
			try {
				if (localStorage.getItem(THEME_STORAGE_KEY) === "light") {
					document.documentElement.setAttribute("data-theme", "light");
				}
			} catch {
				// localStorage may be unavailable before the page has loaded.
			}
		</script>

		<!-- Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#fab700" />

		<!-- Space Grotesk: primary typeface across the app shell and marketing pages -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Primary -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="doodleai.art" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Doodle AI hand-drawn avatar creator" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Doodle AI hand-drawn avatar creator" />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!--
			DataFast analytics (default script — uses cookies for visitor identification).
			Added here so every page, current and future, is covered from one place.
			Notes:
			 - Cookie usage is disclosed in /privacy-policy. If this is ever swapped for
			   script.cookieless.js, the DataFast dashboard toggle must match the URL.
			 - DataFast disables itself on localhost, so this only reports in production.
		-->
		<script
			defer
			data-website-id="dfid_dmS4cKTHVBZqQ8Yln9TTM"
			data-domain="doodleai.art"
			src="https://datafa.st/js/script.js"
		></script>
	</head>
	<body>
		<slot />
	</body>
</html>
