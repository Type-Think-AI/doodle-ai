---
/**
 * FooterCTA — Primary call-to-action block with headline and action buttons.
 */
import { resizedCdnImage } from '../../lib/cdn-image';

/* These four tiles are purely decorative (aria-hidden, empty alt) and render at
   86x106 CSS px, but they were being served as 1024px PicX originals — roughly
   1.3 MB each, on every page carrying the footer. 240px covers the box to ~2.8x
   DPR. They are also below the fold on every page, so all four are lazy. */
const TILE_WIDTH = 240;
const tiles = [
	{ url: 'https://cdn.picxstudio.com/api/generated/image_8e49ae56-a6d9-42f5-ae26-011e03e1b5c9.png', rotate: '-3deg' },
	{ url: 'https://cdn.picxstudio.com/api/generated/image_af9449aa-7e1e-481b-9711-f45eca01e5ae.png', rotate: '3deg' },
	{ url: 'https://cdn.picxstudio.com/api/generated/image_b991b561-8c11-4541-8869-145eac6070f6.png', rotate: '-2deg' },
	{ url: 'https://cdn.picxstudio.com/api/generated/image_fbca2637-7236-4565-a6c7-e909110cf472.png', rotate: '3deg' },
];
---

<div class="db-cta">
	<div class="db-cta-copy">
		<span class="db-badge">
			<span class="db-dot-pulse" aria-hidden="true"></span>
			Studio is live
		</span>
		<h2 class="db-headline">Your next character is<br />one prompt away.</h2>
		<div class="db-cta-actions">
			<a href="/" class="db-btn db-btn-primary">
				Start doodling free
				<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h13M12 6l6 6-6 6"></path>
				</svg>
			</a>
			<a href="/for-studios" class="db-btn db-btn-ghost">For studios</a>
		</div>
	</div>

	<div class="db-tiles" aria-hidden="true">
		{tiles.map((tile) => (
			<img
				class="db-tile"
				src={resizedCdnImage(tile.url, TILE_WIDTH)}
				alt=""
				width="86"
				height="106"
				loading="lazy"
				decoding="async"
				style={`transform:rotate(${tile.rotate});`}
			/>
		))}
	</div>
</div>
