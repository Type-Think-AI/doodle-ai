---
/**
 * FooterCTA — Primary call-to-action block with headline and action buttons.
 */
---

<div class="db-cta">
	<div class="db-cta-copy">
		<span class="db-badge">
			<span class="db-dot-pulse" aria-hidden="true"></span>
			Studio is live
		</span>
		<h2 class="db-headline">Your next character is<br />one prompt away.</h2>
		<div class="db-cta-actions">
			<a href="/" class="db-btn db-btn-primary">
				Start doodling free
				<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h13M12 6l6 6-6 6"></path>
				</svg>
			</a>
			<a href="/for-studios" class="db-btn db-btn-ghost">For studios</a>
		</div>
	</div>

	<div class="db-tiles" aria-hidden="true">
		<span class="db-tile" style="background:linear-gradient(148deg,var(--accent),var(--accent-soft)); transform:rotate(-3deg);"></span>
		<span class="db-tile" style="background:linear-gradient(148deg,var(--card-hover),var(--accent-softer)); transform:rotate(3deg);"></span>
		<span class="db-tile" style="background:linear-gradient(148deg,var(--surface2),var(--card-hover)); transform:rotate(-3deg);"></span>
		<span class="db-tile" style="background:linear-gradient(148deg,var(--accent-soft),var(--accent)); transform:rotate(3deg);"></span>
	</div>
</div>
