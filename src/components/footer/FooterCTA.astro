---
/**
 * FooterCTA — Primary call-to-action block with headline and action buttons.
 */
---

<div class="db-cta">
	<div class="db-cta-copy">
		<span class="db-badge">
			<span class="db-dot-pulse" aria-hidden="true"></span>
			Studio is live
		</span>
		<h2 class="db-headline">Your next character is<br />one prompt away.</h2>
		<div class="db-cta-actions">
			<a href="/" class="db-btn db-btn-primary">
				Start doodling free
				<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h13M12 6l6 6-6 6"></path>
				</svg>
			</a>
			<a href="/for-studios" class="db-btn db-btn-ghost">For studios</a>
		</div>
	</div>

	<div class="db-tiles" aria-hidden="true">
		<img class="db-tile" src="https://cdn.picxstudio.com/api/generated/image_8e49ae56-a6d9-42f5-ae26-011e03e1b5c9.png" alt="" style="transform:rotate(-3deg);" />
		<img class="db-tile" src="https://cdn.picxstudio.com/api/generated/image_af9449aa-7e1e-481b-9711-f45eca01e5ae.png" alt="" style="transform:rotate(3deg);" />
		<img class="db-tile" src="https://cdn.picxstudio.com/api/generated/image_b991b561-8c11-4541-8869-145eac6070f6.png" alt="" style="transform:rotate(-2deg);" />
		<img class="db-tile" src="https://cdn.picxstudio.com/api/generated/image_fbca2637-7236-4565-a6c7-e909110cf472.png" alt="" style="transform:rotate(3deg);" />
	</div>
</div>
