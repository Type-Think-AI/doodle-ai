---
/**
 * FooterNav — Crawlable navigation link groups.
 * Uses semantic <nav> with aria-label per group for screen-readers
 * and clean internal link signals for search engines.
 *
 * Keyword landings live at the site root and are this product's marketing
 * channel. The footer is on every page, so listing the hubs here is how
 * app pages pass internal links to them. Labels are the short keyword form.
 * A Skills column points at live generation modes so people can explore
 * the catalog without hunting the marketplace.
 */

interface NavColumn {
	title: string;
	links: { label: string; href: string }[];
}

import { contactChannels } from "../../lib/contact";

const columns: NavColumn[] = [
	{
		title: "Studio",
		links: [
			{ label: "Doodle AI App", href: "/" },
			{ label: "Skill gallery", href: "/skills" },
			{ label: "Characters", href: "/characters" },
			{ label: "Learn", href: "/learn" },
			{ label: "For studios", href: "/for-studios" },
			{ label: "About Doodle AI", href: "/about" },
		],
	},
	{
		title: "Convert",
		links: [
			{ label: "Photo to doodle", href: "/photo-to-doodle" },
			{ label: "Picture to doodle", href: "/picture-to-doodle" },
			{ label: "Photo to cartoon", href: "/photo-to-cartoon" },
			{ label: "Photo to sticker", href: "/photo-to-sticker" },
			{ label: "WhatsApp sticker maker", href: "/whatsapp-sticker-maker" },
			{ label: "Photo to coloring page", href: "/photo-to-coloring-page" },
			{ label: "Cartoon profile picture", href: "/cartoon-profile-picture" },
		],
	},
	{
		title: "Make",
		links: [
			{ label: "Doodle generator", href: "/doodle-generator" },
			{ label: "AI doodle generator", href: "/ai-doodle-generator" },
			{ label: "Doodle maker", href: "/doodle-maker" },
			{ label: "Couple doodle", href: "/couple-doodle" },
			{ label: "Diwali doodle", href: "/diwali-doodle" },
			{ label: "Cute doodle", href: "/cute-doodle" },
			{ label: "Doodle ideas", href: "/doodle-ideas" },
			{ label: "Doodle coloring pages", href: "/doodle-coloring-pages" },
		],
	},
	{
		title: "Skills",
		links: [
			{ label: "All skills", href: "/skills" },
			{ label: "Doodle Avatar", href: "/skills/normal" },
			{ label: "Sticker Pack", href: "/skills/stickers" },
			{ label: "Couple Doodle", href: "/skills/couple" },
			{ label: "Festival Pack", href: "/skills/festival" },
			{ label: "Crayon Self", href: "/skills/crayon" },
			{ label: "Surprise Me", href: "/skills/surprise" },
			{ label: "Gift Doodle", href: "/skills/gift" },
			{ label: "Pet Portrait", href: "/skills/pet" },
		],
	},
	{
		title: "Company",
		links: [
			{ label: "GitHub (open source)", href: "https://github.com/Type-Think-AI/doodle-ai" },
			{ label: "Terms of service", href: "/terms-of-service" },
			{ label: "Privacy policy", href: "/privacy-policy" },
			...contactChannels().map(({ label, href }) => ({ label, href })),
		],
	},
];
---

<nav aria-label="Footer navigation" class="db-cols">
	{columns.map((col) => (
		<div class="db-col" role="group" aria-labelledby={`footer-heading-${col.title.toLowerCase()}`}>
			<span class="db-col-title" id={`footer-heading-${col.title.toLowerCase()}`}>
				<span class="db-col-dot" aria-hidden="true"></span>
				{col.title}
			</span>
			<ul class="db-col-links" role="list">
				{col.links.map((l) => (
					<li>
						<a
							href={l.href}
							class="db-link"
							{...(l.href.startsWith("mailto:") ? { rel: "noopener" } : {})}
							{...(l.href.startsWith("http")
								? { target: "_blank", rel: "noopener noreferrer" }
								: {})}
						>
							{l.label}
						</a>
					</li>
				))}
			</ul>
		</div>
	))}
</nav>
