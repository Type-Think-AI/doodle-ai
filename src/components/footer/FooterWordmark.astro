---
/**
 * FooterWordmark — Large doodle-art wordmark with a cursor-spotlight reveal.
 *
 * The mark is a hand-drawn "DOODLE AI" lettering asset generated with the
 * product itself (PicX), keyed to transparency so it sits on any footer
 * background. Two stacked copies: a base layer at rest, and a saturated
 * layer revealed through a radial mask that tracks the cursor.
 *
 * Purely decorative — alt is empty and both layers are aria-hidden, since
 * FooterBrand already announces the product name to assistive tech.
 */
---

<div class="db-wordmark" id="dbWordmark">
	<img
		class="db-word-base"
		src="/brand/doodle-ai-wordmark.webp"
		alt=""
		aria-hidden="true"
		width="1240"
		height="460"
		loading="lazy"
		decoding="async"
		draggable="false"
	/>
	<img
		class="db-word-lit"
		src="/brand/doodle-ai-wordmark.webp"
		alt=""
		aria-hidden="true"
		width="1240"
		height="460"
		loading="lazy"
		decoding="async"
		draggable="false"
	/>
	<span class="db-word-hint" id="dbWordHint">move your cursor across the name</span>
</div>

<script>
	const wordmark = document.getElementById("dbWordmark");
	const hint = document.getElementById("dbWordHint");
	if (wordmark && hint) {
		wordmark.addEventListener("mousemove", (e) => {
			const r = wordmark.getBoundingClientRect();
			const mx = (((e as MouseEvent).clientX - r.left) / r.width * 100).toFixed(1);
			const my = (((e as MouseEvent).clientY - r.top) / r.height * 100).toFixed(1);
			wordmark.style.setProperty("--mx", `${mx}%`);
			wordmark.style.setProperty("--my", `${my}%`);
			wordmark.classList.add("db-hot");
			hint.textContent = "keep moving";
		});
		wordmark.addEventListener("mouseleave", () => {
			wordmark.classList.remove("db-hot");
			hint.textContent = "move your cursor across the name";
		});
	}
</script>
