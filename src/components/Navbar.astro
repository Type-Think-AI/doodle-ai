---
---

<header class="app-header">
  <div class="logo">
    <img class="mark" src="/icon-192.png" alt="doodleai.art" width="48" height="48" />
    <a href="/">doodleai<span>.art</span></a>
  </div>

  <!-- Desktop nav -->
  <nav class="nav-links" aria-label="Main navigation">
    <a href="/skills">Skills</a>
    <a href="/learn">Learn</a>
    <a href="/about">About</a>
    <a href="https://github.com/Type-Think-AI/doodle-ai" target="_blank" rel="noopener" class="github-link" title="Star us on GitHub" aria-label="GitHub repository">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
    </a>
    <button class="theme-toggle" id="themeToggle" title="Switch theme">☾</button>
  </nav>

  <!-- Mobile controls -->
  <div class="mobile-controls">
    <button class="theme-toggle" id="themeToggleMobile" title="Switch theme">☾</button>
    <button
      class="hamburger"
      id="navHamburger"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobileNav"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>
</header>

<!-- Mobile slide-down nav panel -->
<div class="mobile-nav" id="mobileNav" aria-hidden="true" role="navigation" aria-label="Mobile navigation">
  <div class="mobile-nav-inner">
    <div class="mobile-nav-links">
      <a href="/" class="mobile-nav-link">Home</a>
      <a href="/skills" class="mobile-nav-link">Skills</a>
      <a href="/learn" class="mobile-nav-link">Learn</a>
      <a href="/boards" class="mobile-nav-link">Boards</a>
      <a href="/for-studios" class="mobile-nav-link">For studios</a>
      <a href="/about" class="mobile-nav-link">About</a>
    </div>
    <div class="mobile-nav-secondary">
      <a href="https://github.com/Type-Think-AI/doodle-ai" target="_blank" rel="noopener" class="mobile-nav-link-sm">⭐ GitHub</a>
      <a href="/settings" class="mobile-nav-link-sm">Settings</a>
      <a href="/terms-of-service" class="mobile-nav-link-sm">Terms</a>
      <a href="/privacy-policy" class="mobile-nav-link-sm">Privacy</a>
    </div>
  </div>
</div>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--shell-pad);
    width: 100%;
    max-width: var(--shell-max);
    margin: 0 auto;
    background: var(--bg);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.34rem;
    font-family: "Arial Rounded MT Bold", "Trebuchet MS", Arial, sans-serif;
    letter-spacing: -0.03em;
  }
  .logo .mark {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    display: block;
    object-fit: contain;
  }
  .logo span {
    color: var(--accent);
  }
  .logo a {
    display: inline-block;
  }

  /* Desktop nav */
  .nav-links {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .nav-links a {
    font-size: 0.85rem;
    color: var(--text-dim);
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .nav-links a:hover {
    color: var(--text);
  }
  .github-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--card-hover);
    color: var(--text-dim);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .github-link:hover {
    color: var(--text);
    background: var(--border);
  }
  .nav-links a:focus-visible,
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 6px;
    color: var(--text);
  }

  .theme-toggle {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: var(--card-hover);
    color: var(--text-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    transition: color 0.15s, background 0.15s;
  }
  .theme-toggle:hover {
    color: var(--text);
  }

  /* Mobile controls — hidden on desktop */
  .mobile-controls {
    display: none;
    align-items: center;
    gap: 6px;
  }

  /* Hamburger button */
  .hamburger {
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 12px;
    background: var(--card-hover);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    transition: background 0.15s;
  }
  .hamburger:hover {
    background: var(--border);
  }
  .hamburger-bar {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 1px;
    background: var(--text-dim);
    transition: transform 0.25s cubic-bezier(0.2, 0.85, 0.2, 1), opacity 0.2s;
  }

  /* Hamburger open state */
  .hamburger[aria-expanded="true"] .hamburger-bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger-bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Mobile nav panel */
  .mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 99;
    background: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-nav.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 80px var(--shell-pad) 40px;
    min-height: 100%;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-nav-link {
    display: flex;
    align-items: center;
    padding: 14px 12px;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    transition: background 0.15s, color 0.15s;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background: var(--card-hover);
  }
  .mobile-nav-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .mobile-nav-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .mobile-nav-link-sm {
    font-size: 0.82rem;
    color: var(--text-dimmer);
    padding: 8px 0;
    transition: color 0.15s;
  }
  .mobile-nav-link-sm:hover {
    color: var(--text-dim);
  }

  /* ─── Mobile breakpoint ─── */
  @media (max-width: 720px) {
    .app-header {
      padding: 12px 20px;
      position: sticky;
      top: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .nav-links {
      display: none;
    }
    .mobile-controls {
      display: flex;
    }
    .mobile-nav {
      display: block;
    }
    .logo {
      font-size: 1.12rem;
      gap: 8px;
    }
    .logo .mark {
      width: 36px;
      height: 36px;
      border-radius: 9px;
    }
    .theme-toggle {
      width: 44px;
      height: 44px;
    }
  }

  /* ─── Small phones ─── */
  @media (max-width: 390px) {
    .logo {
      font-size: 1rem;
    }
    .mobile-nav-inner {
      padding: 72px 20px 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-bar {
      transition: none;
    }
    .mobile-nav {
      transition: none;
    }
  }
</style>

<script>
  const hamburger = document.getElementById("navHamburger");
  const mobileNav = document.getElementById("mobileNav");

  if (hamburger && mobileNav) {
    let isOpen = false;

    function openNav() {
      isOpen = true;
      hamburger!.setAttribute("aria-expanded", "true");
      hamburger!.setAttribute("aria-label", "Close navigation menu");
      mobileNav!.setAttribute("aria-hidden", "false");
      mobileNav!.classList.add("is-open");
      document.body.style.overflow = "hidden";
    }

    function closeNav() {
      isOpen = false;
      hamburger!.setAttribute("aria-expanded", "false");
      hamburger!.setAttribute("aria-label", "Open navigation menu");
      mobileNav!.setAttribute("aria-hidden", "true");
      mobileNav!.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    hamburger.addEventListener("click", () => {
      if (isOpen) closeNav();
      else openNav();
    });

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeNav();
        hamburger!.focus();
      }
    });

    // Close on link click (navigation)
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeNav);
    });
  }
</script>
