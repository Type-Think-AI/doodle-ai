---
/**
 * Visible breadcrumb trail. Pairs with the BreadcrumbList JSON-LD in
 * ArticleSchema.astro — structured data should always describe something the
 * page actually renders, so both are driven by the same `breadcrumbs` array.
 */
interface Props {
	items: { name: string; url?: string }[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
	<ol>
		{
			items.map((item, index) => (
				<li>
					{index > 0 && <span class="sep" aria-hidden="true">/</span>}
					{item.url ? (
						<a href={item.url}>{item.name}</a>
					) : (
						<span aria-current="page">{item.name}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>

<style>
	.crumbs {
		margin: 0 0 10px;
	}
	.crumbs ol {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		padding: 0;
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-dimmer);
	}
	.crumbs li {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
	}
	.crumbs a {
		color: var(--text-dim);
		text-decoration: none;
	}
	.crumbs a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.crumbs [aria-current="page"] {
		color: var(--text-dimmer);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 42ch;
	}
	.sep {
		color: var(--border);
	}
</style>
