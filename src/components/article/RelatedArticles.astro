---
/**
 * Auto-computed cross-links.
 *
 * Used for two blocks:
 *   - "In this section" — children of a keyword hub (getHubChildren)
 *   - "Related reading" — same-cluster then same-hub then newest (getRelatedArticles)
 *
 * Both come from frontmatter, so a new article joins the graph without editing
 * any existing article's markdown.
 */
import type { ArticleLink } from "../../lib/content/articles";
import { CATEGORY_LABEL } from "../../lib/content/articles";

interface Props {
	heading: string;
	items: ArticleLink[];
}

const { heading, items } = Astro.props;
---

{
	items.length > 0 && (
		<aside class="related">
			<h2>{heading}</h2>
			<ul>
				{items.map((item) => (
					<li>
						<a href={item.url}>
							<span class="tag">{CATEGORY_LABEL[item.category]}</span>
							<span class="title">{item.title}</span>
							<span class="desc">{item.description}</span>
						</a>
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.related {
		margin: 34px 0 0;
		padding-top: 22px;
		border-top: 1px solid var(--border);
	}
	.related h2 {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-dimmer);
		margin: 0 0 14px;
	}
	.related ul {
		list-style: none;
		display: grid;
		gap: 10px;
		padding: 0;
		margin: 0;
	}
	.related a {
		display: grid;
		gap: 4px;
		padding: 12px 14px;
		border: 1px solid var(--border);
		border-radius: 12px;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}
	.related a:hover {
		border-color: var(--accent);
		background: var(--card-hover);
	}
	.tag {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.title {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text);
		line-height: 1.35;
	}
	.desc {
		font-size: 0.82rem;
		color: var(--text-dim);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
