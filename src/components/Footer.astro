---
/**
 * Footer — Site-wide footer composed from semantic sub-components.
 *
 * SEO/AEO improvements:
 * - Uses <footer> landmark with role="contentinfo"
 * - Nav links in semantic <nav> with aria-label per group
 * - Brand mark is now a crawlable link to homepage
 * - Link labels are descriptive ("Doodle AI App", "About Doodle AI")
 * - Legal links repeated in conventional footer-legal bar
 * - All existing URLs, tokens, animations, and responsive behavior preserved
 */
import FooterCTA from "./footer/FooterCTA.astro";
import FooterMarquee from "./footer/FooterMarquee.astro";
import FooterBrand from "./footer/FooterBrand.astro";
import FooterNav from "./footer/FooterNav.astro";
import FooterWordmark from "./footer/FooterWordmark.astro";
import FooterLegal from "./footer/FooterLegal.astro";
---

<footer class="db-footer" role="contentinfo" aria-label="Site footer">
	<div class="db-bg" aria-hidden="true">
		<div class="db-glow db-glow-a"></div>
		<div class="db-glow db-glow-b"></div>
		<div class="db-dots"></div>
	</div>

	<div class="db-shell">
		<FooterCTA />
		<FooterMarquee />

		<div class="db-top">
			<FooterBrand />
			<FooterNav />
		</div>

		<FooterWordmark />
		<FooterLegal />
	</div>
</footer>

<style>
	.db-footer {
		position: relative;
		overflow: hidden;
		background: var(--bg);
		margin-top: 60px;
		border-top: 1px solid var(--border);
	}

	.db-bg {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.db-glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(28px);
	}
	.db-glow-a {
		width: 700px;
		height: 700px;
		left: -200px;
		top: -300px;
		background: radial-gradient(circle, rgba(250, 183, 0, 0.16), transparent 62%);
		animation: dbDrift 19s ease-in-out infinite;
	}
	.db-glow-b {
		width: 620px;
		height: 620px;
		right: -180px;
		bottom: -260px;
		background: radial-gradient(circle, rgba(250, 183, 0, 0.08), transparent 62%);
		animation: dbDrift2 24s ease-in-out infinite;
	}
	.db-dots {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
		background-size: 28px 28px;
		mask-image: linear-gradient(180deg, transparent, #000 34%, #000 72%, transparent);
	}
	:root[data-theme="light"] .db-dots {
		background-image: radial-gradient(rgba(0, 0, 0, 0.06) 1px, transparent 1px);
	}

	.db-shell {
		position: relative;
		max-width: var(--shell-max);
		margin: 0 auto;
		padding: 56px var(--shell-pad) 0;
		width: 100%;
	}

	/* ─── Main columns ─── */
	.db-top {
		display: grid;
		grid-template-columns: minmax(260px, 1.05fr) minmax(340px, 1fr);
		gap: 64px;
		align-items: start;
		padding: 52px 0 0;
	}

	@keyframes dbDrift {
		0% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(5%, -7%, 0) scale(1.14); }
		100% { transform: translate3d(0, 0, 0) scale(1); }
	}
	@keyframes dbDrift2 {
		0% { transform: translate3d(0, 0, 0) scale(1.06); }
		50% { transform: translate3d(-7%, 6%, 0) scale(0.9); }
		100% { transform: translate3d(0, 0, 0) scale(1.06); }
	}

	/* ─── Tablet ─── */
	@media (max-width: 1080px) {
		.db-top {
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}

	/* ─── Mobile ─── */
	@media (max-width: 720px) {
		.db-footer {
			margin-top: 40px;
		}
		.db-shell {
			padding: 32px 20px 0;
		}
		.db-top {
			grid-template-columns: 1fr;
			gap: 32px;
			padding: 36px 0 0;
		}
		.db-glow-a {
			width: 400px;
			height: 400px;
			left: -100px;
			top: -150px;
		}
		.db-glow-b {
			width: 350px;
			height: 350px;
			right: -100px;
			bottom: -130px;
		}
		.db-dots {
			background-size: 22px 22px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.db-glow-a,
		.db-glow-b {
			animation: none !important;
		}
	}
</style>

<style is:global>
	/* ═══════════════════════════════════════════════
	   Footer sub-component styles
	   (global because Astro scopes per-file)
	   ═══════════════════════════════════════════════ */

	/* ─── CTA ─── */
	.db-cta {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
		flex-wrap: wrap;
		padding-bottom: 34px;
	}
	.db-cta-copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 560px;
	}
	.db-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		align-self: flex-start;
		padding: 5px 11px 5px 8px;
		border-radius: 999px;
		border: 1px solid var(--border2);
		background: var(--card);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.4px;
		color: var(--text-dim);
	}
	.db-dot-pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--green);
		animation: dbPulse 2s ease-in-out infinite;
	}
	.db-dot-pulse-sm {
		width: 7px;
		height: 7px;
		box-shadow: 0 0 0 4px var(--green-faint);
	}
	.db-headline {
		margin: 0;
		font-size: clamp(26px, 3.4vw, 40px);
		line-height: 1.06;
		letter-spacing: -0.03em;
		font-weight: 700;
		color: var(--text);
		text-wrap: balance;
	}
	.db-cta-actions {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}
	.db-btn {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		height: 46px;
		padding: 0 20px;
		border-radius: 13px;
		font-size: 13.5px;
		font-weight: 600;
		transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s, color 0.25s;
	}
	.db-btn-primary {
		color: #141414;
		background: linear-gradient(100deg, var(--accent) 0%, #ffd152 45%, var(--accent) 90%);
		background-size: 220% 100%;
		animation: dbSheen 5s ease-in-out infinite;
	}
	.db-btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 30px rgba(250, 183, 0, 0.34);
	}
	.db-btn-primary svg {
		animation: dbNudge 1.8s ease-in-out infinite;
	}
	.db-btn-ghost {
		font-weight: 500;
		color: var(--text-dim);
		border: 1px solid var(--border2);
	}
	.db-btn-ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.db-tiles {
		display: flex;
		gap: 10px;
	}
	.db-tile {
		width: 86px;
		height: 106px;
		flex: none;
		border-radius: 16px;
		border: 1px solid var(--border2);
		filter: saturate(0.85);
		transition: transform 0.4s cubic-bezier(0.2, 0.85, 0.2, 1), filter 0.4s;
	}
	.db-tile:hover {
		transform: translateY(-8px) rotate(0deg) !important;
		filter: saturate(1.25);
	}

	/* ─── Marquee strip ─── */
	.db-strip {
		position: relative;
		overflow: hidden;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}
	.db-marquee {
		display: flex;
		width: max-content;
		animation: dbMarquee 28s linear infinite;
	}
	.db-marquee-track {
		display: flex;
		align-items: center;
		gap: 32px;
		padding: 12px 16px;
	}
	.db-tick {
		font-size: 11.5px;
		letter-spacing: 0.8px;
		text-transform: uppercase;
		white-space: nowrap;
		font-weight: 500;
		color: var(--text-dim);
	}
	.db-tick-diamond {
		font-weight: 700;
		color: var(--accent);
	}

	/* ─── Brand ─── */
	.db-brand-col {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.db-brand {
		display: flex;
		align-items: center;
		gap: 13px;
		text-decoration: none;
		color: inherit;
	}
	.db-brand:hover .db-brand-name {
		color: var(--accent);
	}
	.db-mark {
		position: relative;
		width: 52px;
		height: 52px;
		flex: none;
		animation: dbFloat 6.5s ease-in-out infinite;
	}
	.db-mark-ring {
		animation: dbSpin 20s linear infinite;
		transform-origin: 32px 32px;
	}
	.db-mark-path {
		stroke-dasharray: 120;
		stroke-dashoffset: 120;
		animation: dbDash 2.4s cubic-bezier(0.6, 0.05, 0.3, 1) 0.35s forwards;
	}
	.db-brand-text {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.db-brand-name {
		font-size: 19px;
		font-weight: 700;
		letter-spacing: -0.2px;
		color: var(--text);
		transition: color 0.25s;
	}
	.db-brand-tag {
		font-size: 12px;
		color: var(--text-dimmer);
	}
	.db-blurb {
		margin: 0;
		max-width: 350px;
		font-size: 13.5px;
		line-height: 1.7;
		color: var(--text-dim);
		text-wrap: pretty;
	}
	.db-social {
		display: flex;
		gap: 9px;
	}
	.db-social-link {
		width: 38px;
		height: 38px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--border2);
		color: var(--text-dim);
		background: var(--card);
		transition: all 0.32s cubic-bezier(0.2, 0.85, 0.2, 1);
	}
	.db-social-link:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-3px) rotate(-7deg);
	}

	/* ─── Nav columns ─── */
	.db-cols {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 38px 24px;
	}
	.db-col {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.db-col-title {
		display: flex;
		align-items: center;
		gap: 7px;
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 1.3px;
		text-transform: uppercase;
		color: var(--text-dimmer);
	}
	.db-col-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--accent);
		animation: dbPulse 2.8s ease-in-out infinite;
	}
	.db-col-links {
		display: flex;
		flex-direction: column;
		gap: 11px;
		align-items: flex-start;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.db-col-links li {
		margin: 0;
		padding: 0;
	}
	.db-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 13.5px;
		color: var(--text-dim);
		transition: color 0.25s, transform 0.25s;
	}
	.db-link::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -3px;
		height: 1.5px;
		width: 100%;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.4s cubic-bezier(0.2, 0.85, 0.2, 1);
	}
	.db-link:hover {
		color: var(--text);
		transform: translateX(3px);
	}
	.db-link:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	/* ─── Wordmark ─── */
	.db-wordmark {
		position: relative;
		margin-top: 56px;
		cursor: crosshair;
	}
	.db-word-base,
	.db-word-lit {
		font-size: clamp(40px, 11vw, 150px);
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 0.82;
		text-align: center;
		user-select: none;
		white-space: nowrap;
	}
	.db-word-base {
		color: var(--border2);
	}
	.db-word-lit {
		position: absolute;
		inset: 0;
		color: var(--accent);
		opacity: 0;
		transition: opacity 0.35s;
		pointer-events: none;
		mask-image: radial-gradient(circle 150px at var(--mx, 50%) var(--my, 50%), #000 0%, rgba(0, 0, 0, 0.55) 55%, transparent 78%);
		-webkit-mask-image: radial-gradient(circle 150px at var(--mx, 50%) var(--my, 50%), #000 0%, rgba(0, 0, 0, 0.55) 55%, transparent 78%);
	}
	.db-wordmark.db-hot .db-word-lit {
		opacity: 1;
	}
	.db-word-hint {
		position: absolute;
		left: 50%;
		bottom: -2px;
		transform: translateX(-50%);
		font-size: 10.5px;
		letter-spacing: 1.4px;
		text-transform: uppercase;
		color: var(--text-dimmer);
		pointer-events: none;
		white-space: nowrap;
	}

	/* ─── Legal ─── */
	.db-legal {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px 24px;
		margin-top: 40px;
		padding: 20px 0 26px;
		border-top: 1px solid var(--border);
	}
	.db-copy {
		font-size: 12px;
		color: var(--text-dimmer);
	}
	.db-legal-links {
		display: inline-flex;
		gap: 8px;
		align-items: center;
	}
	.db-legal-link {
		font-size: 12px;
		color: var(--text-dimmer);
		transition: color 0.25s;
	}
	.db-legal-link:hover {
		color: var(--text);
	}
	.db-legal-sep {
		color: var(--text-dimmer);
		font-size: 10px;
	}
	.db-status {
		display: flex;
		align-items: center;
		gap: 7px;
		font-size: 12px;
		color: var(--text-dim);
	}

	/* ─── Keyframes ─── */
	@keyframes dbMarquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}
	@keyframes dbDash {
		to { stroke-dashoffset: 0; }
	}
	@keyframes dbSpin {
		to { transform: rotate(360deg); }
	}
	@keyframes dbFloat {
		0% { transform: translateY(0) rotate(-3deg); }
		50% { transform: translateY(-8px) rotate(3deg); }
		100% { transform: translateY(0) rotate(-3deg); }
	}
	@keyframes dbPulse {
		0% { opacity: 0.3; transform: scale(0.65); }
		50% { opacity: 1; transform: scale(1); }
		100% { opacity: 0.3; transform: scale(0.65); }
	}
	@keyframes dbSheen {
		0% { background-position: -140% 0; }
		60%, 100% { background-position: 240% 0; }
	}
	@keyframes dbNudge {
		0%, 100% { transform: translateX(0); }
		50% { transform: translateX(4px); }
	}

	/* ─── Mobile overrides for sub-components ─── */
	@media (max-width: 720px) {
		.db-cta {
			flex-direction: column;
			align-items: flex-start;
			gap: 24px;
			padding-bottom: 28px;
		}
		.db-headline {
			font-size: 24px;
			line-height: 1.12;
		}
		.db-cta-actions {
			width: 100%;
		}
		.db-btn {
			height: 44px;
			padding: 0 16px;
			font-size: 13px;
			border-radius: 11px;
		}
		.db-btn-primary {
			flex: 1;
			justify-content: center;
		}
		.db-tiles {
			display: none;
		}
		.db-marquee-track {
			padding: 10px 12px;
			gap: 20px;
		}
		.db-tick {
			font-size: 10px;
			letter-spacing: 0.6px;
		}
		.db-cols {
			grid-template-columns: 1fr;
			gap: 24px;
		}
		.db-col {
			gap: 10px;
			padding-bottom: 16px;
			border-bottom: 1px solid var(--border);
		}
		.db-col:last-child {
			border-bottom: none;
			padding-bottom: 0;
		}
		.db-col-links {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px 16px;
		}
		.db-link {
			font-size: 14px;
			min-height: 36px;
			align-items: center;
		}
		.db-brand-col {
			gap: 14px;
		}
		.db-mark {
			width: 40px;
			height: 40px;
		}
		.db-mark svg {
			width: 40px;
			height: 40px;
		}
		.db-brand-name {
			font-size: 17px;
		}
		.db-blurb {
			font-size: 13px;
			line-height: 1.6;
		}
		.db-social-link {
			width: 44px;
			height: 44px;
		}
		.db-wordmark {
			margin-top: 36px;
		}
		.db-word-base,
		.db-word-lit {
			font-size: clamp(36px, 13vw, 60px);
		}
		.db-word-hint {
			display: none;
		}
		.db-word-lit {
			opacity: 0.25;
			mask-image: radial-gradient(ellipse 70% 100% at 50% 50%, #000 0%, transparent 78%);
			-webkit-mask-image: radial-gradient(ellipse 70% 100% at 50% 50%, #000 0%, transparent 78%);
		}
		.db-legal {
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
			margin-top: 28px;
			padding: 16px 0 env(safe-area-inset-bottom, 20px);
		}
	}

	@media (max-width: 390px) {
		.db-headline {
			font-size: 21px;
		}
		.db-cta-actions {
			flex-direction: column;
			gap: 8px;
		}
		.db-btn-ghost {
			justify-content: center;
		}
		.db-col-links {
			grid-template-columns: 1fr;
		}
		.db-word-base,
		.db-word-lit {
			font-size: 32px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.db-marquee,
		.db-mark,
		.db-mark-ring,
		.db-mark-path,
		.db-dot-pulse,
		.db-col-dot,
		.db-btn-primary,
		.db-btn-primary svg {
			animation: none !important;
		}
	}
</style>
