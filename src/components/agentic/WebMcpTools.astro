---
/**
 * WebMcpTools — exposes Doodle AI's read-only capabilities to AI agents via WebMCP.
 *
 * WebMCP (W3C Community Group Draft, 10 Feb 2026) lets a page hand an agentic
 * browser a set of callable tools instead of making it scrape the DOM. Lighthouse's
 * Agentic Browsing category audits three things: that tools are registered, that
 * their schemas are valid, and that forms carry annotations. The form annotations
 * are declarative and live on the forms themselves (FeedbackDialog, /boards); this
 * file owns the imperative half.
 *
 * ## Google's hard limits, and the trap this file fell into once
 *
 * The tool-security doc publishes character budgets: 30 per tool/parameter name,
 * 500 per tool description, 150 per parameter description, and **1,500 per single
 * tool output**. The first version of this file blew the output ceiling on four of
 * five tools — measured 7,028 / 6,576 / 4,379 / ~3,300 characters — because
 * returning a whole document is the obvious thing to write and it is wrong.
 *
 * Every tool below is therefore budgeted BY CONSTRUCTION: `cap()` is the last thing
 * applied to every return value, so no data shape can push a response over the
 * ceiling. `get_doodle_full_docs` was deleted rather than trimmed: a tool whose
 * entire purpose is "return everything" cannot honour a 1,500-char contract, and
 * `search_doodle_articles` + `get_doodle_article` cover the same need properly.
 *
 * ## Two API details that are easy to get wrong
 *
 * 1. The entry point is `document.modelContext`. Chrome's docs use it exclusively;
 *    `navigator.modelContext` is the older origin-trial shape, probed only as a
 *    fallback. Getting this backwards registers nothing on current builds.
 * 2. `execute` receives TWO arguments — `(args, { signal })`. That AbortSignal must
 *    reach every `fetch`, or a cancelled tool call leaves our request running.
 *
 * ## What is exposed, and what deliberately is not
 *
 * Read-only, unauthenticated, zero-cost things only. NOT exposed: generation,
 * upload, or anything touching account state. Every runnable skill reserves at
 * least one credit per image, so a generation tool would let whatever is driving
 * the browser bill a signed-in user's balance from a tool call. Generation is
 * reachable by NAVIGATION only, so a human presses send.
 *
 * No polyfill when the API is absent: the audits check for real registration, and
 * a stub object would only lie about it. WebMCP is an origin trial behind flags in
 * Chrome and Edge, so on most browsers this correctly does nothing.
 */
import { SKILLS } from '../../lib/skills';
import { imageCountForSkill } from '../../lib/credits/costs';

const runnable = SKILLS.filter((s) => s.runnable);

/* Serialised at build time rather than fetched: the catalogue tool then answers
   with no network round trip and cannot disagree with the rendered page. */
const skillCatalogue = runnable.map((skill) => ({
  id: skill.id,
  name: skill.name,
  tagline: skill.tagline,
  url: `/skills/${skill.id}/`,
  requiresPhoto: skill.requiresPhoto,
  aspectRatio: skill.aspectRatio,
  images: imageCountForSkill(skill.id),
}));

/* A short factual summary, NOT the 7,028-char /llms.txt. Agents that want the full
   text are pointed at the URL instead of being handed it. */
const overview = [
  'Doodle AI (doodleai.art) is a chat-first creative studio that turns a photo or a',
  'description into hand-drawn doodle art — avatars, collages, sticker sheets, pet',
  'portraits, couple portraits and gift cards.',
  `${runnable.length} skills are runnable today.`,
  'Browsing is open; signing in with Google is required to upload or generate.',
  'New accounts get a signup credit grant. Single-image skills cost 1 credit; pack',
  'skills cost 1 credit per image returned. Failed generations are refunded.',
  'Users never supply an API key — generation runs on a server-owned connection.',
  'Full text: /llms.txt (site summary) and /llms-full.txt (every page).',
].join(' ');
---

<script type="application/json" id="webmcpSkills" set:html={JSON.stringify(skillCatalogue)}></script>
<script type="application/json" id="webmcpOverview" set:html={JSON.stringify(overview)}></script>

<script>
  import {
    contentTools,
    withTextEnvelope,
    type WebMcpToolDef,
    type WebMcpRegistrableTool,
  } from './tools-content';
  import { selectTools, always, prefix, type ToolBundle } from './registry';
  import articleBundle from './tools-articles';
  import discoveryBundle from './tools-discovery';
  import skillsBundle from './tools-skills';
  import learnBundle from './tools-learn';

  interface Skill {
    id: string;
    name: string;
    tagline: string;
    url: string;
    requiresPhoto: boolean;
    aspectRatio: string;
    images: number;
  }

  interface ModelContext {
    registerTool: (
      tool: WebMcpRegistrableTool,
      options?: { signal?: AbortSignal },
    ) => Promise<unknown>;
  }

  /**
   * `?webmcpDebug=1` prints what happened to the console.
   *
   * The full record always lands on `window.__doodleWebMcp` (see `initWebMcp`);
   * this only decides whether to also narrate it. It exists because the failure
   * this file is most often accused of — "no tools registered" in the DevTools
   * WebMCP panel — is usually a browser without the flag, and that is
   * indistinguishable from a real bug unless the page says so out loud.
   */
  function debugEnabled(): boolean {
    try {
      return new URLSearchParams(window.location.search).has('webmcpDebug');
    } catch {
      return false;
    }
  }

  /** Google's ceiling for a single tool output. Applied to every return value. */
  const HARD_CAP = 1500;

  /** Last thing applied to every response, so no data shape can exceed the ceiling. */
  function cap(text: string, max = HARD_CAP): string {
    if (text.length <= max) return text;
    return `${text.slice(0, max - 1).trimEnd()}…`;
  }

  /* Chrome 150+ exposes this on `document`; `navigator` is the deprecated
     origin-trial shape. Probe newest first, and do NOT polyfill when absent. */
  function resolveModelContext(): ModelContext | null {
    const fromDocument = (document as unknown as { modelContext?: ModelContext }).modelContext;
    if (typeof fromDocument?.registerTool === 'function') return fromDocument;
    const fromNavigator = (navigator as unknown as { modelContext?: ModelContext }).modelContext;
    if (typeof fromNavigator?.registerTool === 'function') return fromNavigator;
    return null;
  }

  function readJson<T>(id: string, fallback: T): T {
    const node = document.getElementById(id);
    if (!node?.textContent) return fallback;
    try {
      return JSON.parse(node.textContent) as T;
    } catch {
      return fallback;
    }
  }

  const skills = (): Skill[] => readJson<Skill[]>('webmcpSkills', []);

  function describeSkill(s: Skill): string {
    const photo = s.requiresPhoto ? 'needs a photo' : 'no photo needed';
    const imgs = `${s.images} image${s.images === 1 ? '' : 's'}`;
    const cost = `${s.images} credit${s.images === 1 ? '' : 's'}`;
    return `${s.name} (${s.id}) — ${s.tagline}. ${photo}; ${imgs} at ${s.aspectRatio}; ${cost}.`;
  }

  function initWebMcp(): void {
    /* Diagnostics live on window so this is inspectable in ANY browser's console
       (`__doodleWebMcp`), including one where the API is absent. Without this a
       failed registration is invisible: the page looks fine, DevTools' WebMCP
       panel just says "no tools registered", and there is nothing to point at.
       Chrome exposes WebMCP only behind chrome://flags/#enable-webmcp-testing or
       a valid origin-trial token, so "absent" is the common, expected case and
       must be distinguishable from "present but rejected". */
    const diag = {
      apiPresent: false,
      apiSurface: 'none' as 'none' | 'document' | 'navigator',
      secureContext: window.isSecureContext,
      /* registerTool rejects with SecurityError unless the agent cluster is
         origin-keyed, so this is the first thing to check on a real failure. */
      originAgentCluster: (window as unknown as { originAgentCluster?: boolean }).originAgentCluster,
      bundles: [] as string[],
      duplicates: [] as string[],
      registered: [] as string[],
      failed: [] as { tool: string; error: string }[],
      reason: '',
    };
    (window as unknown as { __doodleWebMcp?: typeof diag }).__doodleWebMcp = diag;

    const modelContext = resolveModelContext();
    if (!modelContext) {
      diag.reason =
        'document.modelContext is not exposed by this browser. Enable ' +
        'chrome://flags/#enable-webmcp-testing and relaunch, or serve a valid WebMCP ' +
        'origin-trial token for this origin. The page did nothing wrong.';
      return;
    }
    diag.apiPresent = true;
    diag.apiSurface = (document as unknown as { modelContext?: unknown }).modelContext
      ? 'document'
      : 'navigator';

    /* Guard against double registration across a bfcache restore. */
    const flag = window as unknown as { __doodleWebMcpReady?: boolean };
    if (flag.__doodleWebMcpReady) return;
    flag.__doodleWebMcpReady = true;

    const controller = new AbortController();
    const options = { signal: controller.signal };

    /* Every inputSchema is a complete JSON Schema — `type`, `properties`, explicit
       `required`. A bare {} or a missing `type` fails webmcp-schema-validity. */
    const coreTools: WebMcpToolDef[] = [
      {
        name: 'list_doodle_skills',
        description:
          'List Doodle AI generation skills: id, what each produces, whether it needs a photo, ' +
          'how many images it returns and its credit cost. Returns a page of results, not the ' +
          'whole catalogue — narrow with requiresPhoto or raise limit. Call this before ' +
          'suggesting a skill, so the suggestion names one that exists.',
        inputSchema: {
          type: 'object',
          properties: {
            requiresPhoto: {
              type: 'boolean',
              description:
                'Only skills that need an input photo (true), or that work from a text ' +
                'description alone (false). Omit for both.',
            },
            limit: {
              type: 'integer',
              description: 'How many skills to return, 1 to 8. Defaults to 6.',
            },
          },
          required: [],
        },
        annotations: { readOnlyHint: true, untrustedContentHint: false },
        execute: async (args) => {
          const { requiresPhoto, limit } = args as { requiresPhoto?: boolean; limit?: number };
          const all = skills();
          if (all.length === 0) return 'Skill catalogue unavailable on this page. Open /skills/ instead.';

          const matched =
            typeof requiresPhoto === 'boolean'
              ? all.filter((s) => s.requiresPhoto === requiresPhoto)
              : all;
          if (matched.length === 0) {
            return `No skills match requiresPhoto=${String(requiresPhoto)}. Omit the filter to see all ${all.length}.`;
          }

          const take = Math.min(Math.max(Math.trunc(limit ?? 6) || 6, 1), 8);
          const shown = matched.slice(0, take);
          const lines = shown.map(describeSkill);
          const remaining = matched.length - shown.length;
          if (remaining > 0) {
            lines.push(`(+${remaining} more of ${matched.length}. Raise limit, or open /skills/.)`);
          }
          return cap(lines.join('\n'));
        },
      },
      {
        name: 'get_doodle_skill',
        description:
          'Full detail for one Doodle AI skill by id: what it makes, whether a photo is ' +
          'required, output aspect ratio, how many images it returns, its credit cost and its ' +
          'page URL. Use after list_doodle_skills when the user has picked one.',
        inputSchema: {
          type: 'object',
          properties: {
            id: {
              type: 'string',
              description: 'Skill id exactly as returned by list_doodle_skills, e.g. "normal".',
            },
          },
          required: ['id'],
        },
        annotations: { readOnlyHint: true, untrustedContentHint: false },
        execute: async (args) => {
          const id = String((args as { id?: unknown }).id ?? '').trim();
          if (!id) return 'Missing "id". Call list_doodle_skills to get valid skill ids.';
          const match = skills().find((s) => s.id === id);
          if (!match) {
            return `No skill with id "${id}". Call list_doodle_skills first for valid ids.`;
          }
          return cap(
            `${describeSkill(match)}\nPage: https://doodleai.art${match.url}\n` +
              'Generating requires signing in and spends the credits shown. Open the page and ' +
              'let the person press send — this tool cannot generate.',
          );
        },
      },
      {
        name: 'get_doodle_overview',
        description:
          'A short factual summary of what Doodle AI is, how sign-in and credits work, and how ' +
          'many skills exist. Read this before answering questions about the product. For the ' +
          'complete site text, fetch /llms.txt or /llms-full.txt directly.',
        inputSchema: { type: 'object', properties: {}, required: [] },
        annotations: { readOnlyHint: true, untrustedContentHint: false },
        execute: async () =>
          cap(readJson<string>('webmcpOverview', 'Overview unavailable. Fetch /llms.txt instead.')),
      },
      {
        name: 'get_doodle_status',
        description:
          'Live operational status of Doodle AI and the upstream services it depends on. ' +
          'Returns the overall state plus only the components that are NOT healthy. Public and ' +
          'unmetered. Check this before telling someone the product is broken.',
        inputSchema: { type: 'object', properties: {}, required: [] },
        /* untrustedContentHint: the note/detail strings describe THIRD-PARTY service
           responses, which is externally-sourced data an agent must scrutinise. */
        annotations: { readOnlyHint: true, untrustedContentHint: true },
        execute: async (_args, context) => {
          try {
            const response = await fetch('/api/status', {
              headers: { Accept: 'application/json' },
              signal: context?.signal,
            });
            if (!response.ok) {
              return `Status endpoint returned ${response.status}. Try again shortly, or open /status/.`;
            }
            const data = (await response.json()) as {
              summary?: { state?: string; headline?: string; detail?: string } | string;
              checkedAt?: string;
              components?: { name?: string; state?: string; note?: string }[];
            };
            const components = data.components ?? [];
            /* `summary` is an OBJECT ({state, headline, detail, counts}), not a
               string — a live Canary run printed "[object Object] — 9/16
               operational" before this was handled. Narrow it explicitly. */
            const s = data.summary;
            const headline =
              typeof s === 'string' ? s : (s?.headline ?? s?.state ?? 'Status');
            /* Summarised, never dumped: the raw payload is ~6.5 KB because each of
               16 components carries a 90-day history array. */
            const unhealthy = components.filter((c) => c.state && c.state !== 'operational');
            const counts = `${components.length - unhealthy.length}/${components.length} operational`;
            const head = `${headline} — ${counts}, checked ${data.checkedAt ?? 'recently'}.`;
            if (unhealthy.length === 0) return cap(`${head} All components healthy.`);
            const detail = unhealthy
              .slice(0, 6)
              .map((c) => `${c.name ?? 'component'}: ${c.state}${c.note ? ` (${c.note})` : ''}`)
              .join('; ');
            return cap(`${head} Not healthy — ${detail}. Full detail at /status/.`);
          } catch {
            return 'Could not reach the status endpoint. Open /status/ to check manually.';
          }
        },
      },
      {
        name: 'open_doodle_page',
        description:
          'Navigate this tab to a public Doodle AI page — use it to put a person in front of ' +
          'the composer or a skill page. It only navigates: it never generates an image and ' +
          'never spends a credit, so a human still presses send.',
        inputSchema: {
          type: 'object',
          properties: {
            page: {
              type: 'string',
              enum: ['home', 'skills', 'learn', 'about', 'status', 'boards'],
              description: "Which page to open. 'home' is the composer where doodles are made.",
            },
            skillId: {
              type: 'string',
              description:
                "Optional skill id from list_doodle_skills. When set, opens that skill's page and 'page' is ignored.",
            },
          },
          required: ['page'],
        },
        annotations: { readOnlyHint: true, untrustedContentHint: false },
        execute: async (args) => {
          const { page, skillId } = args as { page?: string; skillId?: string };

          if (skillId) {
            /* Resolved against the catalogue rather than interpolated into a path,
               so an arbitrary string can never become a navigation target. */
            const match = skills().find((s) => s.id === skillId);
            if (!match) return `No skill with id "${skillId}". Call list_doodle_skills first.`;
            window.location.assign(match.url);
            return `Opening the ${match.name} skill page.`;
          }

          const routes: Record<string, string> = {
            home: '/',
            skills: '/skills/',
            learn: '/learn/',
            about: '/about/',
            status: '/status/',
            boards: '/boards',
          };
          const target = page ? routes[page] : undefined;
          if (!target) {
            return `Unknown page "${page ?? ''}". Valid values: ${Object.keys(routes).join(', ')}.`;
          }
          window.location.assign(target);
          return `Opening ${target}.`;
        },
      },
      ...contentTools,
    ];

    /* ROUTE SCOPING — see registry.ts for why this is not one global set.
       Chrome's WebMCP guidance is per-route registration: a longer tool list
       measurably lowers an agent's tool-selection accuracy, and until now every
       tool registered on every route including /admin.

       `get_doodle_status` is pulled out of the global core by NAME rather than
       by moving its definition, so the object literal above stays where it is
       and this stays a one-line change if it ever moves back. */
    const statusTools = coreTools.filter((t) => t.name === 'get_doodle_status');
    const globalCore = coreTools.filter((t) => t.name !== 'get_doodle_status');

    /* Order matters only for duplicate resolution: the first bundle to claim a
       name wins, so the core is listed first and route-scoped bundles
       specialise around it rather than silently shadowing it. */
    const bundles: ToolBundle[] = [
      { id: 'core', appliesTo: always, tools: globalCore },
      { id: 'status', appliesTo: prefix('/status'), tools: statusTools },
      articleBundle,
      discoveryBundle,
      learnBundle,
      skillsBundle,
    ];

    const selection = selectTools(bundles, window.location.pathname);
    diag.bundles = selection.bundles;
    diag.duplicates = selection.duplicates;

    if (selection.excluded) {
      /* /admin, /s/<token> and /join/<token> get no agent surface at all. */
      diag.reason = 'Route is excluded from WebMCP registration by policy.';
      return;
    }

    /* SPEC RETURN SHAPE — the one thing this file previously got wrong at the
       protocol level. The WebMCP explainer's execute callback resolves to an
       MCP-style content envelope:

           return { content: [{ type: "text", text: "…" }] };

       Every tool body above returns a PLAIN STRING, which Chrome tolerates
       (executeTool resolves to a serialised result either way) — but a host that
       unwraps `content[]` gets an opaque blob instead of text, and there is no
       way to signal `isError`. `withTextEnvelope` adapts each body at this single
       point, so the `cap()` budget still measures the text a model reads while
       the wire shape is what the spec and the reference demo both use. Wrapping
       here rather than in 7 tool bodies means a newly added tool cannot ship in
       the old shape by accident. */
    for (const tool of selection.tools) {
      void modelContext.registerTool(withTextEnvelope(tool), options).then(
        () => {
          diag.registered.push(tool.name);
        },
        (err: unknown) => {
          /* A browser that exposes modelContext but rejects one tool should not take
             the page down with it — but the rejection must still be visible, since
             a silent catch is what makes this class of bug undiagnosable. The name
             matters: SecurityError means the agent cluster is not origin-keyed,
             NotAllowedError means the `tools` Permissions Policy blocked it, and
             InvalidStateError means a duplicate name or an invalid schema. */
          const name = (err as { name?: string })?.name ?? 'Error';
          const message = (err as { message?: string })?.message ?? String(err);
          diag.failed.push({ tool: tool.name, error: `${name}: ${message}` });
          diag.reason = 'At least one registerTool call was rejected — see failed[].';
        },
      );
    }

    if (debugEnabled()) {
      /* Registration promises settle after this turn, so report on a microtask. */
      void Promise.resolve().then(() => {
        console.info(
          `[WebMCP] ${diag.registered.length}/${selection.tools.length} imperative tools registered ` +
            `via ${diag.apiSurface}.modelContext`,
          diag.registered,
        );
        if (diag.failed.length > 0) console.warn('[WebMCP] rejected:', diag.failed);
      });
    }

    window.addEventListener(
      'pagehide',
      () => {
        controller.abort();
        flag.__doodleWebMcpReady = false;
      },
      { once: true },
    );
  }

  initWebMcp();
</script>
