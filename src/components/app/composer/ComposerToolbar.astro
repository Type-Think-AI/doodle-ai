---
/* The style swatches are a "Style Gallery": the four THEMES each inject a
   styleHint into the generation prompt (src/mastra/tools/generate-doodle.ts),
   but the only way to choose one used to be a <select> buried in /settings, so
   a real creative dial was invisible at the moment of creation. The swatches
   write the same localStorage key that getStyleId() reads, so no request
   plumbing changes.

   This slot previously held an "Auto / Fast / Fine" dropdown that was purely
   cosmetic — it had no backend concept and was never sent with the request. */
import { THEMES, STYLE_THEME_STORAGE_KEY } from "../../../lib/doodle-constants";
import { STYLE_NONE } from "../../../lib/style-choice";

interface Props {
  id: string;
}
const { id } = Astro.props;

/**
 * One short line per style for the menu row.
 *
 * Derived from each theme's own `styleHint` rather than added as a new field on
 * THEMES, because `doodle-constants.ts` has uncommitted edits from other work in
 * flight and this component should not need to touch it. The derivation drops
 * the parenthetical colour list first (it contains commas, so splitting on comma
 * alone would cut mid-list) and then keeps the opening clause:
 *
 *   "Soft pastel palette (blush pink, buttery cream, sky blue), gentle …"
 *     -> "Soft pastel palette"
 */
function blurbFor(styleHint: string): string {
  const withoutParens = styleHint.replace(/\s*\([^)]*\)/g, "");
  const clause = withoutParens.split(",")[0]!.trim().replace(/\.$/, "");
  return clause.length > 52 ? `${clause.slice(0, 51).trimEnd()}…` : clause;
}

const STYLE_OPTIONS = THEMES.map((theme) => ({
  id: theme.id,
  label: theme.label,
  bg: theme.bg,
  accent: theme.accent,
  blurb: blurbFor(theme.styleHint),
}));
---

<div class="composer-toolbar">
  <!-- ONE entry point for media. The photo and camera buttons that used to sit
       here are not gone — they moved inside ComposerMediaDialog.astro with their
       ids intact, alongside the user's existing uploads and generations. Two
       permanent icons became one, and gained a library. -->
  <button class="composer-icon-btn composer-plus" id={`${id}PlusBtn`} type="button" aria-label="Add media" aria-haspopup="dialog">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5.5v13M5.5 12h13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
  </button>
  <button class="composer-icon-btn" id={`${id}CharacterBtn`} type="button" aria-label="Mention a character">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.4" stroke="currentColor" stroke-width="1.6"></circle><circle cx="12" cy="10.4" r="2.7" stroke="currentColor" stroke-width="1.6"></circle><path d="M6.9 18.3c1.1-2.1 3-3.2 5.1-3.2s4 1.1 5.1 3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
  </button>
  <button class="composer-icon-btn" id={`${id}SkillBtn`} type="button" aria-label="Use a skill">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3.6 1.85 4.55L18.4 10l-4.55 1.85L12 16.4l-1.85-4.55L5.6 10l4.55-1.85L12 3.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="m18.2 15.4.75 1.85 1.85.75-1.85.75-.75 1.85-.75-1.85-1.85-.75 1.85-.75.75-1.85Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
  </button>
  <input type="file" id={`${id}FileInput`} accept="image/*" hidden />

  <div
    class="composer-style"
    id={`${id}Style`}
    data-style-key={STYLE_THEME_STORAGE_KEY}
  >
    <!-- A settings icon, not a labelled "Neon" pill. The pill spent the widest
         slot in the bar on a value the user sets once and rarely changes, and it
         read as the composer's main control rather than a preference. It is now
         an icon that carries the active palette as a small dot — the state stays
         visible, the width goes back to the prompt. Ids are unchanged so the
         existing menu script and localStorage key keep working untouched. -->
    <button
      type="button"
      class="composer-style-trigger"
      id={`${id}StyleBtn`}
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Settings"
      title="Doodle style"
    >
      <svg class="composer-settings-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h9M17.5 8H19M5 16h3M11.5 16H19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path><circle cx="15.6" cy="8" r="2.1" stroke="currentColor" stroke-width="1.7"></circle><circle cx="9.6" cy="16" r="2.1" stroke="currentColor" stroke-width="1.7"></circle></svg>
      <span class="composer-style-chip composer-style-chip-mini" id={`${id}StyleChip`} aria-hidden="true">
        <span class="composer-style-chip-dot"></span>
      </span>
      <span class="composer-style-label sr-only" id={`${id}StyleLabel`}></span>
    </button>

    <div class="composer-style-menu" id={`${id}StyleMenu`} hidden role="menu" aria-label="Doodle style">
      <p class="composer-style-menu-title">Doodle style</p>
      {STYLE_OPTIONS.map((theme) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked="false"
          class="composer-style-item"
          data-style-id={theme.id}
          data-style-label={theme.label}
          style={`--swatch-bg:${theme.bg};--swatch-accent:${theme.accent}`}
        >
          <span class="composer-style-chip" aria-hidden="true">
            <span class="composer-style-chip-dot"></span>
            <span class="composer-style-chip-line"></span>
          </span>
          <span class="composer-style-item-text">
            <span class="composer-style-item-label">{theme.label}</span>
            <span class="composer-style-item-sub">{theme.blurb}</span>
          </span>
          <span class="composer-style-check" aria-hidden="true">✓</span>
        </button>
      ))}

      <div class="composer-style-sep" role="separator"></div>

      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        class="composer-style-item"
        data-style-id={STYLE_NONE}
        data-style-label="None"
      >
        <span class="composer-style-chip composer-style-chip-empty" aria-hidden="true"></span>
        <span class="composer-style-item-text">
          <span class="composer-style-item-label">None</span>
          <span class="composer-style-item-sub">No colour theme — keep it natural</span>
        </span>
        <span class="composer-style-check" aria-hidden="true">✓</span>
      </button>

      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        class="composer-style-item"
        data-style-id="custom"
        data-style-label="Custom"
        id={`${id}StyleCustomBtn`}
      >
        <span class="composer-style-chip" id={`${id}StyleCustomChip`} aria-hidden="true">
          <span class="composer-style-chip-dot"></span>
          <span class="composer-style-chip-line"></span>
        </span>
        <span class="composer-style-item-text">
          <span class="composer-style-item-label">Custom</span>
          <span class="composer-style-item-sub">Pick your own colour</span>
        </span>
        <span class="composer-style-check" aria-hidden="true">✓</span>
      </button>

      <div class="composer-style-custom" id={`${id}StyleCustomPanel`} hidden>
        <input
          type="range"
          min="0"
          max="359"
          step="1"
          value="42"
          class="composer-style-hue"
          id={`${id}StyleHue`}
          aria-label="Pick a colour"
        />
        <output class="composer-style-hex" id={`${id}StyleHex`} for={`${id}StyleHue`}></output>
      </div>
    </div>
  </div>

  <!-- The expand button is deliberately gone. It duplicated a gesture the box
       already has two better versions of — the drag grabber above the text and
       ⌘/Ctrl+Enter (still bound, still listed in the hint row) — and it sat in
       the send button's neighbourhood competing for the same glance. -->
  <span class="composer-spacer"></span>
  <button class="composer-stop" id={`${id}StopBtn`} type="button" aria-label="Stop generation" hidden>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><rect x="6.5" y="6.5" width="11" height="11" rx="2.5" fill="currentColor"/></svg>
  </button>
  <button class="composer-send" id={`${id}Send`} type="button" aria-label="Send">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 19.5V5m0 0-6.2 6.2M12 5l6.2 6.2" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
</div>

<div class="mention-popover" id={`${id}MentionPopover`} hidden></div>
