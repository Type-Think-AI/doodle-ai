---
/**
 * Keyboard shortcut hints row below the composer box.
 * Hidden in compact variant via CSS (.composer-compact .composer-hints).
 */
---

<div class="composer-hints">
  <span class="composer-hint"><kbd>⏎</kbd>Send</span>
  <span class="composer-hint-sep">·</span>
  <span class="composer-hint"><kbd>⇧⏎</kbd>Newline</span>
  <span class="composer-hint-sep">·</span>
  <span class="composer-hint"><kbd>@</kbd>Character</span>
  <span class="composer-hint-sep">·</span>
  <span class="composer-hint"><kbd>/</kbd>Skill</span>
  <span class="composer-hint-sep">·</span>
  <span class="composer-hint"><kbd>⌘⏎</kbd>Expand</span>
</div>
