---
/**
 * ChatSplitLayout — the resizable chat + canvas split pane.
 * Extracted from /pages/c/[id].astro to keep the page under 150 LOC.
 * Owns the split layout structure and its scoped styles; the page owns
 * route params, global CSS imports, and the outer shell.
 */
import Lightbox from './Lightbox.astro';
import PromptComposer from './PromptComposer.astro';
import DoodleCanvas from './DoodleCanvas.tsx';
import { resolveTldrawLicenseKey } from '../../lib/tldraw-license';
// Async video clip card styles — global (targets JS-built nodes; see the file).
import '../../styles/video-card.css';

interface Props {
	threadId: string;
}

const { threadId } = Astro.props;
const tldrawLicenseKey = await resolveTldrawLicenseKey(Astro.locals);
---

<!-- data-whiteboard starts "true": the canvas is the point of this screen,
     so it is shown by default rather than hidden behind a toggle. This is
     also load-bearing — tldraw mounted inside a display:none container
     never finishes initializing (renders its container, never calls
     onMount, never accepts an image), so the canvas must be visible on
     first paint. The toggle still closes/reopens it; by then the editor
     already exists and only needs a re-measure. -->
<div
	class="chat-split"
	id="chatSplit"
	data-whiteboard="true"
	style="--bg:#141414;--stage:#0a0a0a;--surface:#141414;--surface2:#141414;--card:#1a1a1a;--card-hover:#1f1f1f;--prompt-bg:#1c1c1e;--icon-hover:#2a2a2d;--border:#262626;--border2:#292929;--border3:#3a3a3a;--hover:#1f1f1f;--text:#dddddd;--text-dim:#999999;--text-dimmer:#8a8a8a;background:#0a0a0a;color:#dddddd;"
>
	<div class="chat-page" id="chatPage" style="background:#0f0f0f;color:#dddddd;">
		<button type="button" class="whiteboard-toggle" id="whiteboardToggle" aria-pressed="true">
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18M9 9v9" stroke="currentColor" stroke-width="1.6"/></svg>
			<span>Canvas</span>
		</button>

		<div class="chat-thread" id="chatThread">
			<div class="chat-empty" id="chatEmpty">
				<h1>What should we doodle?</h1>
				<p>Attach a photo and tell me what you want, or just describe a character for a surprise.</p>
			</div>
		</div>

		<div class="chat-composer">
			<PromptComposer id="chat" variant="compact" placeholder="Describe a doodle or attach a photo" />
		</div>
	</div>

	<!-- Draggable divider between the chat column and the board. -->
	<div
		class="chat-split-handle"
		id="chatSplitHandle"
		role="separator"
		aria-orientation="vertical"
		aria-label="Resize chat and canvas"
		tabindex="0"
	></div>

	<!-- Infinite canvas (tldraw). client:only is required: tldraw is
	     browser-only and must never enter the Worker/SSR bundle. -->
	<div class="canvas-panel" id="canvasPanel">
		<div class="canvas-stage" id="canvasStage">
			<DoodleCanvas client:only="react" threadId={threadId} licenseKey={tldrawLicenseKey} />
			<div class="canvas-empty-hint" id="canvasEmptyHint">
				<p>Your doodles will appear here as you generate them.<br/>Pan, zoom, resize, draw on them — it's your infinite canvas.</p>
			</div>

			<!-- Phone-only progress signal. On a narrow screen the canvas takes the
			     whole screen and the chat column is display:none, so the card that
			     reports an animation coming to life is not on screen at all. Without
			     this the wait looks like nothing happening. Server-rendered (not
			     built in JS) so the scoped styles below actually reach it. -->
			<div class="canvas-clip-status" id="canvasClipStatus" role="status" aria-live="polite" hidden>
				<span class="canvas-clip-spinner" aria-hidden="true"></span>
				<span id="canvasClipStatusText">Bringing your doodle to life…</span>
			</div>
			<button type="button" class="canvas-close" id="whiteboardClose" aria-label="Close canvas">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
			</button>
		</div>
	</div>
</div>

<Lightbox />

<script>
	/* Drive the phone-only clip status pill from the job watcher's phase events.
	   Kept here rather than in chat/index.ts because the element belongs to this
	   component, and this way the pill works even though the chat column that
	   normally reports progress is display:none at this width.

	   The pill is only revealed by CSS inside the phone media query, so toggling
	   `hidden` at any width is harmless — no width check is duplicated in JS,
	   which keeps the breakpoint defined in exactly one place. */
	const pill = document.getElementById("canvasClipStatus");
	const pillText = document.getElementById("canvasClipStatusText");
	if (pill && pillText) {
		let clearTimer: number | undefined;
		window.addEventListener("doodleai:clip-phase", (event) => {
			const phase = (event as CustomEvent<{ phase?: string }>).detail?.phase;
			if (clearTimer) window.clearTimeout(clearTimer);

			if (phase === "rendering") {
				pillText.textContent = "Bringing your doodle to life…";
				pill.dataset.phase = "rendering";
				pill.hidden = false;
				return;
			}

			// Settled: say so briefly, then get out of the way. A permanent
			// "done" pill would sit on top of the very animation it is announcing.
			pillText.textContent = phase === "done" ? "Your animation is on the canvas." : "That didn't come out.";
			pill.dataset.phase = phase ?? "";
			pill.hidden = false;
			clearTimer = window.setTimeout(() => { pill.hidden = true; }, 4000);
		});
	}
</script>

<style>
	.chat-split {
		display: flex;
		height: 100%;
		min-height: 0;
	}
	.chat-page {
		max-width: 760px;
		margin: 0 auto;
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 0 20px;
		min-width: 0;
		transition: flex-basis 0.18s ease;
	}
	.chat-split[data-whiteboard="true"] .chat-page {
		max-width: none;
		margin: 0;
		flex: 0 0 var(--chat-split-w, 30%);
		border-right: 1px solid var(--border);
	}
	.chat-split[data-resizing="true"] .chat-page { transition: none; }
	.chat-split[data-resizing="true"] { cursor: col-resize; user-select: none; }

	.chat-split[data-whiteboard="true"] {
		--bg: #141414;
		--stage: #0a0a0a;
		--surface: #141414;
		--surface2: #141414;
		--card: #1a1a1a;
		--card-hover: #1f1f1f;
		--prompt-bg: #1c1c1e;
		--icon-hover: #2a2a2d;
		--border: #262626;
		--border2: #292929;
		--border3: #3a3a3a;
		--hover: #1f1f1f;
		--text: #dddddd;
		--text-dim: #999999;
		--text-dimmer: #8a8a8a;
		background: var(--stage);
		color: var(--text);
	}
	.chat-split[data-whiteboard="true"] .chat-page { background: var(--bg); }

	.chat-split-handle {
		display: none;
		flex: 0 0 7px;
		margin: 0 -3px;
		cursor: col-resize;
		position: relative;
		z-index: 5;
		background: transparent;
		touch-action: none;
	}
	.chat-split[data-whiteboard="true"] .chat-split-handle { display: block; }
	.chat-split-handle::after {
		content: '';
		position: absolute;
		inset: 0 3px;
		background: var(--accent);
		opacity: 0;
		transition: opacity 140ms ease-out;
	}
	.chat-split-handle:hover::after,
	.chat-split-handle:focus-visible::after,
	.chat-split[data-resizing="true"] .chat-split-handle::after { opacity: 0.55; }
	.chat-split-handle:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

	.whiteboard-toggle {
		display: flex;
		align-items: center;
		gap: 7px;
		align-self: flex-start;
		margin: 14px 0 0;
		padding: 7px 12px;
		border: 1px solid var(--border2);
		border-radius: 999px;
		background: var(--surface2);
		color: var(--text-dim);
		font-size: 12.5px;
		font-family: inherit;
		cursor: pointer;
	}
	.whiteboard-toggle:hover { color: var(--text); background: var(--hover); }
	.whiteboard-toggle[aria-pressed="true"] { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border2)); }

	.canvas-panel {
		flex: 1 1 70%;
		min-width: 0;
		display: none;
		flex-direction: column;
		overflow: hidden;
	}
	.chat-split[data-whiteboard="true"] .canvas-panel { display: flex; }

	.canvas-close {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 320;
		width: 30px;
		height: 30px;
		border: 1px solid var(--border2);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface2) 82%, transparent);
		backdrop-filter: blur(6px);
		color: var(--text-dim);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.canvas-close:hover { background: var(--hover); color: var(--text); }
	.canvas-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

	.canvas-stage {
		flex: 1;
		min-height: 0;
		min-width: 0;
		position: relative;
	}
	.canvas-empty-hint {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		z-index: 0;
	}
	.canvas-empty-hint[hidden] { display: none; }

	/* Hidden by default at every width, and only ever revealed under the phone
	   media query below — on desktop the chat column is visible and already
	   carries the real card, so a second progress indicator would be noise.
	   `display:none` is declared with !important-equivalent specificity via the
	   [hidden] attribute selector paired with the class, because a bare [hidden]
	   is only a UA-level rule and the author `display:flex` here would outrank it. */
	.canvas-clip-status { display: none; }
	.canvas-clip-status[hidden] { display: none; }
	.canvas-clip-spinner {
		width: 13px;
		height: 13px;
		border: 2px solid var(--border3);
		border-top-color: var(--text);
		border-radius: 50%;
		animation: canvas-clip-spin 0.9s linear infinite;
		flex: 0 0 auto;
	}
	@keyframes canvas-clip-spin { to { transform: rotate(360deg); } }
	@media (prefers-reduced-motion: reduce) {
		.canvas-clip-spinner { animation: none; }
	}
	/* A settled clip is not still working — a spinner next to "your animation is
	   on the canvas" would contradict the message it sits beside. */
	.canvas-clip-status[data-phase="done"] .canvas-clip-spinner,
	.canvas-clip-status[data-phase="failed"] .canvas-clip-spinner { display: none; }
	.canvas-empty-hint p {
		text-align: center;
		font-size: 13px;
		line-height: 1.6;
		color: var(--text-dimmer);
		max-width: 320px;
	}

	@media (max-width: 860px) {
		.chat-split[data-whiteboard="true"] .chat-page { display: none; }
		.chat-split[data-whiteboard="true"] .canvas-panel { flex: 1 1 auto; width: 100%; }
		.chat-split[data-whiteboard="true"] .chat-split-handle { display: none; }
		.canvas-close { width: 44px; height: 44px; top: 10px; right: 10px; }
		.chat-split[data-whiteboard="true"] { min-height: calc(100dvh - var(--mobile-nav-h, 72px)); }

		/* Only on a phone, and only while the board is the visible surface. */
		.chat-split[data-whiteboard="true"] .canvas-clip-status:not([hidden]) {
			display: flex;
			align-items: center;
			gap: 9px;
			position: absolute;
			top: 10px;
			left: 10px;
			right: 64px;
			z-index: 320;
			min-height: 44px;
			padding: 10px 14px;
			border: 1px solid var(--border2);
			border-radius: 999px;
			background: color-mix(in srgb, var(--surface2) 88%, transparent);
			backdrop-filter: blur(6px);
			color: var(--text);
			font-size: 13px;
			line-height: 1.3;
		}
	}

	.chat-thread {
		flex: 1;
		overflow: auto;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 28px 0 20px;
	}
	.chat-empty {
		margin: auto;
		text-align: center;
		max-width: 420px;
	}
	.chat-empty h1 { font-size: 30px; font-weight: 500; letter-spacing: -0.02em; color: var(--text); margin: 0 0 8px; }
	.chat-empty p { font-size: 14px; color: var(--text-dimmer); margin: 0; }

	.chat-composer {
		position: sticky;
		bottom: 0;
		padding: 10px 0 22px;
		background: var(--surface);
	}

	@media (max-width: 860px) {
		.chat-page { height: auto; min-height: calc(100dvh - var(--mobile-nav-h, 72px)); }
		:global(.app-shell-content) { padding-bottom: 0; }
	}

	@media (max-width: 720px) {
		.chat-page { padding: 0 14px; }
		.chat-empty h1 { font-size: 24px; }
	}
</style>
