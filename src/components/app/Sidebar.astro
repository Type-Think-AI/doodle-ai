---
interface Props {
  active: "chat" | "skills" | "moodboards" | "characters" | "settings";
}
const { active } = Astro.props;

const navItems = [
  {
    key: "characters",
    href: "/characters",
    label: "Characters",
    icon: '<circle cx="12" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M5 20c1.3-3.8 4.3-5.8 7-5.8s5.7 2 7 5.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
  {
    key: "moodboards",
    href: "/moodboards",
    label: "Moodboards",
    icon: '<rect x="3.5" y="4.5" width="17" height="15" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 15l4.2-3.6L12 15l3-2.4 5.5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
  {
    key: "skills",
    href: "/skills",
    label: "Skills",
    icon: '<circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"/><circle cx="16" cy="16" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M10.4 10.4 13.6 13.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
  {
    key: "settings",
    href: "/settings",
    label: "Settings",
    icon: '<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 0 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 0 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 0 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.55 1H21a2 2 0 0 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1Z" stroke="currentColor" stroke-width="1.8"/>',
  },
];
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-top">
    <span class="sidebar-mark" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M2.5 15c1.5-6.5 3-9.5 4.8-9.5S9 10 11 10s2-6 4.3-6 2.6 6.8 4.2 6.8 1.5-2.3 3-2.3" stroke="var(--accent)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span class="sidebar-word">Doodle AI</span>
    <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="Collapse sidebar">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>

  <a href="/" class="sidebar-primary-action">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
    <span class="sidebar-label">New chat</span>
  </a>

  <nav class="sidebar-nav" aria-label="Main">
    {navItems.map((item) => (
      <a href={item.href} class="sidebar-link" aria-current={active === item.key ? "page" : undefined} data-active={active === item.key ? "true" : "false"}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" set:html={item.icon} />
        <span class="sidebar-label">{item.label}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-chats" id="sidebarChats">
    <div class="sidebar-chats-title sidebar-label">Recents</div>
    <div class="sidebar-chats-list" id="sidebarChatsList"></div>
  </div>

  <div class="sidebar-bottom">
    <a href="/settings?tab=billing" class="sidebar-upgrade sidebar-label">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 2.5c2.6 2.3 4.2 5.4 4.2 8.9 0 1.6-.3 3-.9 4.3l2.4 2.4-1.4 3.9-3.9-1.4-1.4 1.4-1.4-1.4-3.9 1.4-1.4-3.9 2.4-2.4c-.6-1.3-.9-2.7-.9-4.3 0-3.5 1.6-6.6 4.2-8.9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="12" cy="10.5" r="1.8" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>Upgrade to Pro</span>
    </a>

    <!-- Auth slot. Both states start hidden and the resolved one is revealed
         by sidebar.ts, so a signed-in user never sees "Sign in" flash first. -->
    <div class="sidebar-auth" id="sidebarAuth">
      <button type="button" class="sidebar-auth-signin" id="sidebarSignIn" hidden>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M15 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="sidebar-label">Sign in</span>
      </button>
      <div class="sidebar-auth-user" id="sidebarAuthUser" hidden>
        <span class="sidebar-auth-avatar" id="sidebarAuthAvatar" aria-hidden="true"></span>
        <span class="sidebar-auth-meta sidebar-label">
          <span class="sidebar-auth-name-row">
            <span class="sidebar-auth-name" id="sidebarAuthName"></span>
            <span class="sidebar-auth-plan">Free</span>
          </span>
          <span class="sidebar-auth-email" id="sidebarAuthEmail"></span>
        </span>
        <button class="sidebar-auth-signout" id="sidebarSignOut" type="button" aria-label="Sign out">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M9 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="sidebar-resize-handle" id="sidebarResizeHandle" role="separator" aria-orientation="vertical" aria-label="Resize sidebar"></div>
</aside>

<script src="../../scripts/app/sidebar.ts"></script>

<style>
  .sidebar {
    --sidebar-w: 258px;
    position: relative;
    flex: 0 0 var(--sidebar-w);
    width: var(--sidebar-w);
    background: var(--bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 16px 12px 12px;
    gap: 20px;
    transition: width 0.15s ease;
  }
  .sidebar.resizing { transition: none; }
  .sidebar.collapsed {
    --sidebar-w: 76px;
    padding: 16px 10px 12px;
  }
  .sidebar-top {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 2px 8px 0;
  }
  .sidebar-mark {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 34px;
  }
  .sidebar-word {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
  }
  .sidebar.collapsed .sidebar-word,
  .sidebar.collapsed .sidebar-label {
    display: none;
  }
  .sidebar-collapse {
    margin-left: auto;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 1px solid var(--border2);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 26px;
    transition: transform 0.15s ease;
  }
  .sidebar.collapsed .sidebar-collapse { transform: rotate(180deg); }

  .sidebar-primary-action {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border2);
    border-radius: 14px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    background: var(--surface);
    color: var(--text);
  }
  .sidebar-primary-action:hover { background: var(--hover); border-color: var(--accent); }
  .sidebar-primary-action svg { flex: 0 0 auto; }
  .sidebar.collapsed .sidebar-primary-action { justify-content: center; padding: 10px; }

  .sidebar-nav { display: flex; flex-direction: column; gap: 3px; }
  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    padding: 9px 12px;
    border: 0;
    border-radius: 12px;
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    background: transparent;
    color: var(--text-dim);
  }
  .sidebar-link:hover { background: var(--hover); color: var(--text); }
  .sidebar-link[data-active="true"] { background: var(--hover); color: var(--text); }
  .sidebar-link svg { flex: 0 0 auto; }

  .sidebar-chats {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sidebar-chats-title {
    padding: 4px 12px 4px;
    font-size: 12px;
    letter-spacing: 0;
    color: var(--text-dimmer);
    text-transform: none;
  }
  .sidebar-chats-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: auto;
    min-height: 0;
  }
  .sidebar-chat-link {
    display: block;
    padding: 7px 12px;
    border-radius: 10px;
    font-size: 13.5px;
    color: var(--text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sidebar-chat-link:hover { background: var(--hover); color: var(--text); }
  .sidebar-chat-link[data-active="true"] { background: var(--hover); color: var(--text); }
  .sidebar-chats-empty { padding: 6px 10px; font-size: 12.5px; color: var(--text-dimmer); }
  .sidebar.collapsed .sidebar-chats { display: none; }

  .sidebar-bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sidebar-upgrade {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border2));
    border-radius: 999px;
    background: var(--accent-softer, var(--accent-soft));
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }
  .sidebar-upgrade:hover { background: var(--accent-soft); }
  .sidebar.collapsed .sidebar-upgrade { padding: 9px; }

  /* :not([hidden]) rather than a plain class selector — same lesson as
     AuthDialog.astro: an unconditional `display: flex` here is an author
     rule and beats the UA stylesheet's `[hidden] { display: none }`
     regardless of specificity, so the sign-in button and the signed-in user
     card would both render at once no matter what sidebar.ts sets `.hidden`
     to. Tying display to :not([hidden]) makes the JS toggle actually work. */
  .sidebar-auth-signin:not([hidden]),
  .sidebar-auth-user:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border: 1px solid var(--border2);
    border-radius: 10px;
    color: var(--text-dim);
    font-size: 12.5px;
  }
  /* .sidebar-auth-signin is a <button> (it opens the auth dialog rather than
     navigating), so it needs the anchor-style reset .sidebar-auth-user
     doesn't. */
  .sidebar-auth-signin {
    width: 100%;
    background: none;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .sidebar-auth-signin:hover { background: var(--hover); color: var(--text); }
  .sidebar-auth-signin svg,
  .sidebar-auth-user svg { flex: 0 0 auto; }
  .sidebar-auth-avatar {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--send-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    background-size: cover;
    background-position: center;
  }
  .sidebar-auth-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .sidebar-auth-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .sidebar-auth-name,
  .sidebar-auth-email {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sidebar-auth-name { color: var(--text); min-width: 0; }
  .sidebar-auth-plan {
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--hover);
    color: var(--text-dimmer);
    font-size: 10.5px;
    font-weight: 600;
  }
  .sidebar-auth-email { font-size: 11px; color: var(--text-dimmer); }
  .sidebar.collapsed .sidebar-auth-plan { display: none; }
  .sidebar-auth-user-clickable { cursor: pointer; }
  .sidebar-auth-user-clickable:hover { background: var(--hover); color: var(--text); }
  .sidebar-auth-user-clickable:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sidebar-auth-signout {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--text-dimmer);
    padding: 2px;
    cursor: pointer;
    display: flex;
    font-family: inherit;
  }
  .sidebar-auth-signout:hover { color: var(--text); }
  /* Collapsed, only the avatar survives — the sign-out control needs the
     expanded sidebar (the mobile nav has no auth slot at all). */
  .sidebar.collapsed .sidebar-auth-signin,
  .sidebar.collapsed .sidebar-auth-user { justify-content: center; }
  .sidebar.collapsed .sidebar-auth-signout { display: none; }

  .sidebar-resize-handle {
    position: absolute;
    top: 0;
    right: -3px;
    width: 6px;
    height: 100%;
    cursor: col-resize;
    z-index: 5;
    touch-action: none;
  }
  .sidebar-resize-handle::after {
    content: "";
    position: absolute;
    top: 0;
    left: 2px;
    width: 2px;
    height: 100%;
    background: transparent;
  }
  .sidebar-resize-handle:hover::after,
  .sidebar.resizing .sidebar-resize-handle::after {
    background: var(--accent);
  }
  .sidebar.collapsed .sidebar-resize-handle { display: none; }

  @media (max-width: 860px) {
    .sidebar { display: none; }
  }
</style>
