---
interface Props {
  active: "home" | "skills" | "moodboards" | "settings";
}
const { active } = Astro.props;

const navItems = [
  {
    key: "home",
    href: "/",
    label: "New doodle",
    icon: '<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>',
  },
  {
    key: "moodboards",
    href: "/moodboards",
    label: "Moodboards",
    icon: '<rect x="3.5" y="4.5" width="17" height="15" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 15l4.2-3.6L12 15l3-2.4 5.5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
  {
    key: "skills",
    href: "/skills",
    label: "Skills",
    icon: '<circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"/><circle cx="16" cy="16" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M10.4 10.4 13.6 13.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
  {
    key: "settings",
    href: "/settings",
    label: "Settings",
    icon: '<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 0 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 0 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 0 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.55 1H21a2 2 0 0 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1Z" stroke="currentColor" stroke-width="1.8"/>',
  },
];
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-top">
    <span class="sidebar-mark" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M2.5 15c1.5-6.5 3-9.5 4.8-9.5S9 10 11 10s2-6 4.3-6 2.6 6.8 4.2 6.8 1.5-2.3 3-2.3" stroke="#3D2900" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span class="sidebar-word">DoodleBooth</span>
    <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="Collapse sidebar">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="Main">
    {navItems.map((item) => (
      <a href={item.href} class="sidebar-link" aria-current={active === item.key ? "page" : undefined} data-active={active === item.key ? "true" : "false"}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" set:html={item.icon} />
        <span class="sidebar-label">{item.label}</span>
      </a>
    ))}
    <button class="sidebar-link" id="akkuNavToggle" type="button">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="4" y="6.5" width="16" height="12" rx="4.5" stroke="currentColor" stroke-width="1.6"/><circle cx="9.5" cy="12.5" r="1.25" fill="currentColor"/><circle cx="14.5" cy="12.5" r="1.25" fill="currentColor"/><path d="M12 6.5V4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <span class="sidebar-label">Akku</span>
    </button>
  </nav>

  <div class="sidebar-bottom">
    <a class="sidebar-key-status" id="sidebarKeyStatus" href="/settings">
      <span class="sidebar-key-dot" id="sidebarKeyDot" aria-hidden="true"></span>
      <span class="sidebar-label" id="sidebarKeyLabel">Checking key…</span>
    </a>
    <button class="sidebar-theme-toggle" id="sidebarThemeToggle" type="button" aria-label="Switch theme">
      <span class="sidebar-label" id="sidebarThemeLabel">Theme</span>
    </button>
  </div>
</aside>

<script src="../../scripts/app/sidebar.ts"></script>

<style>
  .sidebar {
    --sidebar-w: 258px;
    flex: 0 0 var(--sidebar-w);
    width: var(--sidebar-w);
    background: var(--bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 16px 12px 12px;
    gap: 20px;
    transition: width 0.15s ease;
  }
  .sidebar.collapsed {
    --sidebar-w: 76px;
    padding: 16px 10px 12px;
  }
  .sidebar-top {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 2px 8px 0;
  }
  .sidebar-mark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 34px;
  }
  .sidebar-word {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
  }
  .sidebar.collapsed .sidebar-word,
  .sidebar.collapsed .sidebar-label {
    display: none;
  }
  .sidebar-collapse {
    margin-left: auto;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 1px solid var(--border2);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 26px;
    transition: transform 0.15s ease;
  }
  .sidebar.collapsed .sidebar-collapse { transform: rotate(180deg); }

  .sidebar-nav { display: flex; flex-direction: column; gap: 3px; }
  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    padding: 9px 10px;
    border: 0;
    border-radius: 10px;
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    background: transparent;
    color: var(--text-dim);
  }
  .sidebar-link:hover { background: var(--hover); color: var(--text); }
  .sidebar-link[data-active="true"] { background: var(--hover); color: var(--text); }
  .sidebar-link svg { flex: 0 0 auto; }

  .sidebar-bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sidebar-key-status,
  .sidebar-theme-toggle {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border: 1px solid var(--border2);
    border-radius: 10px;
    background: transparent;
    color: var(--text-dim);
    font-size: 12.5px;
    cursor: pointer;
    font-family: inherit;
  }
  .sidebar-key-status:hover,
  .sidebar-theme-toggle:hover { background: var(--hover); color: var(--text); }
  .sidebar-key-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border3);
    flex: 0 0 8px;
  }
  .sidebar-key-dot[data-connected="true"] { background: #37b24d; }
  .sidebar.collapsed .sidebar-key-status,
  .sidebar.collapsed .sidebar-theme-toggle { justify-content: center; }

  @media (max-width: 860px) {
    .sidebar { display: none; }
  }
</style>
