---
import { NAV_ITEMS, NEW_CHAT_ITEM, type NavItem, type NavKey } from "../../lib/nav-items";

interface Props {
  active: NavKey;
}
const { active } = Astro.props;

/* Nav is grouped rather than rendered as one flat list so each named section
   can collapse independently. An item declaring `section` opens a new group;
   the items after it belong to that group until the next one declares its
   own. This keeps nav-items.ts as the single source of truth (MobileNav
   ignores `section` entirely, so grouping here can't affect the tab bar). */
interface NavGroup {
  section: string | null;
  items: NavItem[];
}
const groups = NAV_ITEMS.reduce<NavGroup[]>((acc, item) => {
  const last = acc[acc.length - 1];
  if (item.section || !last) acc.push({ section: item.section ?? null, items: [item] });
  else last.items.push(item);
  return acc;
}, []);

/** Stable per-group storage key for the persisted collapse state. */
const groupKey = (section: string) => section.toLowerCase().replace(/[^a-z0-9]+/g, "-");

---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-top">
    <span class="sidebar-mark" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M2.5 15c1.5-6.5 3-9.5 4.8-9.5S9 10 11 10s2-6 4.3-6 2.6 6.8 4.2 6.8 1.5-2.3 3-2.3" stroke="var(--accent)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span class="sidebar-word">Doodle AI</span>
    <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="Collapse sidebar">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>

  <a href={NEW_CHAT_ITEM.href} class="sidebar-primary-action">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" set:html={NEW_CHAT_ITEM.icon} />
    <span class="sidebar-label">{NEW_CHAT_ITEM.label}</span>
  </a>

  <nav class="sidebar-nav" aria-label="Main">
    {groups.map((group) => (
      group.section ? (
        <div class="sidebar-group" data-group={groupKey(group.section)} data-collapsed="false">
          <!-- A real <button> with aria-expanded, not a styled div: this is a
               disclosure control, so it has to be keyboard-reachable and
               announce its state. The chevron is decorative and rotates via
               CSS off the group's data-collapsed. -->
          <button
            type="button"
            class="sidebar-group-header"
            data-group-toggle={groupKey(group.section)}
            aria-expanded="true"
            aria-controls={`sidebarGroup-${groupKey(group.section)}`}
          >
            <span class="sidebar-label">{group.section}</span>
            <svg class="sidebar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="sidebar-group-body" id={`sidebarGroup-${groupKey(group.section)}`}>
            <div class="sidebar-group-inner">
              {group.items.map((item) => (
                <a href={item.href} class="sidebar-link" aria-current={active === item.key ? "page" : undefined} data-active={active === item.key ? "true" : "false"}>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" set:html={item.icon} />
                  <span class="sidebar-label">{item.label}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div class="sidebar-group-inner">
          {group.items.map((item) => (
            <a href={item.href} class="sidebar-link" aria-current={active === item.key ? "page" : undefined} data-active={active === item.key ? "true" : "false"}>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" set:html={item.icon} />
              <span class="sidebar-label">{item.label}</span>
            </a>
          ))}
        </div>
      )
    ))}
  </nav>

  <div class="sidebar-chats sidebar-group" id="sidebarChats" data-group="recents" data-collapsed="false">
    <button
      type="button"
      class="sidebar-group-header"
      data-group-toggle="recents"
      aria-expanded="true"
      aria-controls="sidebarChatsList"
    >
      <span class="sidebar-label">Recents</span>
      <!-- Count is filled by sidebar.ts once the thread list is known, so a
           collapsed group still tells you how much is hidden inside it. -->
      <span class="sidebar-count" id="sidebarChatsCount" hidden></span>
      <svg class="sidebar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="sidebar-chats-list" id="sidebarChatsList"></div>
  </div>

  <div class="sidebar-bottom">
    <button type="button" class="sidebar-link sidebar-feedback" id="sidebarFeedback" aria-label="Send feedback">
      <!-- A megaphone, not a speech bubble — the bubble shape is already the
           chat/thread placeholder icon elsewhere in this sidebar, and reusing
           it here made "Feedback" easy to mistake for a chat item. -->
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 10v3a1.5 1.5 0 0 0 1.5 1.5H6l1 5h2l-.7-5h1.3l7 3.5v-13l-7 3.5H4.5A1.5 1.5 0 0 0 3 10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M20 9.5a3 3 0 0 1 0 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span class="sidebar-label">Feedback</span>
    </button>

    <!-- Auth slot. Both states start hidden and the resolved one is revealed
         by sidebar.ts, so a signed-in user never sees "Sign in" flash first.
         Still no "Upgrade to Pro" CTA here — that would advertise a checkout
         that does not exist. The out-of-credits hint below IS now actionable
         though: it opens UpgradeContactDialog (mounted in AppShellLayout), which
         routes to WhatsApp/Discord/email for a manual credit grant. A button
         that reaches a human is not a button that goes nowhere. -->
    <div class="sidebar-auth" id="sidebarAuth">
      <button type="button" class="sidebar-auth-signin" id="sidebarSignIn" hidden>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M15 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="sidebar-label">Sign in</span>
      </button>
      <div class="sidebar-auth-user" id="sidebarAuthUser" hidden>
        <span class="sidebar-auth-avatar" id="sidebarAuthAvatar" aria-hidden="true"></span>
        <span class="sidebar-auth-meta sidebar-label">
          <span class="sidebar-auth-name-row">
            <span class="sidebar-auth-name" id="sidebarAuthName"></span>
            <span class="sidebar-auth-plan" id="sidebarCreditsBalance">…</span>
          </span>
          <button type="button" class="sidebar-credits-hint" id="sidebarCreditsHint" hidden>Out of credits — tap to get more</button>
        </span>
        <button class="sidebar-auth-signout" id="sidebarSignOut" type="button" aria-label="Sign out">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M9 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="sidebar-resize-handle" id="sidebarResizeHandle" role="separator" aria-orientation="vertical" aria-label="Resize sidebar"></div>
</aside>

<button class="sidebar-open" id="sidebarOpen" type="button" aria-label="Show sidebar" aria-controls="sidebar" aria-expanded="false">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<script src="../../scripts/app/sidebar.ts"></script>

<style>
  .sidebar { --sidebar-w: 258px;
    position: relative;
    flex: 0 0 var(--sidebar-w);
    width: var(--sidebar-w);
    background: var(--bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 14px 12px 12px;
    /* Was 20px. The named groups now carry their own top padding, so a 20px
       shell gap stacked on top of that and pushed Recents needlessly far
       down the rail. */
    gap: 12px;
    transition: width 0.15s ease;
  }
  .sidebar.resizing { transition: none; }
  .sidebar.collapsed { display: none; }
  .sidebar-open {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 30;
    display: none;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border2);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text-dim);
    cursor: pointer;
  }
  .sidebar.collapsed + .sidebar-open { display: flex; }
  .sidebar-open:hover { background: var(--hover); color: var(--text); border-color: var(--border3); }
  .sidebar-top {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 2px 8px 0;
  }
  .sidebar-mark {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 34px;
  }
  /* Doodle-theme touch: the mark is a hand-drawn squiggle, so it gets a small
     wobble when the header is hovered. Restrained on purpose — one playful
     beat in the chrome, not a moving sidebar. */
  .sidebar-mark svg {
    transition: transform 0.3s cubic-bezier(0.2, 0.85, 0.2, 1);
    transform-origin: 50% 60%;
  }
  .sidebar-top:hover .sidebar-mark svg { transform: rotate(-7deg) scale(1.08); }
  .sidebar-word {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
  }
  .sidebar.collapsed .sidebar-word,
  .sidebar.collapsed .sidebar-label {
    display: none;
  }
  .sidebar-collapse {
    margin-left: auto;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 1px solid var(--border2);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 26px;
    transition: transform 0.15s ease;
  }
  .sidebar.collapsed .sidebar-collapse { transform: rotate(180deg); }

  .sidebar-primary-action {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border2);
    border-radius: 14px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    background: var(--surface);
    color: var(--text);
  }
  .sidebar-primary-action:hover { background: var(--hover); border-color: var(--accent); }
  .sidebar-primary-action svg { flex: 0 0 auto; }
  .sidebar.collapsed .sidebar-primary-action { justify-content: center; padding: 10px; }

  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; }

  /* ---- Collapsible groups ---- */
  .sidebar-group { display: flex; flex-direction: column; }
  .sidebar-group-inner { display: flex; flex-direction: column; gap: 2px; }

  .sidebar-group-header {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    padding: 9px 12px 5px;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: 10.5px;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dimmer);
    cursor: pointer;
    text-align: left;
  }
  .sidebar-group-header:hover { color: var(--text-dim); }
  .sidebar-group-header:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 8px;
  }
  /* Chevron sits at the far right of the same row the label is on — the
     request was explicitly "return to the same row and show the up and down
     arrow", not a second row. */
  .sidebar-chevron {
    margin-left: auto;
    flex: 0 0 12px;
    color: var(--text-dimmer);
    transition: transform 0.18s ease;
  }
  .sidebar-group-header:hover .sidebar-chevron { color: var(--text-dim); }
  .sidebar-group[data-collapsed="true"] .sidebar-chevron { transform: rotate(-90deg); }

  .sidebar-count {
    flex: 0 0 auto;
    min-width: 17px;
    padding: 1px 5px;
    border-radius: 999px;
    background: var(--hover);
    color: var(--text-dimmer);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0;
    text-align: center;
  }
  .sidebar-count[hidden] { display: none; }

  /* grid-template-rows 1fr -> 0fr animates a collapse without needing a
     measured pixel height. The inner wrapper must carry min-height: 0 and
     overflow: hidden or the row refuses to shrink below its content. */
  .sidebar-group-body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.18s ease;
  }
  .sidebar-group-body > .sidebar-group-inner {
    min-height: 0;
    overflow: hidden;
  }
  .sidebar-group[data-collapsed="true"] .sidebar-group-body { grid-template-rows: 0fr; }

  /* Collapsed rail: labels and chevrons go, so a header would be an empty
     row — show a thin rule as the group separator instead, matching what the
     old .sidebar-section-label did. */
  .sidebar.collapsed .sidebar-group-header { padding: 8px 12px 4px; justify-content: center; }
  .sidebar.collapsed .sidebar-chevron,
  .sidebar.collapsed .sidebar-count { display: none; }
  .sidebar.collapsed .sidebar-group-header::before {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  /* A collapsed rail must never hide nav icons behind a collapsed group — the
     icons are the only affordance left, so force every group open there. */
  .sidebar.collapsed .sidebar-group-body { grid-template-rows: 1fr !important; }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    padding: 9px 12px;
    border: 0;
    border-radius: 12px;
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    background: transparent;
    color: var(--text-dim);
  }
  .sidebar-link:hover { background: var(--hover); color: var(--text); }
  .sidebar-link[data-active="true"] { background: var(--hover); color: var(--text); }
  .sidebar-link svg { flex: 0 0 auto; }

  .sidebar-chats {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  /* Collapsed, the group must stop claiming the free row — otherwise it holds
     a tall empty gap open and the collapse saves no space at all, which was
     the whole point. */
  .sidebar-chats[data-collapsed="true"] { flex: 0 0 auto; }
  .sidebar-chats[data-collapsed="true"] .sidebar-chats-list { display: none; }
  .sidebar-chats-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: auto;
    min-height: 0;
    /* Thin scrollbar so a long thread list doesn't put a chunky native bar
       inside a 258px rail. */
    scrollbar-width: thin;
  }
  /* :global() below is load-bearing, not decoration: every element in the
     chats list (.sidebar-chat-link, its thumb/title, .sidebar-chats-empty)
     is created client-side in sidebar.ts via document.createElement(), and
     Astro's default scoped CSS compiles each selector to require a
     `data-astro-cid-*` attribute directly on the matched element —
     Astro stamps that attribute onto elements it renders server-side, but
     has no way to stamp it onto nodes a client script creates later. Without
     :global(), these rules silently never match and every element in the
     list renders at browser-default sizing (an <img> with no dimensions
     unstyled renders at its full intrinsic size, e.g. 1024×1024 for a PicX
     output, which is how this was actually caught). */
  :global(.sidebar-chat-link) {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 10px;
    border-radius: 10px;
    font-size: 13.5px;
    color: var(--text-dim);
    min-width: 0;
  }
  :global(.sidebar-chat-link:hover) { background: var(--hover); color: var(--text); }
  :global(.sidebar-chat-link[data-active="true"]) { background: var(--hover); color: var(--text); }
  :global(.sidebar-chat-thumb) {
    flex: 0 0 26px;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: var(--surface2);
    border: 1px solid var(--border2);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--text-dimmer);
    font-size: 14px;
    line-height: 1;
  }
  :global(.sidebar-chat-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  :global(.sidebar-chat-title) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.sidebar.collapsed .sidebar-chat-title) { display: none; }
  /* Was `display: none` on the whole .sidebar-chats block — collapsing the
     text left a tall dead gap in the rail with nothing in it. Centering the
     now-title-less thumbnails instead keeps recents reachable (and the rail
     full) the same way the collapsed nav icons above already work. */
  :global(.sidebar.collapsed .sidebar-chat-link) {
    justify-content: center;
    padding: 6px;
  }
  :global(.sidebar-chats-empty) { padding: 6px 10px; font-size: 12.5px; color: var(--text-dimmer); }
  :global(.sidebar.collapsed .sidebar-chats-empty) { display: none; }

  .sidebar-bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  /* :not([hidden]) rather than a plain class selector — same lesson as
     AuthDialog.astro: an unconditional `display: flex` here is an author
     rule and beats the UA stylesheet's `[hidden] { display: none }`
     regardless of specificity, so the sign-in button and the signed-in user
     card would both render at once no matter what sidebar.ts sets `.hidden`
     to. Tying display to :not([hidden]) makes the JS toggle actually work. */
  .sidebar-auth-signin:not([hidden]),
  .sidebar-auth-user:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--border2);
    border-radius: 12px;
    color: var(--text-dim);
    font-size: 12.5px;
  }
  /* .sidebar-auth-signin is a <button> (it opens the auth dialog rather than
     navigating), so it needs the anchor-style reset .sidebar-auth-user
     doesn't. */
  .sidebar-auth-signin {
    width: 100%;
    background: none;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .sidebar-auth-signin:hover { background: var(--hover); color: var(--text); }
  .sidebar-auth-signin svg,
  .sidebar-auth-user svg { flex: 0 0 auto; }
  .sidebar-auth-avatar {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--send-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    background-size: cover;
    background-position: center;
  }
  .sidebar-auth-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .sidebar-auth-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .sidebar-auth-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The card is a single line now (no email row), so the name can carry a
     touch more weight without making the rail feel heavy. */
  .sidebar-auth-name { color: var(--text); min-width: 0; font-size: 13.5px; font-weight: 550; }
  .sidebar-auth-plan {
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--hover);
    color: var(--text-dimmer);
    font-size: 10.5px;
    font-weight: 600;
  }
  /* Zero balance gets the accent treatment so it reads as a state change,
     not just another quiet pill. */
  .sidebar-auth-plan[data-empty="true"] {
    background: var(--accent-softer, var(--accent-soft));
    color: var(--accent);
  }
  .sidebar.collapsed .sidebar-auth-plan { display: none; }
  .sidebar-auth-user-clickable { cursor: pointer; }
  .sidebar-auth-user-clickable:hover { background: var(--hover); color: var(--text); }
  .sidebar-auth-user-clickable:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sidebar-auth-signout {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--text-dimmer);
    padding: 2px;
    cursor: pointer;
    display: flex;
    font-family: inherit;
  }
  .sidebar-auth-signout:hover { color: var(--text); }
  /* Collapsed, only the avatar survives — the sign-out control needs the
     expanded sidebar (the mobile nav has no auth slot at all). */
  .sidebar.collapsed .sidebar-auth-signin,
  .sidebar.collapsed .sidebar-auth-user { justify-content: center; }
  .sidebar.collapsed .sidebar-auth-signout { display: none; }

  /* Lives inside .sidebar-auth-meta now, under the email line, instead of a
     separate block below the whole card — one compact card instead of two
     stacked ones. Same :not([hidden]) lesson as everywhere else in this
     file: the unconditional-display mistake defeats the JS toggle. */
  .sidebar-credits-hint:not([hidden]) {
    display: block;
    margin-top: 2px;
    color: var(--text-dimmer);
    font-size: 10.5px;
    line-height: 1.35;
    /* Now a <button>: strip the UA chrome so it still reads as the quiet hint
       it was, while being keyboard-reachable and hit-testable. */
    padding: 0;
    border: none;
    background: none;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--border2);
    text-underline-offset: 2px;
  }
  .sidebar-credits-hint:not([hidden]):hover { color: var(--accent); text-decoration-color: currentColor; }
  .sidebar-credits-hint:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }
  .sidebar.collapsed .sidebar-credits-hint { display: none; }

  .sidebar-resize-handle {
    position: absolute;
    top: 0;
    right: -3px;
    width: 6px;
    height: 100%;
    cursor: col-resize;
    z-index: 5;
    touch-action: none;
  }
  .sidebar-resize-handle::after {
    content: "";
    position: absolute;
    top: 0;
    left: 2px;
    width: 2px;
    height: 100%;
    background: transparent;
  }
  .sidebar-resize-handle:hover::after,
  .sidebar.resizing .sidebar-resize-handle::after {
    background: var(--accent);
  }
  .sidebar.collapsed .sidebar-resize-handle { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .sidebar,
    .sidebar-mark svg,
    .sidebar-chevron,
    .sidebar-group-body,
    .sidebar-collapse { transition: none !important; }
    .sidebar-top:hover .sidebar-mark svg { transform: none; }
  }

