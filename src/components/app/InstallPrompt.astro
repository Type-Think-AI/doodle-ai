---
/* Hidden by default — install-prompt.ts only reveals it once the browser
   actually fires beforeinstallprompt (Chromium/Android; iOS Safari and
   already-installed contexts never fire it, so this stays hidden there). */
---

<div class="install-prompt" id="installPromptBanner" role="status" hidden>
  <span class="install-prompt-icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
  <span class="install-prompt-text">Install Doodle AI for quicker access</span>
  <button type="button" class="install-prompt-install" id="installPromptButton">Install</button>
  <button type="button" class="install-prompt-dismiss" id="installPromptDismiss" aria-label="Dismiss">×</button>
</div>

<style>
  .install-prompt {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(84px + env(safe-area-inset-bottom, 0px));
    z-index: 41;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 12px;
    border: 1px solid var(--border2);
    border-radius: 14px;
    background: var(--card);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  }
  .install-prompt[hidden] { display: none; }
  .install-prompt-icon { flex: 0 0 auto; color: var(--accent); display: flex; }
  .install-prompt-text { flex: 1; min-width: 0; font-size: 13px; color: var(--text); }
  .install-prompt-install {
    flex: 0 0 auto;
    padding: 7px 14px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: var(--send-fg);
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
  }
  .install-prompt-dismiss {
    flex: 0 0 auto;
    border: 0;
    background: none;
    color: var(--text-dimmer);
    font-size: 16px;
    line-height: 1;
    padding: 4px;
    cursor: pointer;
  }
  .install-prompt-dismiss:hover { color: var(--text); }

  @media (min-width: 861px) {
    .install-prompt { left: auto; right: 20px; bottom: 20px; width: min(340px, calc(100vw - 40px)); }
  }
</style>
