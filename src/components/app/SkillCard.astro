---
import { buildSkillThumbnail, type Skill } from '../../lib/skills';
import { imageCountForSkill } from '../../lib/credits/costs';

interface Props {
  skill: Skill;
}
const { skill } = Astro.props;
const thumb = buildSkillThumbnail(skill);
/* Pack skills return several separate images from one run. Surfacing the count
   on the card matters because it is the thing that differentiates this
   catalogue — and because it is also what the run costs (1 credit per image),
   so a user should see "9" before clicking, not after being charged. Roadmap
   skills have no price to look up, hence the runnable guard. */
const imageCount = skill.runnable ? imageCountForSkill(skill.id) : 1;
---

<a class="skill-card" href={`/skills/${skill.id}`} data-runnable={skill.runnable ? "true" : "false"}>
  <div class="skill-card-thumb">
    {skill.thumbnailUrl ? <img src={skill.thumbnailUrl} alt={`${skill.name} sample output`} loading="lazy" /> : <Fragment set:html={thumb} />}
    {imageCount > 1 && (
      <span
        class="skill-card-count"
        role="img"
        aria-label={`Returns ${imageCount} separate images`}
        title={`Returns ${imageCount} separate images`}
      >{imageCount}</span>
    )}
    {!skill.runnable && <span class="skill-card-badge">Coming soon</span>}
  </div>
  <div class="skill-card-meta">
    <span class="skill-card-name">{skill.name}</span>
    <span class="skill-card-tagline">{skill.tagline}</span>
  </div>
</a>

<style is:global>
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
  }
  .skill-card-thumb {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  /* Hover feedback only where a real hover device is present. */
  @media (hover: hover) and (pointer: fine) {
    .skill-card:hover .skill-card-thumb { border-color: var(--border3); }
  }
  /* Touch/tap feedback so the card isn't silently inert on phones. */
  .skill-card:active .skill-card-thumb { border-color: var(--border3); transform: scale(0.98); }
  .skill-card:focus-visible { outline: 2px solid var(--border3); outline-offset: 3px; border-radius: 14px; }
  /* Direct children only: the thumbnail itself is a direct <svg>/<img> child,
     whereas the overlay badges nest their own small icons. An unscoped
     descendant selector here inflated a badge's 11px icon to fill the card. */
  .skill-card-thumb > svg,
  .skill-card-thumb > img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .skill-card[data-runnable="false"] .skill-card-thumb > svg,
  .skill-card[data-runnable="false"] .skill-card-thumb > img { opacity: 0.45; }
  /* Multi-image count — just the number, deliberately small. It is a glanceable
     marker of which skills return a set, not a label to read; the full meaning
     lives in the aria-label/title and on the skill page's spec row.
     Top-right so it never collides with the bottom-right "Coming soon" badge,
     and light-on-translucent-dark because these thumbnails are mostly
     cream/warm-white and nothing else stays legible across all of them. */
  .skill-card-count {
    position: absolute;
    right: 7px;
    top: 7px;
    min-width: 21px;
    height: 21px;
    padding: 0 5px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(12, 12, 12, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 11.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    backdrop-filter: blur(6px);
  }

  .skill-card-badge {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(15, 15, 15, 0.72);
    color: #fff;
    font-size: 11px;
    max-width: calc(100% - 16px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .skill-card-meta { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .skill-card-name {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .skill-card-tagline {
    font-size: 12.5px;
    color: var(--text-dimmer);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 720px) {
    .skill-card { gap: 8px; }
    .skill-card-name { font-size: 13.5px; }
    .skill-card-tagline { font-size: 12px; -webkit-line-clamp: 2; }
  }
</style>
