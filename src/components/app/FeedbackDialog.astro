---
// Feedback dialog redesigned as a tldraw-style sticky note.
//
// The old design was a generic SaaS modal with a textarea and yellow button.
// This version presents a single sticky note card that looks identical to what
// appears on the /roadmap board — so the mental model is: "write on a sticky,
// it lands on the roadmap". Submission does two things:
//   1. POST /api/v1/feedback (D1 row — durable record, admin triage)
//   2. The endpoint also RPC-creates a shape on the roadmap DO's ICE BOX
//      column, so it's immediately visible to maintainers on the board.
//
// Opened via `window.dispatchEvent(new Event("doodleai:open-feedback"))`.
---

<dialog id="feedbackDialog" class="fb-dialog" aria-labelledby="fbTitle">
	<div class="fb-note" id="feedbackDialogBody">
		<button type="button" class="fb-close" id="feedbackDialogClose" aria-label="Close">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
		</button>

		<h2 id="fbTitle" class="fb-title">Drop a note</h2>
		<p class="fb-sub">It lands on the roadmap board for the team to see.</p>

		<textarea id="feedbackDialogText" class="fb-textarea" placeholder="What's on your mind?" maxlength="500" rows="4"></textarea>

		<p class="fb-error" id="feedbackDialogError" hidden></p>

		<button type="button" class="fb-submit" id="feedbackDialogSubmit">
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
			Stick it
		</button>
	</div>
</dialog>

<script src="../../scripts/app/feedback-dialog.ts"></script>

<style>
	.fb-dialog {
		padding: 0;
		border: none;
		border-radius: 4px;
		width: min(320px, calc(100vw - 32px));
		background: transparent;
		overflow: visible;
	}
	.fb-dialog::backdrop {
		background: rgba(6, 6, 6, 0.55);
		backdrop-filter: blur(3px);
	}
	.fb-dialog[open] {
		display: block;
		margin: auto;
	}

	/* The sticky note card itself */
	.fb-note {
		position: relative;
		background: #3d3d2e;
		padding: 22px 20px 20px;
		border-radius: 3px;
		box-shadow:
			0 2px 6px rgba(0,0,0,0.35),
			0 12px 24px rgba(0,0,0,0.25);
		color: #f5f5f0;
		font-family: var(--font-sans, system-ui, sans-serif);
		/* tldraw-note-like fold */
		border-bottom: 3px solid rgba(0,0,0,0.18);
	}

	.fb-close {
		position: absolute;
		top: 10px;
		right: 10px;
		width: 26px;
		height: 26px;
		border: none;
		border-radius: 999px;
		background: rgba(255,255,255,0.08);
		color: #bbb;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.fb-close:hover { color: #fff; background: rgba(255,255,255,0.15); }
	.fb-close:focus-visible { outline: 2px solid #fbbf24; outline-offset: 2px; }

	.fb-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #fefce8;
	}
	.fb-sub {
		margin: 4px 0 14px;
		font-size: 0.78rem;
		color: #a8a88e;
		line-height: 1.4;
	}

	.fb-textarea {
		width: 100%;
		resize: none;
		min-height: 90px;
		padding: 10px 11px;
		border: 1px solid rgba(255,255,255,0.08);
		border-radius: 4px;
		background: rgba(0,0,0,0.25);
		color: #f5f5f0;
		font-family: inherit;
		font-size: 0.88rem;
		line-height: 1.5;
	}
	.fb-textarea::placeholder { color: #8a8a72; }
	.fb-textarea:focus-visible { outline: 2px solid #fbbf24; outline-offset: 1px; }

	.fb-error {
		font-size: 0.75rem;
		color: #ff7b72;
		margin: 8px 0 0;
		line-height: 1.4;
	}

	.fb-submit {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		width: 100%;
		margin-top: 12px;
		min-height: 38px;
		border: none;
		border-radius: 4px;
		background: #fbbf24;
		color: #1a1400;
		font-family: inherit;
		font-size: 0.84rem;
		font-weight: 700;
		cursor: pointer;
	}
	.fb-submit:hover { filter: brightness(1.08); }
	.fb-submit:disabled { opacity: 0.6; cursor: default; }
	.fb-submit:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

	.fb-thanks {
		padding: 16px 0;
		text-align: center;
		font-size: 0.92rem;
		color: #fefce8;
	}
	.fb-thanks svg { display: block; margin: 0 auto 8px; }
</style>
