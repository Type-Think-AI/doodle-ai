  .composer-hint { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .composer-hint kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 5px;
    border: 1px solid var(--border2);
    background: var(--surface2);
    color: var(--text-dim);
    font: inherit;
    font-size: 10.5px;
    line-height: 1;
  }
  .composer-hint-sep { opacity: 0.5; }
  .composer-compact .composer-hints { display: none; }

  .composer-status { text-align: center; font-size: 12.5px; color: var(--text-dim); margin: 8px 0 0; min-height: 16px; }
  .composer-status[data-err="true"] { color: var(--red); }

  .camera-dialog-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(6px);
  }
  .camera-dialog-backdrop[hidden] { display: none; }
  .camera-dialog-panel {
    width: min(100%, 460px);
    max-height: min(760px, calc(100dvh - 40px));
    overflow: auto;
    padding: 18px;
    border: 1px solid var(--border2);
    border-radius: 22px;
    background: linear-gradient(180deg, var(--card), var(--prompt-bg));
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    animation: composerRise .18s ease;
  }
  .camera-dialog-head { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 14px; }
  .camera-dialog-head h2 { color: var(--text); font-size: 18px; font-weight: 600; margin: 0 0 4px; letter-spacing: -0.01em; }
  .camera-dialog-head p { color: var(--text-dimmer); font-size: 12.5px; line-height: 1.45; margin: 0; }
  .camera-dialog-close {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    margin-left: auto;
    border: 1px solid var(--border2);
    border-radius: 50%;
    background: transparent;
    color: var(--text-dim);
    font: inherit;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .camera-dialog-close:hover { color: var(--text); background: var(--hover); }
  .camera-stage {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    background: var(--stage);
    border: 1px solid var(--border2);
  }
  .camera-stage video,
  .camera-stage img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .camera-dialog-status { min-height: 18px; margin: 10px 0 0; color: var(--text-dim); font-size: 12.5px; line-height: 1.45; }
  .camera-dialog-actions { display: flex; gap: 8px; margin-top: 14px; }
  .camera-dialog-actions button {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--border3);
    background: transparent;
    color: var(--text-dim);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .camera-dialog-actions button:hover { color: var(--text); background: var(--hover); }
  .camera-dialog-actions .camera-dialog-primary {
    margin-left: auto;
    border: 0;
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
  .camera-dialog-actions .camera-dialog-primary:hover { background: var(--text); opacity: 0.9; }
  .camera-dialog-actions .camera-dialog-primary:disabled { opacity: 0.5; cursor: default; }

  /* Mention pills, inserted as non-editable spans by composer-mentions.ts */
  .mention-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 1px 8px 1px 4px;
    border-radius: 999px;
    font-size: 0.92em;
    font-weight: 500;
    white-space: nowrap;
    user-select: none;
  }
  .mention-pill img {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    object-fit: cover;
    overflow: hidden;
    font-size: 0;
    color: transparent;
  }
  .mention-pill[data-mention-type="character"] { background: var(--accent-softer); color: var(--accent); }
  .mention-pill[data-mention-type="skill"] { background: var(--blue-faint); color: var(--blue); }
  .mention-pill[data-mention-type="ref"] { background: var(--surface2); color: var(--text-dim); border: 1px solid var(--border2); }

  /* Mention popover */
  .mention-popover {
    position: absolute;
    z-index: 30;
    min-width: 226px;
    max-width: 280px;
    max-height: 260px;
    overflow-y: auto;
    background: linear-gradient(180deg, var(--card), var(--prompt-bg));
    border: 1px solid var(--border2);
    border-radius: 15px;
    box-shadow: 0 22px 52px rgba(0, 0, 0, 0.35);
    padding: 6px;
    animation: composerRise .16s ease;
  }
  .mention-popover-empty { padding: 10px 12px; font-size: 12.5px; color: var(--text-dimmer); }
  .mention-popover-item {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 7px 9px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text);
    font-size: 13.5px;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .mention-popover-item img {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 22px;
    overflow: hidden;
    font-size: 0;
    color: transparent;
  }
  .mention-popover-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mention-popover-item[data-active="true"],
  .mention-popover-item:hover { background: var(--hover); }
</style>

<script>
  /* Cosmetic/interaction layer ported from the "Prompt Composer v2" design
     that has no equivalent in home.ts/chat.ts: focus-expand mode, the
     resize grabber, and the rendering-mode dropdown. None of this touches
     send/attach/mention state — it only toggles classes and inline styles
     on elements scoped by [data-id], so it safely runs alongside (and
     independently of) each page's own composer controller.

     Runs once per `.composer` found on the page (Home and Chat each render
     exactly one), guarded by a dataset flag in case Astro's script
     deduplication or a bfcache restore re-executes this block. */
  function initComposerExtras(root: HTMLElement): void {
    if (root.dataset.extrasInit === "true") return;
    root.dataset.extrasInit = "true";
    const prefix = root.dataset.id;
    if (!prefix) return;

    const $ = <T extends HTMLElement = HTMLElement>(suffix: string): T | null =>
      document.getElementById(`${prefix}${suffix}`) as T | null;

    const box = $(`Box`);
    const backdrop = $(`ExpandBackdrop`);
    const focusBar = $(`FocusBar`);
    const expandBtn = $(`ExpandBtn`);
    const collapseBtn = $(`CollapseBtn`);
    const editable = $(`Input`);
    const resizeHandle = $(`ResizeHandle`);
    const modeBtn = $(`ModeBtn`) as HTMLButtonElement | null;
    const modeMenu = $(`ModeMenu`);
    const modeLabel = $(`ModeLabel`);
    if (!box || !editable) return;

    /* ---- Focus / expand ---- */
    let expanded = false;
    function setExpanded(next: boolean): void {
      expanded = next;
      box!.dataset.expanded = String(next);
      if (backdrop) backdrop.hidden = !next;
      if (focusBar) focusBar.hidden = !next;
      expandBtn?.setAttribute("aria-label", next ? "Collapse composer" : "Expand composer");
      if (next) editable!.focus();
    }
    expandBtn?.addEventListener("click", () => setExpanded(!expanded));
    collapseBtn?.addEventListener("click", () => setExpanded(false));
    backdrop?.addEventListener("click", () => setExpanded(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && expanded) setExpanded(false);
    });
    // Capture phase so this runs before chat.ts/home.ts's own Enter handler.
    editable.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          e.stopPropagation();
          setExpanded(!expanded);
        }
      },
      true,
    );

    /* ---- Resize grabber ---- */
    if (resizeHandle) {
      let startY = 0;
      let startH = 0;
      let dragging = false;
      const minH = () => (root.classList.contains("composer-compact") ? 42 : 46);
      const onMove = (e: PointerEvent): void => {
        if (!dragging) return;
        const next = Math.min(300, Math.max(minH(), startH + (startY - e.clientY)));
        editable!.style.minHeight = `${next}px`;
      };
      const onUp = (): void => {
        dragging = false;
        resizeHandle.removeAttribute("data-active");
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("pointerup", onUp);
      };
      resizeHandle.addEventListener("pointerdown", (e) => {
        if (expanded) return;
        e.preventDefault();
        dragging = true;
        resizeHandle.dataset.active = "true";
        startY = e.clientY;
        startH = editable!.getBoundingClientRect().height;
        window.addEventListener("pointermove", onMove);
        window.addEventListener("pointerup", onUp);
      });
      resizeHandle.addEventListener("dblclick", () => {
        editable!.style.minHeight = "";
      });
    }

    /* ---- Mode dropdown (cosmetic — no backend concept of modes yet) ---- */
    if (modeBtn && modeMenu && modeLabel) {
      let open = false;
      const setOpen = (next: boolean): void => {
        open = next;
        modeMenu.hidden = !next;
        modeBtn.setAttribute("aria-expanded", String(next));
      };
      modeBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(!open);
      });
      modeMenu.querySelectorAll<HTMLButtonElement>(".composer-mode-item").forEach((item) => {
        item.addEventListener("click", () => {
          const mode = item.dataset.mode || "Auto";
          modeLabel.textContent = mode;
          modeMenu.querySelectorAll(".composer-mode-item").forEach((i) => delete (i as HTMLElement).dataset.active);
          item.dataset.active = "true";
          setOpen(false);
        });
      });
      document.addEventListener("click", (e) => {
        if (open && !modeMenu.contains(e.target as Node) && e.target !== modeBtn) setOpen(false);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && open) setOpen(false);
      });
    }
  }

  document.querySelectorAll<HTMLElement>(".composer").forEach(initComposerExtras);
</script>
