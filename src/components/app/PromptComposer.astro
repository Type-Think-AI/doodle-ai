---
interface Props {
  /** Prefix for every element id, matching what home.ts / chat.ts expect. */
  id: string;
  variant?: "hero" | "compact";
  placeholder?: string;
}
const { id, variant = "compact", placeholder = "Describe a doodle or attach a photo" } = Astro.props;
---

<div class={`composer composer-${variant}`}>
  <p class="composer-key-banner" id={`${id}KeyBanner`} hidden>
    Add your PicX API key in <a href="/settings">Settings</a> to generate doodles.
  </p>

  <div class="composer-skill-chip" id={`${id}SkillChip`} hidden>
    <svg class="composer-skill-chip-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="6.5" width="16" height="12" rx="4.5" stroke="currentColor" stroke-width="1.7"></rect><circle cx="9.5" cy="12.5" r="1.25" fill="currentColor"></circle><circle cx="14.5" cy="12.5" r="1.25" fill="currentColor"></circle></svg>
    <span id={`${id}SkillChipLabel`}></span>
    <button type="button" id={`${id}SkillChipClear`} aria-label="Unpin skill">×</button>
  </div>

  <div class="composer-attach-row" id={`${id}AttachRow`} hidden>
    <img class="composer-attach-thumb" id={`${id}AttachPreview`} alt="Attached photo" />
    <span class="composer-attach-meta" id={`${id}AttachMeta`}>Ready</span>
    <button type="button" class="composer-attach-remove" id={`${id}AttachRemove`} aria-label="Remove attached photo">×</button>
  </div>

  <div class="composer-box">
    <div
      class="composer-editable"
      id={`${id}Input`}
      contenteditable="true"
      role="textbox"
      aria-multiline="true"
      data-placeholder={placeholder}
    ></div>
    <div class="composer-toolbar">
      <button class="composer-icon-btn" id={`${id}AttachBtn`} type="button" aria-label="Upload photo">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      </button>
      <button class="composer-icon-btn" id={`${id}CameraBtn`} type="button" aria-label="Use camera">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6"></path><circle cx="12" cy="13.5" r="3.5" stroke="currentColor" stroke-width="1.6"></circle></svg>
      </button>
      <button class="composer-icon-btn" id={`${id}CharacterBtn`} type="button" aria-label="Mention a character">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.6"></circle><path d="M5 20c1.3-3.8 4.3-5.8 7-5.8s5.7 2 7 5.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
      <button class="composer-icon-btn" id={`${id}SkillBtn`} type="button" aria-label="Use a skill">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="6.5" width="16" height="12" rx="4.5" stroke="currentColor" stroke-width="1.7"></rect><circle cx="9.5" cy="12.5" r="1.25" fill="currentColor"></circle><circle cx="14.5" cy="12.5" r="1.25" fill="currentColor"></circle></svg>
      </button>
      <input type="file" id={`${id}FileInput`} accept="image/*" hidden />
      <span class="composer-auto">Auto</span>
      <button class="composer-send" id={`${id}Send`} type="button" aria-label="Send">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 19V5m0 0-6 6m6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>

    <div class="mention-popover" id={`${id}MentionPopover`} hidden></div>
  </div>

  <div class="camera-dialog-backdrop" id={`${id}CameraDialog`} role="dialog" aria-modal="true" aria-labelledby={`${id}CameraTitle`} aria-hidden="true" hidden>
    <div class="camera-dialog-panel">
      <div class="camera-dialog-head">
        <div>
          <h2 id={`${id}CameraTitle`}>Take a photo</h2>
          <p>Allow camera access, frame your subject, and capture.</p>
        </div>
        <button type="button" class="camera-dialog-close" id={`${id}CameraClose`} aria-label="Close camera">×</button>
      </div>
      <div class="camera-stage">
        <video id={`${id}CameraVideo`} autoplay playsinline muted></video>
        <img id={`${id}CameraPreview`} alt="Captured photo preview" hidden />
        <canvas id={`${id}CameraCanvas`} hidden></canvas>
      </div>
      <p class="camera-dialog-status" id={`${id}CameraStatus`} role="status" aria-live="polite"></p>
      <div class="camera-dialog-actions">
        <button type="button" class="camera-dialog-secondary" id={`${id}CameraCancel`}>Cancel</button>
        <button type="button" class="camera-dialog-secondary" id={`${id}CameraRetake`} hidden>Retake</button>
        <button type="button" class="camera-dialog-primary" id={`${id}CameraCapture`} disabled>Take photo</button>
        <button type="button" class="camera-dialog-primary" id={`${id}CameraUse`} hidden>Use photo</button>
      </div>
    </div>
  </div>

  <p class="composer-status" id={`${id}Status`} role="status" aria-live="polite"></p>
</div>

<style is:global>
  /* Shared prompt composer — used on Home (hero) and /c/[id] (compact).
     Global because both pages render this component's markup and each
     page's own controller (home.ts / chat.ts / composer-mentions.ts) only
     needs the ids to match; Astro's scoped-CSS attribute would otherwise
     be duplicated per inclusion for no benefit. */
  .composer-key-banner { font-size: 12.5px; color: var(--text-dim); margin: 0 0 8px; }
  .composer-key-banner a { color: var(--blue); text-decoration: underline; }

  .composer-skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 8px 8px 0;
    padding: 6px 10px 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border2);
    background: var(--surface2);
  }
  .composer-skill-chip-icon { color: var(--blue); flex: 0 0 auto; }
  .composer-skill-chip span {
    font-size: 13px;
    color: var(--blue);
  }
  .composer-skill-chip button {
    border: 0;
    background: none;
    color: var(--text-dimmer);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    padding: 2px;
  }
  .composer-skill-chip button:hover { color: var(--text); }
  /* Higher specificity than the bare .composer-skill-chip rule above, so
     the `hidden` attribute (toggled from JS) actually hides it — an
     unconditional `display` on the same selector otherwise always wins
     over the browser's built-in `[hidden] { display: none }` rule,
     regardless of the JS toggle. */
  .composer-skill-chip[hidden] { display: none; }

  /* Restyled as a compact pill (matching the skill chip) instead of a
     full-width bar — the wide row read as a different, thinner UI. */
  .composer-attach-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 8px 8px 0;
    padding: 4px 10px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--border2);
    background: var(--surface2);
  }
  .composer-attach-thumb {
    width: 26px;
    height: 26px;
    flex: 0 0 26px;
    object-fit: cover;
    border-radius: 50%;
    background: var(--surface);
    /* CSS-only backstop: if a broken image is ever painted before (or
       instead of) our onerror JS hides it, this keeps the fallback icon +
       alt text contained instead of spilling out of the 26px circle. */
    overflow: hidden;
    font-size: 0;
    color: transparent;
  }
  .composer-attach-meta { font-size: 12.5px; color: var(--text-dim); }
  .composer-attach-remove { border: 0; background: none; color: var(--text-dimmer); font-size: 14px; line-height: 1; cursor: pointer; padding: 2px; }
  .composer-attach-remove:hover { color: var(--text); }
  .composer-attach-row[hidden] { display: none; }

  .composer-box {
    position: relative;
    border-radius: 24px;
    background: var(--prompt-bg);
    border: 1px solid var(--border2);
    box-shadow: 0 1px 4px rgba(2, 4, 26, 0.16);
    padding: 16px;
  }
  .composer-compact .composer-box { border-radius: 18px; padding: 10px 12px; }

  .composer-editable {
    width: 100%;
    min-height: 24px;
    max-height: 200px;
    overflow-y: auto;
    outline: none;
    color: var(--text);
    font-size: 16px;
    line-height: 24px;
    font-family: inherit;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .composer-editable:empty::before {
    content: attr(data-placeholder);
    color: var(--text-dimmer);
    pointer-events: none;
  }
  .composer-compact .composer-editable { font-size: 14.5px; line-height: 21px; max-height: 140px; }

  .composer-toolbar { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
  .composer-compact .composer-toolbar { margin-top: 6px; }

  .composer-icon-btn {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 10px;
    border: 1px solid var(--border3);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .composer-compact .composer-icon-btn { width: 30px; height: 30px; flex-basis: 30px; border-radius: 9px; }
  .composer-icon-btn:hover { background: var(--icon-hover); }

  .composer-auto { margin-left: auto; font-size: 13px; color: var(--text-dim); }
  .composer-compact .composer-auto { display: none; }

  .composer-send {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 50%;
    border: 0;
    background: var(--send-bg);
    color: var(--send-fg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .composer-compact .composer-send { width: 30px; height: 30px; flex-basis: 30px; margin-left: auto; }
  .composer-send:disabled { opacity: 0.5; cursor: default; }

  .composer-status { text-align: center; font-size: 12.5px; color: var(--text-dim); margin: 8px 0 0; min-height: 16px; }
  .composer-status[data-err="true"] { color: #ff8a8a; }

  .camera-dialog-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.72);
  }
  .camera-dialog-backdrop[hidden] { display: none; }
  .camera-dialog-panel {
    width: min(100%, 460px);
    max-height: min(760px, calc(100dvh - 40px));
    overflow: auto;
    padding: 18px;
    border: 1px solid var(--border2);
    border-radius: 20px;
    background: var(--card);
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.45);
  }
  .camera-dialog-head { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 14px; }
  .camera-dialog-head h2 { color: var(--text); font-size: 18px; font-weight: 600; margin: 0 0 4px; }
  .camera-dialog-head p { color: var(--text-dimmer); font-size: 12.5px; line-height: 1.45; margin: 0; }
  .camera-dialog-close {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    margin-left: auto;
    border: 1px solid var(--border2);
    border-radius: 50%;
    background: transparent;
    color: var(--text-dim);
    font: inherit;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }
  .camera-dialog-close:hover { color: var(--text); background: var(--hover); }
  .camera-stage {
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    background: #050505;
  }
  .camera-stage video,
  .camera-stage img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .camera-dialog-status { min-height: 18px; margin: 10px 0 0; color: var(--text-dim); font-size: 12.5px; line-height: 1.45; }
  .camera-dialog-actions { display: flex; gap: 8px; margin-top: 14px; }
  .camera-dialog-actions button {
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--border3);
    background: transparent;
    color: var(--text-dim);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .camera-dialog-actions button:hover { color: var(--text); background: var(--hover); }
  .camera-dialog-actions .camera-dialog-primary { margin-left: auto; border-color: var(--send-bg); background: var(--send-bg); color: var(--send-fg); }
  .camera-dialog-actions .camera-dialog-primary:disabled { opacity: 0.5; cursor: default; }

  /* Mention pills, inserted as non-editable spans by composer-mentions.ts */
  .mention-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 1px 8px 1px 4px;
    border-radius: 999px;
    font-size: 0.92em;
    font-weight: 500;
    white-space: nowrap;
    user-select: none;
  }
  .mention-pill img {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    object-fit: cover;
    overflow: hidden;
    font-size: 0;
    color: transparent;
  }
  .mention-pill[data-mention-type="character"] { background: var(--accent-softer); color: var(--accent); }
  .mention-pill[data-mention-type="skill"] { background: var(--blue-faint); color: var(--blue); }
  .mention-pill[data-mention-type="ref"] { background: var(--surface2); color: var(--text-dim); border: 1px solid var(--border2); }

  /* Mention popover */
  .mention-popover {
    position: absolute;
    z-index: 30;
    min-width: 220px;
    max-width: 280px;
    max-height: 260px;
    overflow-y: auto;
    background: var(--card);
    border: 1px solid var(--border2);
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    padding: 6px;
  }
  .mention-popover-empty { padding: 10px 12px; font-size: 12.5px; color: var(--text-dimmer); }
  .mention-popover-item {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 7px 9px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--text);
    font-size: 13.5px;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .mention-popover-item img {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 22px;
    overflow: hidden;
    font-size: 0;
    color: transparent;
  }
  .mention-popover-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mention-popover-item[data-active="true"],
  .mention-popover-item:hover { background: var(--hover); }
</style>
