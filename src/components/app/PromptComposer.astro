---
interface Props {
  /** Prefix for every element id, matching what home.ts / chat.ts expect. */
  id: string;
  variant?: "hero" | "compact";
  placeholder?: string;
}
const { id, variant = "compact", placeholder = "Describe a doodle, drop a photo, or @mention a character" } = Astro.props;
---

<div class={`composer composer-${variant}`} data-id={id}>
  <div class="composer-expand-backdrop" id={`${id}ExpandBackdrop`} hidden></div>

  <div class="composer-skill-chip" id={`${id}SkillChip`} hidden>
    <svg class="composer-skill-chip-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 1.9 4.6 4.6 1.9-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M18.5 15.5l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9.9-2.1Z" fill="currentColor"></path></svg>
    <span id={`${id}SkillChipLabel`}></span>
    <button type="button" id={`${id}SkillChipClear`} aria-label="Unpin skill">×</button>
  </div>

  <div class="composer-attach-row" id={`${id}AttachRow`} hidden>
    <div class="composer-attach-thumb-wrap">
      <img class="composer-attach-thumb" id={`${id}AttachPreview`} alt="Attached photo" />
    </div>
    <span class="composer-attach-meta" id={`${id}AttachMeta`}>Ready</span>
    <button type="button" class="composer-attach-remove" id={`${id}AttachRemove`} aria-label="Remove attached photo">×</button>
  </div>

  <div class="composer-box" id={`${id}Box`}>
    <div class="composer-resize-handle" id={`${id}ResizeHandle`}>
      <div class="composer-grabber"></div>
    </div>

    <div class="composer-focus-bar" id={`${id}FocusBar`} hidden>
      <div class="composer-focus-left">
        <span class="composer-focus-dot"></span>
        <span class="composer-focus-label">Focus composer</span>
        <span class="composer-focus-hint">Esc to collapse</span>
      </div>
      <button type="button" class="composer-icon-btn composer-focus-collapse" id={`${id}CollapseBtn`} aria-label="Collapse composer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 4H4v6M14 20h6v-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><path d="M4 4l6 6M20 20l-6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      </button>
    </div>

    <div class="composer-drop-overlay" id={`${id}DropOverlay`}>
      <div class="composer-drop-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V5m0 0-4 4m4-4 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      </div>
      <div class="composer-drop-label">Drop to attach</div>
      <div class="composer-drop-sub">PNG · JPG · WEBP</div>
    </div>
    <div
      class="composer-editable"
      id={`${id}Input`}
      contenteditable="true"
      role="textbox"
      aria-multiline="true"
      data-placeholder={placeholder}
    ></div>
    <div class="composer-toolbar">
      <button class="composer-icon-btn" id={`${id}AttachBtn`} type="button" aria-label="Upload photo">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="3.5" stroke="currentColor" stroke-width="1.6"></rect><path d="M4 16.2l3.9-3.6a2 2 0 0 1 2.7 0l3.2 3M14 14.6l1.6-1.4a2 2 0 0 1 2.6 0l2 1.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path><circle cx="15.3" cy="9.4" r="1.35" fill="currentColor"></circle></svg>
      </button>
      <button class="composer-icon-btn" id={`${id}CameraBtn`} type="button" aria-label="Use camera">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 8.5h2.2l1.4-2h7.8l1.4 2h2.2a1.5 1.5 0 0 1 1.5 1.5v7.5a1.5 1.5 0 0 1-1.5 1.5H4.5A1.5 1.5 0 0 1 3 17.5V10a1.5 1.5 0 0 1 1.5-1.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path><circle cx="12" cy="13.6" r="3.3" stroke="currentColor" stroke-width="1.6"></circle></svg>
      </button>
      <button class="composer-icon-btn" id={`${id}CharacterBtn`} type="button" aria-label="Mention a character">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.4" stroke="currentColor" stroke-width="1.6"></circle><circle cx="12" cy="10.4" r="2.7" stroke="currentColor" stroke-width="1.6"></circle><path d="M6.9 18.3c1.1-2.1 3-3.2 5.1-3.2s4 1.1 5.1 3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
      <button class="composer-icon-btn" id={`${id}SkillBtn`} type="button" aria-label="Use a skill">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3.6 1.85 4.55L18.4 10l-4.55 1.85L12 16.4l-1.85-4.55L5.6 10l4.55-1.85L12 3.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="m18.2 15.4.75 1.85 1.85.75-1.85.75-.75 1.85-.75-1.85-1.85-.75 1.85-.75.75-1.85Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
      </button>
      <input type="file" id={`${id}FileInput`} accept="image/*" hidden />

      <div class="composer-mode-wrap">
        <button type="button" class="composer-auto" id={`${id}ModeBtn`} aria-haspopup="true" aria-expanded="false">
          <span id={`${id}ModeLabel`}>Auto</span>
          <svg class="composer-auto-dot" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div class="composer-mode-menu" id={`${id}ModeMenu`} hidden>
          <button type="button" class="composer-mode-item" data-mode="Auto" data-active="true">
            <span class="composer-mode-item-dot"></span>
            <span class="composer-mode-item-text">
              <span class="composer-mode-item-label">Auto</span>
              <span class="composer-mode-item-sub">Picks a model per prompt</span>
            </span>
            <span class="composer-mode-item-check">✓</span>
          </button>
          <button type="button" class="composer-mode-item" data-mode="Fast">
            <span class="composer-mode-item-dot"></span>
            <span class="composer-mode-item-text">
              <span class="composer-mode-item-label">Fast</span>
              <span class="composer-mode-item-sub">Quick sketch passes</span>
            </span>
            <span class="composer-mode-item-check">✓</span>
          </button>
          <button type="button" class="composer-mode-item" data-mode="Fine">
            <span class="composer-mode-item-dot"></span>
            <span class="composer-mode-item-text">
              <span class="composer-mode-item-label">Fine</span>
              <span class="composer-mode-item-sub">Slower, highest detail</span>
            </span>
            <span class="composer-mode-item-check">✓</span>
          </button>
        </div>
      </div>

      <button class="composer-icon-btn" id={`${id}ExpandBtn`} type="button" aria-label="Expand composer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><path d="m20 4-7 7M4 20l7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      </button>
      <button class="composer-stop" id={`${id}StopBtn`} type="button" aria-label="Stop generation" hidden>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><rect x="6.5" y="6.5" width="11" height="11" rx="2.5" fill="currentColor"/></svg>
      </button>
      <button class="composer-send" id={`${id}Send`} type="button" aria-label="Send">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 19.5V5m0 0-6.2 6.2M12 5l6.2 6.2" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>

    <div class="mention-popover" id={`${id}MentionPopover`} hidden></div>
  </div>

  <div class="composer-hints">
    <span class="composer-hint"><kbd>⏎</kbd>Send</span>
    <span class="composer-hint-sep">·</span>
    <span class="composer-hint"><kbd>⇧⏎</kbd>Newline</span>
    <span class="composer-hint-sep">·</span>
    <span class="composer-hint"><kbd>@</kbd>Character</span>
    <span class="composer-hint-sep">·</span>
    <span class="composer-hint"><kbd>/</kbd>Skill</span>
    <span class="composer-hint-sep">·</span>
    <span class="composer-hint"><kbd>⌘⏎</kbd>Expand</span>
  </div>

  <div class="camera-dialog-backdrop" id={`${id}CameraDialog`} role="dialog" aria-modal="true" aria-labelledby={`${id}CameraTitle`} aria-hidden="true" hidden>
    <div class="camera-dialog-panel">
      <div class="camera-dialog-head">
        <div>
          <h2 id={`${id}CameraTitle`}>Take a photo</h2>
          <p>Allow camera access, frame your subject, and capture.</p>
        </div>
        <button type="button" class="camera-dialog-close" id={`${id}CameraClose`} aria-label="Close camera">×</button>
      </div>
      <div class="camera-stage">
        <video id={`${id}CameraVideo`} autoplay playsinline muted></video>
        <img id={`${id}CameraPreview`} alt="Captured photo preview" hidden />
        <canvas id={`${id}CameraCanvas`} hidden></canvas>
      </div>
      <p class="camera-dialog-status" id={`${id}CameraStatus`} role="status" aria-live="polite"></p>
      <div class="camera-dialog-actions">
        <button type="button" class="camera-dialog-secondary" id={`${id}CameraCancel`}>Cancel</button>
        <button type="button" class="camera-dialog-secondary" id={`${id}CameraRetake`} hidden>Retake</button>
        <button type="button" class="camera-dialog-primary" id={`${id}CameraCapture`} disabled>Take photo</button>
        <button type="button" class="camera-dialog-primary" id={`${id}CameraUse`} hidden>Use photo</button>
      </div>
    </div>
  </div>

  <p class="composer-status" id={`${id}Status`} role="status" aria-live="polite"></p>
</div>

<style is:global>
  /* Shared prompt composer — used on Home (hero) and /c/[id] (compact).
     Global because both pages render this component's markup and each
     page's own controller (home.ts / chat.ts / composer-mentions.ts) only
     needs the ids to match; Astro's scoped-CSS attribute would otherwise
     be duplicated per inclusion for no benefit.

     Visual language ported from the "Prompt Composer v2" design (Claude
     Design project 9960e6c3) — glass icon buttons, gradient send/skill
     accents, resizable-look grabber cue, drag overlay sweep — remapped
     onto this app's existing --accent/--border/--surface tokens so it
     still adapts to the light theme instead of the design's dark-only
     palette. */
  @keyframes composerRise { from { opacity: 0; transform: translateY(6px) scale(.985); } to { opacity: 1; transform: none; } }
  @keyframes composerSweep { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

  .composer-skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 8px 9px 0;
    padding: 6px 10px 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border2);
    background: var(--surface2);
  }
  .composer-skill-chip-icon { color: var(--text-dim); flex: 0 0 auto; }
  .composer-skill-chip span {
    font-size: 12.5px;
    color: var(--text);
  }
  .composer-skill-chip button {
    border: 0;
    background: none;
    color: var(--text-dimmer);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    padding: 2px;
  }
  .composer-skill-chip button:hover { color: var(--text); }
  /* Higher specificity than the bare .composer-skill-chip rule above, so
     the `hidden` attribute (toggled from JS) actually hides it — an
     unconditional `display` on the same selector otherwise always wins
     over the browser's built-in `[hidden] { display: none }` rule,
     regardless of the JS toggle. */
  .composer-skill-chip[hidden] { display: none; }

  .composer-attach-row {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 8px 9px 0;
    padding: 5px 12px 5px 5px;
    border-radius: 999px;
    border: 1px solid var(--border2);
    background: var(--surface2);
  }
  .composer-attach-thumb-wrap {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border2);
  }
  .composer-attach-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    font-size: 0;
    color: transparent;
  }
  .composer-attach-meta { font-size: 12.5px; color: var(--text-dim); }
  .composer-attach-remove { border: 0; background: none; color: var(--text-dimmer); font-size: 14px; line-height: 1; cursor: pointer; padding: 2px; }
  .composer-attach-remove:hover { color: var(--text); }
  .composer-attach-row[hidden] { display: none; }

  .composer-box {
    position: relative;
    border-radius: 22px;
    background: var(--card-hover);
    border: 1px solid var(--border3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 10px 28px rgba(0, 0, 0, 0.22);
    padding: 24px 15px 12px;
    transition: box-shadow .2s ease, border-color .2s ease, background .2s ease, top .2s ease, left .2s ease, transform .2s ease, width .2s ease, max-width .2s ease;
  }
  .composer-box:focus-within {
    border-color: var(--text-dimmer);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 12px 32px rgba(0, 0, 0, 0.26);
  }
  .composer-compact .composer-box { border-radius: 18px; padding: 18px 12px 8px; }

  /* Resize grabber — drag the top strip to grow/shrink the editable area,
     matching the design's ns-resize handle. Wired by the inline script at
     the bottom of this component (per composer instance, via [data-id]). */
  .composer-resize-handle {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: ns-resize;
    touch-action: none;
    z-index: 5;
  }
  .composer-compact .composer-resize-handle { display: none; }
  .composer-grabber {
    width: 44px;
    height: 3.5px;
    border-radius: 4px;
    background: var(--border3);
    transition: background .15s;
  }
  .composer-resize-handle:hover .composer-grabber,
  .composer-resize-handle[data-active="true"] .composer-grabber { background: var(--text-dimmer); }

  /* Focus / expand mode — toggled by the expand button (⌘⏎), lifts the box
     into a centered overlay above a dimmed backdrop. */
  .composer-expand-backdrop {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    animation: composerFade .18s ease;
  }
  .composer-expand-backdrop[hidden] { display: none; }
  @keyframes composerFade { from { opacity: 0; } to { opacity: 1; } }

  .composer-box[data-expanded="true"] {
    position: fixed;
    z-index: 90;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(780px, 92vw);
    max-width: none;
    border-radius: 24px;
    padding: 16px 18px 15px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 24px 60px rgba(0, 0, 0, 0.5);
    animation: composerRise .2s ease;
  }
  .composer-box[data-expanded="true"] .composer-resize-handle { display: none; }
  .composer-box[data-expanded="true"] .composer-editable { min-height: 190px; max-height: 60vh; }

  .composer-focus-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }
  .composer-focus-bar[hidden] { display: none; }
  .composer-focus-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: var(--text-dim);
  }
  .composer-focus-left { display: flex; align-items: center; gap: 9px; }
  .composer-focus-label { font-size: 13px; font-weight: 500; color: var(--text); letter-spacing: -0.005em; }
  .composer-focus-hint { font-size: 11.5px; color: var(--text-dimmer); }
  .composer-focus-collapse { margin-left: auto; }

  /* Drag-and-drop overlay — toggled via [data-drag-over] set by
     initComposerDropZone() (media-picker.ts) on dragenter/dragleave/drop,
     shared by both the Home and Chat composers. */
  .composer-drop-overlay {
    position: absolute;
    inset: 0;
    z-index: 40;
    display: none;
    overflow: hidden;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: inherit;
    border: 1.5px dashed var(--border3);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    pointer-events: none;
  }
  .composer-box[data-drag-over="true"] .composer-drop-overlay { display: flex; }
  .composer-drop-overlay::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.06), transparent);
    animation: composerSweep 1.3s linear infinite;
  }
  .composer-drop-icon {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    border: 1px solid var(--border3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
  }
  .composer-drop-label { position: relative; font-size: 13.5px; font-weight: 600; color: var(--text); }
  .composer-drop-sub { position: relative; font-size: 11px; color: var(--text-dim); }

  .composer-editable {
    width: 100%;
    min-height: 46px;
    max-height: 200px;
    overflow-y: auto;
    outline: none;
    color: var(--text);
    caret-color: var(--accent);
    font-size: 16px;
    line-height: 24px;
    font-family: inherit;
    white-space: pre-wrap;
    word-break: break-word;
    letter-spacing: -0.005em;
  }
  .composer-editable:empty::before {
    content: attr(data-placeholder);
    color: var(--text-dimmer);
    pointer-events: none;
  }
  .composer-compact .composer-editable { font-size: 14.5px; line-height: 21px; min-height: 42px; max-height: 140px; }

  /* iOS Safari zooms the whole page on focus of any input/contenteditable
     under 16px — the compact variant's 14.5px triggers it every time the
     chat composer is tapped on a phone, so this restores 16px there only. */
  @media (max-width: 860px) {
    .composer-compact .composer-editable { font-size: 16px; line-height: 22px; }

    /* The 30px toolbar icon buttons (and send button) sit well under the
       ~44px minimum comfortable touch target (Apple HIG / Material). Bump
       them up on phones — the math still fits a 320px-wide screen: box
       padding (12px × 2) + 4 icon buttons (44px) + send (44px) + 4 gaps
       (10px) = 24 + 220 + 40 = 284px, inside a 320px viewport. */
    .composer-compact .composer-toolbar { gap: 10px; }
    .composer-compact .composer-icon-btn { width: 44px; height: 44px; flex-basis: 44px; border-radius: 12px; }
    .composer-compact .composer-send { width: 44px; height: 44px; flex-basis: 44px; }

    /* Small `×` remove/clear buttons get a larger invisible hit area
       without visually growing the pill they sit in. */
    .composer-skill-chip button,
    .composer-attach-remove { padding: 8px; margin: -6px; }

    /* Camera dialog is a full-screen modal on phones, so its close/cancel/
       capture buttons need comfortable touch targets too. */
    .camera-dialog-close { flex-basis: 44px; width: 44px; height: 44px; }
    .camera-dialog-actions button { min-height: 44px; }

    .composer-hints { display: none; }

    /* The rendering-mode dropdown is the least essential toolbar control —
       drop it (for both variants, not just compact) before it forces the
       toolbar to overflow or squeeze the icon buttons on narrow screens. */
    .composer-mode-wrap { display: none; }
  }

  /* On very narrow phones even attach/camera/character/skill + expand +
     send doesn't fit at comfortable touch-target size — drop the expand
     button first since ⌘⏎ still works from a keyboard, and it's the one
     control every other toolbar item doesn't depend on. */
  @media (max-width: 380px) {
    .composer-icon-btn[id$="ExpandBtn"] { display: none; }
  }

  .composer-toolbar { display: flex; align-items: center; gap: 7px; margin-top: 11px; }
  .composer-compact .composer-toolbar { margin-top: 6px; }

  .composer-icon-btn {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 50%;
    border: 1px solid var(--border2);
    background: var(--bg);
    color: var(--text-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color .15s, border-color .15s, background .15s;
  }
  .composer-compact .composer-icon-btn { width: 30px; height: 30px; flex-basis: 30px; border-radius: 50%; }
  .composer-icon-btn:hover { color: var(--text); border-color: var(--border3); background: color-mix(in srgb, var(--bg) 82%, var(--text) 18%); }

  .composer-mode-wrap { position: relative; margin-left: auto; }
  .composer-compact .composer-mode-wrap { display: none; }
  .composer-auto {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 34px;
    padding: 0 11px;
    border-radius: 999px;
    border: 1px solid var(--border2);
    background: var(--bg);
    color: var(--text-dim);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: border-color .15s, background .15s, color .15s;
  }
  .composer-auto:hover { color: var(--text); border-color: var(--border3); background: color-mix(in srgb, var(--bg) 82%, var(--text) 18%); }
  .composer-auto-dot {
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
    color: var(--text-dimmer);
  }

  .composer-mode-menu {
    position: absolute;
