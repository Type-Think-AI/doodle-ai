---
import ComposerSkillChip from "./composer/ComposerSkillChip.astro";
import ComposerAttachRow from "./composer/ComposerAttachRow.astro";
import ComposerFocusBar from "./composer/ComposerFocusBar.astro";
import ComposerDropOverlay from "./composer/ComposerDropOverlay.astro";
import ComposerToolbar from "./composer/ComposerToolbar.astro";
import ComposerHints from "./composer/ComposerHints.astro";
import ComposerCameraDialog from "./composer/ComposerCameraDialog.astro";
import "../app/composer/composer-styles.css";
import "../app/composer/camera-dialog-styles.css";

interface Props {
  /** Prefix for every element id, matching what home.ts / chat.ts expect. */
  id: string;
  variant?: "hero" | "compact";
  placeholder?: string;
}
const { id, variant = "compact", placeholder = "Describe a doodle, drop a photo, or @mention a character" } = Astro.props;
---

<div class={`composer composer-${variant}`} data-id={id}>
  <div class="composer-expand-backdrop" id={`${id}ExpandBackdrop`} hidden></div>

  <ComposerSkillChip id={id} />
  <ComposerAttachRow id={id} />

  <div class="composer-box" id={`${id}Box`}>
    <div class="composer-resize-handle" id={`${id}ResizeHandle`}>
      <div class="composer-grabber"></div>
    </div>

    <ComposerFocusBar id={id} />
    <ComposerDropOverlay id={id} />

    <div
      class="composer-editable"
      id={`${id}Input`}
      contenteditable="true"
      role="textbox"
      aria-multiline="true"
      data-placeholder={placeholder}
    ></div>

    <ComposerToolbar id={id} />
  </div>

  <ComposerHints />
  <ComposerCameraDialog id={id} />

  <p class="composer-status" id={`${id}Status`} role="status" aria-live="polite"></p>
</div>

<script>
  /* Cosmetic/interaction layer ported from the "Prompt Composer v2" design
     that has no equivalent in home.ts/chat.ts: focus-expand mode, the
     resize grabber, and the rendering-mode dropdown. None of this touches
     send/attach/mention state — it only toggles classes and inline styles
     on elements scoped by [data-id], so it safely runs alongside (and
     independently of) each page's own composer controller.

     Runs once per `.composer` found on the page (Home and Chat each render
     exactly one), guarded by a dataset flag in case Astro's script
     deduplication or a bfcache restore re-executes this block. */
  function initComposerExtras(root: HTMLElement): void {
    if (root.dataset.extrasInit === "true") return;
    root.dataset.extrasInit = "true";
    const prefix = root.dataset.id;
    if (!prefix) return;

    const $ = <T extends HTMLElement = HTMLElement>(suffix: string): T | null =>
      document.getElementById(`${prefix}${suffix}`) as T | null;

    const box = $(`Box`);
    const backdrop = $(`ExpandBackdrop`);
    const focusBar = $(`FocusBar`);
    const expandBtn = $(`ExpandBtn`);
    const collapseBtn = $(`CollapseBtn`);
    const editable = $(`Input`);
    const resizeHandle = $(`ResizeHandle`);
    const modeBtn = $(`ModeBtn`) as HTMLButtonElement | null;
    const modeMenu = $(`ModeMenu`);
    const modeLabel = $(`ModeLabel`);
    if (!box || !editable) return;

    /* ---- Focus / expand ---- */
    let expanded = false;
    function setExpanded(next: boolean): void {
      expanded = next;
      box!.dataset.expanded = String(next);
      if (backdrop) backdrop.hidden = !next;
      if (focusBar) focusBar.hidden = !next;
      expandBtn?.setAttribute("aria-label", next ? "Collapse composer" : "Expand composer");
      if (next) editable!.focus();
    }
    expandBtn?.addEventListener("click", () => setExpanded(!expanded));
    collapseBtn?.addEventListener("click", () => setExpanded(false));
    backdrop?.addEventListener("click", () => setExpanded(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && expanded) setExpanded(false);
    });
    // Capture phase so this runs before chat.ts/home.ts's own Enter handler.
    editable.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          e.stopPropagation();
          setExpanded(!expanded);
        }
      },
      true,
    );

    /* ---- Resize grabber ---- */
    if (resizeHandle) {
      let startY = 0;
      let startH = 0;
      let dragging = false;
      const minH = () => (root.classList.contains("composer-compact") ? 42 : 46);
      const onMove = (e: PointerEvent): void => {
        if (!dragging) return;
        const next = Math.min(300, Math.max(minH(), startH + (startY - e.clientY)));
        editable!.style.minHeight = `${next}px`;
      };
      const onUp = (): void => {
        dragging = false;
        resizeHandle.removeAttribute("data-active");
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("pointerup", onUp);
      };
      resizeHandle.addEventListener("pointerdown", (e) => {
        if (expanded) return;
        e.preventDefault();
        dragging = true;
        resizeHandle.dataset.active = "true";
        startY = e.clientY;
        startH = editable!.getBoundingClientRect().height;
        window.addEventListener("pointermove", onMove);
        window.addEventListener("pointerup", onUp);
      });
      resizeHandle.addEventListener("dblclick", () => {
        editable!.style.minHeight = "";
      });
    }

    /* ---- Mode dropdown (cosmetic — no backend concept of modes yet) ---- */
    if (modeBtn && modeMenu && modeLabel) {
      let open = false;
      const setOpen = (next: boolean): void => {
        open = next;
        modeMenu.hidden = !next;
        modeBtn.setAttribute("aria-expanded", String(next));
      };
      modeBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(!open);
      });
      modeMenu.querySelectorAll<HTMLButtonElement>(".composer-mode-item").forEach((item) => {
        item.addEventListener("click", () => {
          const mode = item.dataset.mode || "Auto";
          modeLabel.textContent = mode;
          modeMenu.querySelectorAll(".composer-mode-item").forEach((i) => delete (i as HTMLElement).dataset.active);
          item.dataset.active = "true";
          setOpen(false);
        });
      });
      document.addEventListener("click", (e) => {
        if (open && !modeMenu.contains(e.target as Node) && e.target !== modeBtn) setOpen(false);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && open) setOpen(false);
      });
    }
  }

  document.querySelectorAll<HTMLElement>(".composer").forEach(initComposerExtras);
</script>
