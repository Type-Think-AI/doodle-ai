{
  "name": "doodleai-agent",
  "description": "Standalone next-version Doodle AI for normal doodles, collages, action modes, and future skills.",
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/react": "6.0.5",
    "@astrojs/rss": "4.0.19",
    "@cloudflare/voice": "^0.4.0",
    "@mastra/core": "1.61.0",
    "@tldraw/sync": "5.3.2",
    "@tldraw/sync-core": "5.3.2",
    "@tldraw/tlschema": "5.3.2",
    "@types/hast": "^3.0.5",
    "agents": "^0.22.0",
    "ai": "^7.0.90",
    "astro": "7.3.1",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "github-slugger": "2.0.0",
    "mixpanel-browser": "2.82.1",
    "picx-ai": "0.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldraw": "5.3.2",
    "typescript": "5.9.3",
    "unist-util-visit": "^5.1.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.11.0",
    "simple-icons": "16.29.0",
    "typescript-eslint": "8.67.0",
    "vite": "6.4.3",
    "wrangler": "4.88.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "astro": "astro",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "blog:thumbs": "node scripts/generate-blog-thumbnails.mjs",
    "build": "astro build",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-validate.mjs",
    "test:webmcp": "node scripts/webmcp-smoke.mjs http://localhost:4321",
    "test:webmcp:prod": "node scripts/webmcp-smoke.mjs https://doodleai.art",
    "test:replay": "node scripts/replay-smoke.mjs http://localhost:4321/",
    "test:replay:prod": "node scripts/replay-smoke.mjs https://doodleai.art/",
    "webmcp:diag": "node scripts/webmcp-diag.mjs",
    "cf-typegen": "wrangler types",
    "check": "eslint . && tsc --noEmit && node scripts/check-file-sizes.mjs && node scripts/check-media-models.mjs && astro build && wrangler deploy --dry-run",
    "check:media-models": "node scripts/check-media-models.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check:sizes:strict": "node scripts/check-file-sizes.mjs --strict",
    "check:sizes:update": "node scripts/check-file-sizes.mjs --update-baseline",
    "db:generate": "drizzle-kit generate",
    "db:migrate:remote": "wrangler d1 migrations apply doodleai --remote",
    "db:migrate:staging": "wrangler d1 migrations apply doodleai-staging --remote --env staging",
    "db:pending": "node scripts/db-pending.mjs production",
    "db:pending:staging": "node scripts/db-pending.mjs staging",
    "db:studio": "drizzle-kit studio",
    "deploy": "node scripts/deploy.mjs production",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:ci": "node scripts/deploy.mjs --skip-build",
    "dev": "node scripts/dev.mjs",
    "dev:local": "wrangler d1 migrations apply doodleai --local --config wrangler.local.json && astro dev",
    "db:migrate:local": "wrangler d1 migrations apply doodleai --local --config wrangler.local.json",
    "secrets:seed-local": "node scripts/seed-local-secrets.mjs",
    "preview": "astro build && wrangler dev",
    "test:webmcp:tools": "node scripts/webmcp-tools-test.mjs http://localhost:4321",
    "test:webmcp:all": "node scripts/webmcp-smoke.mjs http://localhost:4321 && node scripts/webmcp-tools-test.mjs http://localhost:4321"
  },
  "type": "module"
}
